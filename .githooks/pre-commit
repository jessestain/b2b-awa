#!/usr/bin/env bash
# Bloqueia commits que adicionam segredos em texto (tokens, chaves privadas, senhas literais)
# e arquivos vazios soltos na raiz (sobras de comando de shell, como os que ja vazaram senhas
# em nomes de arquivo). Olha so as linhas ADICIONADAS no commit. Nunca imprime o valor achado.
#
# Ativar neste clone:   git config core.hooksPath .githooks
# Ignorar uma vez:      SKIP_SECRET_SCAN=1 git commit ...   (so com justificativa)
set -u

[ "${SKIP_SECRET_SCAN:-0}" = "1" ] && exit 0

falhou=0
aviso() { printf '  [segredo?] %s\n' "$1" >&2; falhou=1; }

# 1) arquivos novos e vazios na raiz do repositorio
while IFS= read -r f; do
    case "$f" in */*) continue ;; esac
    if [ -f "$f" ] && [ ! -s "$f" ]; then
        aviso "arquivo vazio na raiz: '${f:0:3}...' (provavel sobra de comando de shell; o NOME pode conter uma senha)"
    fi
done < <(git diff --cached --name-only --diff-filter=A)

# 2) padroes nas linhas adicionadas
PADROES=(
    'github-token|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}'
    'aws-access-key|AKIA[0-9A-Z]{16}'
    'chave-privada|-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'slack-token|xox[baprs]-[A-Za-z0-9-]{10,}'
    'google-api-key|AIza[0-9A-Za-z_-]{35}'
    'chave-llm|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}'
    'redis-cli com senha literal|redis-cli[^|#]* -a +["'"'"'][^$"'"'"' ]{6,}["'"'"']'
    'mysql com senha literal|mysql[^|#]* -p["'"'"'][^$"'"'"' ]{4,}["'"'"']'
    'atribuicao de segredo|(pass(word)?|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)["'"'"']?[[:space:]]*(=>|=|:)[[:space:]]*["'"'"'][^$"'"'"'[:space:]{<]{12,}["'"'"']'
)
IGNORAR='getenv|env\(|\$_ENV|example|TROQUE|changeme|placeholder|<[^>]+>|\*\*\*'

arquivo=""; linha=0
while IFS= read -r l; do
    case "$l" in
        '+++ b/'*) arquivo="${l#+++ b/}"; continue ;;
        '+++ '*)   continue ;;
        '@@ '*)    linha=$(printf '%s' "$l" | sed -E 's/^@@ -[0-9,]+ \+([0-9]+).*/\1/'); continue ;;
        '+'*)
            conteudo="${l:1}"
            if ! printf '%s' "$conteudo" | grep -qE "$IGNORAR"; then
                for p in "${PADROES[@]}"; do
                    nome="${p%%|*}"; rx="${p#*|}"
                    if printf '%s' "$conteudo" | grep -qiE -- "$rx"; then
                        aviso "$nome em $arquivo:$linha"
                    fi
                done
            fi
            linha=$((linha + 1))
            ;;
    esac
done < <(git diff --cached -U0 --no-color)

if [ "$falhou" -ne 0 ]; then
    cat >&2 <<'MSG'

Commit bloqueado: possivel segredo ou arquivo suspeito acima.
- Leia a credencial de app/etc/env.php ou de uma variavel de ambiente; nunca grave no arquivo.
- Se for falso positivo, ajuste o texto (ex.: use $VARIAVEL) ou rode com SKIP_SECRET_SCAN=1 e justifique no commit.
MSG
    exit 1
fi
exit 0
