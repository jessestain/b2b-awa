        ?>
            <div class="banner_item swiper-slide awa-hero__slide<?= $__isCb300 ? ' awa-hero__slide--cb300' : '' ?>">
                <div class="banner_item_bg">
                    <?php
                    $_rawAlt = $banner->getSlideText() ?: ($banner->getSlideTitle() ?: 'AWA Motos');
                    $slideAlt = trim(preg_replace('/\s+/', ' ', strip_tags(str_replace('<', ' <', (string) $_rawAlt)))) ?: 'AWA Motos';
                    if ($heroResponsive) {
                        $html = $heroResponsive->buildLcpPictureHtml(
                            (string) $banner->getSlideImage(),
