                            false
                        );
                    } else {
                        $html = $block->getImageElement($banner->getSlideImage(), $slideAlt, $__isFirst);
                        if (preg_match('/src="([^"]+)"/', $html, $_wm)) {
                            $_webp = $_wm[1] . '.webp';
                            $html = '<picture>'
                                . '<source type="image/webp" srcset="' . $block->escapeUrl($_webp) . '">'
                                . $html
                                . '</picture>';
                        }
                    }
                    if ($link !== '') {
                        $slideLinkLabel = trim(strip_tags((string) $slideAlt)) ?: (string) __('Destaque AWA Motos');
                        $html = '<a href="' . $block->escapeUrl($link) . '" aria-label="'
                            . $block->escapeHtmlAttr(__('Abrir destaque: %1', $slideLinkLabel))
                            . '">' . $html . '</a>';
                    }
                    echo $html;
                    if (!empty($__isCb300)) {
                        echo '<span class="awa-hero-sliver-mask" aria-hidden="true"></span>';
                    }
                    ?>
                </div>
                <?php if ($text = $banner->getSlideText()): ?>
                <div class="text-banner">
                    <?= $renderSafeSlideText($text) ?>
                    <?= /* @noEscape */ $renderB2bCta($link, $text) ?>
                </div>
                <?php endif; ?>
            </div>
        <?php } ?>
        </div>
        <button class="awa-hero-swiper__nav awa-hero-swiper__nav--prev awa-hero__nav awa-hero__button awa-hero__button--prev swiper-button-prev" type="button" aria-label="<?= $block->escapeHtmlAttr(__('Slide anterior')) ?>">
            <span aria-hidden="true">‹</span>
        </button>
        <button class="awa-hero-swiper__nav awa-hero-swiper__nav--next awa-hero__nav awa-hero__button awa-hero__button--next swiper-button-next" type="button" aria-label="<?= $block->escapeHtmlAttr(__('Próximo slide')) ?>">
            <span aria-hidden="true">›</span>
        </button>
        <?php /* A11Y-001: sem aria-hidden aqui — o Swiper (clickable:true) popula esta div com <button> reais (um por slide, cada um com seu proprio aria-label "Ir para o slide N"); aria-hidden no container escondia esses botoes focaveis do leitor de tela (aria-hidden-focus, axe-core/Lighthouse). */ ?>
        <div class="swiper-pagination awa-hero__pagination"></div>
        <button class="awa-hero-pause-btn awa-hero__pause" type="button"
                aria-label="<?= $block->escapeHtmlAttr(__('Pausar apresentação')) ?>"
