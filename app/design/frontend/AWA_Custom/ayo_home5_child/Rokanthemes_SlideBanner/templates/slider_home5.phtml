<script>
/* A11Y 2026-08-05: sync aria-hidden+inert entre variantes desktop/mobile do hero.
   bootstrap-defer pode não injetar; este inline garante H2 único no a11y tree. */
(function (w, d) {
    'use strict';
    function syncHeroVariantA11y() {
        var mobile = w.innerWidth < 768;
        d.querySelectorAll('[data-awa-hero-variant]').forEach(function (el) {
            var active = el.getAttribute('data-awa-hero-variant') === (mobile ? 'mobile' : 'desktop');
            el.setAttribute('aria-hidden', active ? 'false' : 'true');
            if (active) {
                el.removeAttribute('inert');
                /* PLANO B2B F2.2: trava de apresentação única desde o 1º paint.
                   O CSS que esconde a variante inativa (.hidden-xs/.visible-xs) chega
                   deferido; sem display:none inline, as DUAS variantes do hero pintam
                   juntas e o texto do slide aparece duplicado (FOUC). */
                el.style.removeProperty('display');
            } else {
                el.setAttribute('inert', '');
                el.style.setProperty('display', 'none', 'important');
            }
        });
    }
    syncHeroVariantA11y();
    if (!d.__awaHeroVariantA11yResize) {
        d.__awaHeroVariantA11yResize = true;
        var scheduled = false;
        w.addEventListener('resize', function () {
            if (scheduled) { return; }
            scheduled = true;
            w.setTimeout(function () { scheduled = false; syncHeroVariantA11y(); }, 50);
        }, { passive: true });
    }
}(window, document));
</script>
<script>
(function (w, d) {
    'use strict';

    var configId = 'awa-hero-slider-config-<?= (int) $sliderId ?>';
    var maxAttempts = 120;
    var delayMs = 250;

    function schedule(fn) {
        if ('requestAnimationFrame' in w) {
            w.requestAnimationFrame(fn);
            return;
        }

        w.setTimeout(fn, 0);
    }

    function setSlideFocus(slide, active) {
        slide.querySelectorAll('a[href], button, input, select, textarea, [tabindex]').forEach(function (control) {
            if (active) {
                if (control.hasAttribute('data-awa-hero-original-tabindex')) {
                    var original = control.getAttribute('data-awa-hero-original-tabindex');
                    if (original === '__none__') {
                        control.removeAttribute('tabindex');
                    } else {
                        control.setAttribute('tabindex', original);
                    }
                    control.removeAttribute('data-awa-hero-original-tabindex');
                }
                return;
            }

            if (!control.hasAttribute('data-awa-hero-original-tabindex')) {
                control.setAttribute(
                    'data-awa-hero-original-tabindex',
                    control.hasAttribute('tabindex') ? control.getAttribute('tabindex') : '__none__'
                );
            }
            control.setAttribute('tabindex', '-1');
        });
    }

    function initNativeFallback(node) {
        if (!node || node.getAttribute('data-awa-hero-native-fallback') === '1') {
            return;
        }

        d.querySelectorAll('[data-awa-hero-variant] .awa-hero__viewport').forEach(function (viewport) {
            var slides = Array.prototype.slice.call(viewport.querySelectorAll('.awa-hero__slide'));
            var pagination = viewport.querySelector('.awa-hero__pagination');
            var prev = viewport.querySelector('.awa-hero__button--prev');
            var next = viewport.querySelector('.awa-hero__button--next');
            var pause = viewport.querySelector('.awa-hero__pause');
            var activeDisplay;
            var index = 0;

            if (!slides.length) {
                return;
            }

            activeDisplay = w.getComputedStyle(slides[0]).display;
            if (!activeDisplay || activeDisplay === 'none') {
                activeDisplay = viewport.closest('[data-awa-hero-variant="mobile"]') ? 'flex' : 'block';
            }

            function show(nextIndex) {
                index = (nextIndex + slides.length) % slides.length;
                slides.forEach(function (slide, slideIndex) {
                    var active = slideIndex === index;
                    slide.style.setProperty('display', active ? activeDisplay : 'none', 'important');
                    slide.classList.toggle('swiper-slide-active', active);
                    slide.setAttribute('aria-hidden', active ? 'false' : 'true');
                    setSlideFocus(slide, active);
                });
                if (pagination) {
                    pagination.querySelectorAll('.swiper-pagination-bullet').forEach(function (button, buttonIndex) {
                        var active = buttonIndex === index;
                        button.classList.toggle('swiper-pagination-bullet-active', active);
                        if (active) {
                            button.setAttribute('aria-current', 'true');
                        } else {
                            button.removeAttribute('aria-current');
                        }
                    });
                }
            }

            if (pagination) {
                pagination.innerHTML = '';
                pagination.setAttribute('role', 'group');
                pagination.setAttribute(
                    'aria-label',
                    <?= /* @noEscape */ json_encode((string) __('Selecionar destaque'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>
                );
                slides.forEach(function (slide, slideIndex) {
                    var button = d.createElement('button');
                    button.type = 'button';
                    button.className = 'swiper-pagination-bullet';
                    button.setAttribute(
                        'aria-label',
                        <?= /* @noEscape */ json_encode((string) __('Ir para o slide'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?> +
                        ' ' + (slideIndex + 1) + ' ' +
                        <?= /* @noEscape */ json_encode((string) __('de'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?> +
                        ' ' + slides.length
                    );
                    button.addEventListener('click', function () {
                        show(slideIndex);
                    });
                    pagination.appendChild(button);
                });
                pagination.hidden = slides.length < 2;
            }

            if (prev) {
                prev.hidden = slides.length < 2;
                prev.addEventListener('click', function () { show(index - 1); });
            }
            if (next) {
                next.hidden = slides.length < 2;
                next.addEventListener('click', function () { show(index + 1); });
            }
            if (pause) {
                pause.hidden = true;
                pause.setAttribute('aria-hidden', 'true');
            }

            viewport.setAttribute('data-awa-hero-engine', 'native');
            show(0);
        });

        node.setAttribute('data-awa-hero-native-fallback', '1');
        node.setAttribute('data-awa-hero-inline-bootstrap', '1');
    }

    function tryInit(attempt) {
        var node = d.getElementById(configId);
        var payload;

        if (!node || node.getAttribute('data-awa-hero-inline-bootstrap') === '1') {
            return;
        }

        function hasMagentoHeroMap() {
            try {
                var map = w.require.s.contexts._.config.map['*'];
                return !!(map && map.awaHeroSlider);
            } catch (e) {
                return false;
            }
        }

        if (typeof w.require !== 'function' || (w.require && w.require._awaStub) || !hasMagentoHeroMap()) {
            if (attempt >= 12) {
                initNativeFallback(node);
                return;
            }
            if (attempt < maxAttempts) {
                w.setTimeout(function () {
                    tryInit(attempt + 1);
                }, delayMs);
            }
            return;
        }

        try {
            payload = JSON.parse(node.textContent || '{}');
        } catch (e) {
            return;
        }

        if (!payload || payload.sliderId === undefined || payload.sliderId === null) {
            return;
        }

        node.setAttribute('data-awa-hero-inline-bootstrap', '1');
        w.require(['awaHeroSlider'], function (initHero) {
            try {
                initHero(payload);
            } catch (e) {
                node.removeAttribute('data-awa-hero-inline-bootstrap');
            }
        }, function () {
            node.removeAttribute('data-awa-hero-inline-bootstrap');
            if (attempt < maxAttempts) {
                w.setTimeout(function () {
                    tryInit(attempt + 1);
                }, delayMs);
            }
        });
    }

    function boot() {
        schedule(function () {
            tryInit(0);
        });
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', boot, { once: true });
        return;
    }

    boot();
})(window, document);
</script>
<?php endif; ?>
