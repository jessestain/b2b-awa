<?php
/**
 * AWA Motos — Newproduct widget override
 * Matches ProductTab card structure for visual consistency.
 */
use Magento\Framework\App\Action\Action;

if (!$this->getConfig('enabled')) {
    return;
}

$_productCollection = $this->getProducts();

if ($block->getMode() === 'grid') {
    $viewMode = 'grid';
    $image = 'category_page_grid';
    $showDescription = false;
    $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
} else {
    $viewMode = 'list';
    $image = 'category_page_list';
    $showDescription = true;
    $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::FULL_VIEW;
}

$pos = $block->getPositioned();
$rows = (int) $this->getConfig('items_show') ?: 1;
$showCart = (bool) $this->getConfig('addtocart');
$showReview = (bool) $this->getConfig('review');
$isHomePage = $block->getRequest()->getFullActionName() === 'cms_index_index';
$sectionTitle = trim((string) $this->getConfig('title'));
$carouselLabel = $sectionTitle !== '' ? $sectionTitle : (string) __('Lançamentos');
/** @var \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel|null $cardVm */
$cardVm = $block->getData('bestseller_card_view_model');
$hasCardVm = $cardVm instanceof \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel;
$b2bPriceGate = $hasCardVm ? $cardVm : $this->helper(\GrupoAwamotos\B2B\Helper\Data::class);
$canViewPrices = $b2bPriceGate->canViewPrices();
$priceGateHeadline = $b2bPriceGate->getPriceGateHeadline();
$priceGateCardMessage = $b2bPriceGate->getPriceGateCardMessage();
$priceGatePrimaryUrl = $b2bPriceGate->getPriceGatePrimaryUrl();
$wishlistAllowed = $hasCardVm
    ? $cardVm->isWishlistAllowed()
    : (bool) $this->helper(\Magento\Wishlist\Helper\Data::class)->isAllow();

/** @var \GrupoAwamotos\Theme\ViewModel\HomeShelfDisplay|null $homeShelfDisplay */
$homeShelfDisplay = $block->getData('home_shelf_display_view_model');
$renderAddToCart = $homeShelfDisplay instanceof \GrupoAwamotos\Theme\ViewModel\HomeShelfDisplay
    ? $homeShelfDisplay->shouldRenderAddToCart($showCart, $isHomePage)
    : $showCart;

$shelfViewportKey = (string) ($block->getData('awa_shelf_viewport_key') ?: '');
if ($shelfViewportKey === '') {
    $shelfViewportKey = $isHomePage ? 'home-new' : 'newproduct';
}
$viewportId = $homeShelfDisplay instanceof \GrupoAwamotos\Theme\ViewModel\HomeShelfDisplay
    ? $homeShelfDisplay->resolveViewportId($shelfViewportKey)
    : 'awa-vp-' . preg_replace('/[^a-z0-9-]/', '-', strtolower($shelfViewportKey));
?>
<div class="rokan-newproduct awa-shelf awa-shelf--carousel" data-awa-shelf="newproduct">
    <?php if ($this->getConfig('title') && !$isHomePage): ?>
    <div class="rokan-product-heading rokan-onsale-heading">
        <h2><?= $block->escapeHtml($this->getConfig('title')) ?></h2>
        <div class="des-title"><?= $block->escapeHtml($this->getConfig('shortdec')) ?></div>
    </div>
    <?php endif; ?>

    <?php if (!$_productCollection->getSize()): ?>
        <div class="rokan-newproduct-slider awa-shelf-empty" role="status">
            <p class="awa-shelf-empty__message note-msg"><?= $block->escapeHtml(
                $isHomePage
                    ? __('Nenhum produto disponível nesta seleção no momento.')
                    : __('There are no products matching the selection.')
            ) ?></p>
        </div>
    <?php else: ?>
        <div class="awa-carousel awa-carousel--common awa-carousel--product awa-carousel--contained">
            <div class="awa-carousel__viewport awa-cq-card-wrapper"
                 id="<?= $block->escapeHtmlAttr($viewportId) ?>"
                 tabindex="0"
                 role="region"
                 aria-roledescription="<?= $block->escapeHtmlAttr(__('carrossel')) ?>"
                 aria-label="<?= $block->escapeHtmlAttr($carouselLabel) ?>">
            <ul class="owl awa-carousel__track">
                <?php
                $i = 0;
                foreach ($_productCollection as $_product):
                    if ($i % $rows === 0) {
                        echo '<li class="item newproductslider-item awa-carousel__slide">';
                    }

                    $productImage = $block->getImage($_product, $image);
                    $productImageThumb = $block->getImage($_product, 'category_page_grid-1');
                    $productImageHtml = (string) $productImage->toHtml();
                    $productImageThumbHtml = (string) $productImageThumb->toHtml();
                    $productImageThumbUrl = (string) $productImageThumb->getImageUrl();

                    /* VS4j: srcset responsivo nas prateleiras da HOME (abaixo do fold).
                       Mobile usa 320px (awa_home_shelf_sm); tablets/desktop mantêm 400px. */
                    if ($isHomePage) {
                        $productImageSm = $block->getImage($_product, 'awa_home_shelf_sm');
                        $smUrl = (string) $productImageSm->getImageUrl();
                        $lgUrl = (string) $productImage->getImageUrl();
                        if ($smUrl !== '' && $smUrl !== $lgUrl) {
                            $srcset = $smUrl . ' 320w, ' . $lgUrl . ' 400w';
                            $sizes = '(max-width: 767px) 170px, 280px';
                            $productImage = $block->getImage($_product, $image, ['srcset' => $srcset, 'sizes' => $sizes]);
                            $productImageHtml = (string) $productImage->toHtml();
                        }
                    }

                    if (!$isHomePage && $i < 2) {
                        // Fora da home: primeiras 2 imagens acima do fold
                        $productImageHtml = str_replace(' loading="lazy"', ' loading="eager" fetchpriority="high"', $productImageHtml);
                    } else {
                        // Home: LCP é o hero — prateleiras sempre lazy, sem fetchpriority
                        $productImageHtml = str_replace([' loading="eager"', ' fetchpriority="high"'], [' loading="lazy"', ''], $productImageHtml);
                    }
                    /* Core Web Vitals: offload decode da thread principal (ui-ux-pro-max perf) */
                    if (strpos($productImageHtml, 'decoding=') === false) {
                        $productImageHtml = str_replace('<img ', '<img decoding="async" ', $productImageHtml);
                    }
                    if (strpos((string)$productImageThumbHtml, 'decoding=') === false) {
                        $productImageThumbHtml = str_replace('<img ', '<img decoding="async" ', $productImageThumbHtml);
                    }

                    if ($productImageThumbUrl === '' || strpos($productImageThumbUrl, '/placeholder/') !== false) {
                        $productImageThumbHtml = $productImageHtml;
                    }

                    $now = date('Y-m-d H:i:s');
                    $specialprice = $_product->getSpecialPrice();
                    $specialPriceFromDate = $_product->getSpecialFromDate();
                    $specialPriceToDate = $_product->getSpecialToDate();
                    $newFromDate = $_product->getNewsFromDate();
                    $newToDate = $_product->getNewsToDate();
                    $isSale = $specialprice && ($specialPriceFromDate <= $now && $specialPriceToDate >= $now);
                    $isNew = !$isSale && ($newFromDate <= $now && $newToDate >= $now);

                    if ($pos !== null) {
                        $position = ' style="left:' . $productImage->getWidth() . 'px;'
                            . 'top:' . $productImage->getHeight() . 'px;"';
                    }

                    $productDisplayName = \GrupoAwamotos\Theme\Helper\ProductDisplayName::normalize((string) $_product->getName());
                ?>
                    <div class="item-product awa-carousel-card-slot" data-product-id="<?= (int) $_product->getId() ?>">
                        <div class="content-item-product awa-product-card">
                            <div class="product-thumb">
                                <a href="<?= $block->escapeUrl($_product->getProductUrl()) ?>"
                                   class="product-thumb-link"
                                   <?= $isHomePage ? 'tabindex="-1"' : '' ?>
                                   aria-label="<?= $block->escapeHtmlAttr($productDisplayName) ?>">
                                    <span class="first-thumb">
                                        <?= /* @noEscape */ $productImageHtml ?>
                                    </span>
                                    <?php if (!$isHomePage): ?>
                                    <span class="second-thumb">
                                        <?= /* @noEscape */ $productImageThumbHtml ?>
                                    </span>
                                    <?php endif; ?>
                                </a>
                                <div class="hot-onsale">
                                    <?php if ($isSale): ?>
                                        <div class="onsale"><span class="sale-bg"></span><span class="sale-text"><label><?= $block->escapeHtml(__('Promoção')) ?></label></span></div>
                                    <?php elseif ($isNew): ?>
                                        <div class="onsale new-lable"><span class="sale-bg"></span><span class="sale-text"><label><?= $block->escapeHtml(__('Novo')) ?></label></span></div>
                                    <?php endif; ?>
                                </div>
                                <?php if (!$isHomePage): ?>
                                <div class="actions-secondary">
                                    <ul class="product-extra-link add-to-links">
                                        <li class="wishlist-product">
                                            <?php if ($wishlistAllowed): ?>
                                            <a href="#"
                                               class="wishlist-link action towishlist"
                                               data-post='<?= /* @noEscape */ $block->getAddToWishlistParams($_product) ?>'
                                               data-action="add-to-wishlist"
                                               title="<?= $block->escapeHtmlAttr(__('Adicionar à Lista de Desejos')) ?>"
                                               aria-label="<?= $block->escapeHtmlAttr(__('Adicionar à Lista de Desejos')) ?>">
                                                <i class="fa fa-heart" aria-hidden="true"></i>
                                            </a>
                                            <?php endif; ?>
                                        </li>
                                        <li class="quickview-product">
                                            <a data-role="quickview-button"
                                               data-id="<?= (int) $_product->getId() ?>"
                                               href="<?= $block->escapeUrl($block->getUrl('quickview/product/quickview/id/' . $_product->getId())) ?>"
                                               data-href="<?= $block->escapeUrl($block->getUrl('quickview/product/quickview/id/' . $_product->getId())) ?>"
                                               class="quickview-link"
                                               title="<?= $block->escapeHtmlAttr(__('Visualização Rápida')) ?>"
                                               aria-label="<?= $block->escapeHtmlAttr(__('Visualização Rápida') . ': ' . $_product->getName()) ?>">
                                                <i class="fa fa-eye" aria-hidden="true"></i>
                                            </a>
                                        </li>
                                        <li class="compare-product">
                                            <a href="#"
                                               class="compare-link action tocompare"
                                               data-post='<?= /* @noEscape */ ($hasCardVm ? $cardVm->comparePostData($_product) : $this->helper(\Magento\Catalog\Helper\Product\Compare::class)->getPostDataParams($_product)) ?>'
                                               title="<?= $block->escapeHtmlAttr(__('Adicionar ao Comparador')) ?>"
                                               aria-label="<?= $block->escapeHtmlAttr(__('Adicionar ao Comparador')) ?>">
                                                <i class="fa fa-retweet" aria-hidden="true"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <?php endif; ?>
                            </div>

                            <?php if ($renderAddToCart): ?>
                            <div class="product-info-cart">
                                <?php if ($showCart): ?>
                                <div class="actions-primary addcart-link">
                                    <?php if ($_product->isSaleable()): ?>
                                        <?php $postParams = $block->getAddToCartPostParams($_product); ?>
                                        <form data-role="tocart-form"
                                              action="<?= /* @noEscape */ $postParams['action'] ?>"
                                              method="post">
                                            <input type="hidden" name="product" value="<?= (int) $postParams['data']['product'] ?>">
                                            <input type="hidden"
                                                   name="<?= /* @noEscape */ Action::PARAM_NAME_URL_ENCODED ?>"
                                                   value="<?= /* @noEscape */ $postParams['data'][Action::PARAM_NAME_URL_ENCODED] ?>">
                                            <?= $block->getBlockHtml('formkey') ?>
                                            <button type="submit"
                                                    title="<?= $block->escapeHtmlAttr(__('Adicionar ao Carrinho')) ?>"
                                                    aria-label="<?= $block->escapeHtmlAttr(__('Adicionar ao Carrinho') . ': ' . $_product->getName()) ?>"
                                                    class="btn-add-to-cart action tocart">
                                                <span><?= $block->escapeHtml(__('Adicionar ao Carrinho')) ?></span>
                                            </button>
                                        </form>
                                    <?php else: ?>
                                        <?php if ($_product->getIsSalable()): ?>
                                            <div class="stock available"><span><?= $block->escapeHtml(__('Em estoque')) ?></span></div>
                                        <?php else: ?>
                                            <div class="stock unavailable"><span><?= $block->escapeHtml(__('Esgotado')) ?></span></div>
                                        <?php endif; ?>
                                    <?php endif; ?>
                                </div>
                                <?php endif; ?>
                            </div>
                            <?php endif; ?>

                            <div class="product-info">
                                <h3 class="product-name">
                                    <a class="product-item-link"
                                       title="<?= $block->escapeHtmlAttr($productDisplayName) ?>"
                                       <?= $isHomePage ? 'tabindex="-1"' : '' ?>
                                       href="<?= $block->escapeUrl($_product->getProductUrl()) ?>">
                                        <?= $block->escapeHtml($productDisplayName) ?>
                                    </a>
                                </h3>

                                <?php if ($_product->getSku()): ?>
                                    <span class="awa-b2b-sku"><span class="awa-b2b-sku__label">REF: </span><span class="awa-b2b-sku__value"><?= $block->escapeHtml($_product->getSku()) ?></span></span>
                                <?php endif; ?>

                                <?php if (!$isHomePage): ?>
                                <?php
                                // Reviews fora da home. Home: densidade — nome/SKU/CTA.
                                $_ratingHtml = '';
                                try {
                                    $_ratingHtml = $block->getReviewsSummaryHtml($_product, $templateType);
                                } catch (\Throwable $e) {
                                    $_ratingHtml = '';
                                }
                                ?>
                                <?php if (trim($_ratingHtml) !== ''): ?>
                                <div class="product-rating" data-awa-rating>
                                    <?= /* @noEscape */ $_ratingHtml ?>
                                </div>
                                <?php endif; ?>
                                <?php endif; ?>

                                <?php
                                // show_price=1 renderiza preço OU gate B2B fora da home.
                                // Na home, guest sem acesso a preço NÃO recebe o gate B2B
                                // (decisão 2026-08-09, mesmo contrato do bestseller.phtml):
                                // .info-price fica vazio e é colapsado por CSS
                                // (.content-top-home .awa-product-card .info-price:not(:has(*))).
                                $showPriceBlock = (bool) $this->getConfig('show_price');
                                ?>
                                <?php if ($showPriceBlock): ?>
                                    <div class="info-price">
                                    <?php if ($canViewPrices): ?>
                                        <?= /* @noEscape */ ($hasCardVm
                                            ? $cardVm->priceDisplayHtml((string) $block->getProductPrice($_product))
                                            : $this->helper(\Rokanthemes\Themeoption\Helper\Data::class)->getPriceDisplayCustom($block->getProductPrice($_product))) ?>
                                    <?php elseif (!$isHomePage): ?>
                                        <div class="b2b-login-to-see-price">
                                            <span class="b2b-login-to-see-price__title"><?= $block->escapeHtml($b2bPriceGate->getPriceGateHeadline()) ?></span>
                                            <span class="b2b-login-to-see-price__message"><?= $block->escapeHtml($b2bPriceGate->getPriceGateDescription()) ?></span>
                                        </div>
                                    <?php endif; ?>
                                    </div>
                                <?php endif; ?>

                                <?php if ($isHomePage && !$canViewPrices): ?>
                                    <?php /* PLANO B2B F3.3: CTA único e limpo no lugar do texto longo repetido
                                       ("Preços exclusivos para revendedores / Cadastre-se para ver preços").
                                       URL preservada do ViewModel ($priceGatePrimaryUrl) — nenhuma regra
                                       de negócio alterada; o gate continua bloqueando o preço. */ ?>
                                    <div class="awa-home-price-gate">
                                        <?php /* F3.3: classe própria (awa-price-gate-cta), SEM awa-card-view-product —
                                           o JS inline da home (awa-head-preload fixCardCta) reescreve o texto
                                           de qualquer a.awa-card-view-product para "Cadastre-se para ver preços".
                                           Estilo 100% autocontido no awa-b2b-premium-cards-20261026.css. */ ?>
                                        <a class="awa-price-gate-cta"
                                           href="<?= $block->escapeUrl($priceGatePrimaryUrl) ?>"
                                           aria-label="<?= $block->escapeHtmlAttr(__('Ver preço CNPJ de %1 — acesso B2B', $productDisplayName)) ?>">
                                            <span class="awa-price-gate-cta__icon" aria-hidden="true">&#128274;</span>
                                            <span><?= $block->escapeHtml(__('Ver Preço CNPJ')) ?></span>
                                        </a>
                                    </div>
                                <?php elseif ($isHomePage): ?>
                                    <a class="awa-card-view-product action secondary"
                                       href="<?= $block->escapeUrl($_product->getProductUrl()) ?>"
                                       aria-label="<?= $block->escapeHtmlAttr(__('Ver produto: %1', $productDisplayName)) ?>">
                                        <?= $block->escapeHtml(__('Ver produto')) ?>
                                    </a>
                                <?php endif; ?>
                            </div>
                        </div>
                    </div>
                <?php
                    $i++;
                    if ($i % $rows === 0) {
                        echo '</li>';
                    }
                endforeach;
                if ($i % $rows !== 0) {
                    echo '</li>';
                }
                ?>
            </ul>
            </div>
        </div>

        <?= /* @noEscape */ $block->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class)
            ->setTemplate('Magento_Theme::html/awa-shelf-carousel-chrome.phtml')
            ->setData('viewport_id', $viewportId)
            ->setData('progress_label', (string) __('Progresso do carrossel %1', $carouselLabel))
            ->toHtml() ?>

    <?php endif; ?>
</div>
