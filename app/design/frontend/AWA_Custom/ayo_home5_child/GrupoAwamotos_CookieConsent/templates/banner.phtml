<button type="button"
        id="awa-cookie-reopen"
        class="awa-cookie-reopen"
        hidden
        aria-hidden="true"
        aria-haspopup="dialog"
        aria-controls="awa-cookie-banner"
        title="<?= $block->escapeHtmlAttr(__('Preferências de cookies')) ?>"
        aria-label="<?= $block->escapeHtmlAttr(__('Abrir preferências de cookies')) ?>">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5zm0 2a3 3 0 0 1 3 3v3H9V6a3 3 0 0 1 3-3zm0 10a2 2 0 0 1 1 3.73V19a1 1 0 0 1-2 0v-2.27A2 2 0 0 1 12 13z"
              fill="currentColor"/>
    </svg>
</button>
<script>
(function (w, d) {
    var isHome = d.body && d.body.classList.contains('cms-index-index');

    function runWhenRequire(callback) {
        if (typeof w.awaRunWhenRequire === 'function') {
            w.awaRunWhenRequire(callback, { key: 'awa-cookie-consent' });
            return;
        }

        if (typeof w.require === 'function' && !w.require._awaStub) {
            callback();
            return;
        }

        w.setTimeout(function () {
            runWhenRequire(callback);
        }, 120);
    }

    function loadCookieConsent() {
        runWhenRequire(function () {
            w.require(['GrupoAwamotos_CookieConsent/js/cookie-consent'], function (cookieConsent) {
                cookieConsent.init();
            });
        });
    }

    var loaded = false;

    function loadOnce() {
        if (loaded) {
            return;
        }
        loaded = true;
        loadCookieConsent();
    }

    function fallbackDelay() {
        return w.matchMedia && w.matchMedia('(max-width: 767px)').matches ? 6500 : 2500;
    }

    document.addEventListener('pointerdown', loadOnce, { once: true, passive: true });
    document.addEventListener('keydown', loadOnce, { once: true });
    document.addEventListener('touchstart', loadOnce, { once: true, passive: true });

    if (!isHome) {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                w.setTimeout(loadOnce, fallbackDelay());
            }, { once: true });
        } else {
            w.setTimeout(loadOnce, fallbackDelay());
        }
    }
}(window, document));
</script>
