<?php
/**
 * Banner de consentimento de cookies (LGPD) — override tema AWA
 *
 * @var \GrupoAwamotos\CookieConsent\Block\CookieConsent $block
 */
?>
<?php if ($block->isEnabled()): ?>
<div id="awa-cookie-banner"
     role="alertdialog"
     aria-live="polite"
     aria-modal="false"
     aria-hidden="true"
     aria-label="<?= $block->escapeHtmlAttr(__('Aviso de uso de cookies')) ?>"
     aria-describedby="awa-cookie-desc"
     hidden
     style="display:none">
    <div class="awa-cookie-banner__inner">
        <p class="awa-cookie-banner__text" id="awa-cookie-desc">
            <?= $block->escapeHtml(__('Usamos cookies para personalizar conteúdo e melhorar sua experiência. Ao continuar, você concorda com nossa')) ?>
            <span class="awa-cookie-banner__policy"><a class="awa-cookie-banner__link"
               href="<?= $block->escapeUrl($block->getPolicyUrl()) ?>"
               target="_blank" rel="noopener">
                <?= $block->escapeHtml(__('Política de Privacidade')) ?>.</a></span>
        </p>
        <div class="awa-cookie-banner__actions"
             role="group"
             aria-label="<?= $block->escapeHtmlAttr(__('Escolha de cookies')) ?>">
            <button type="button"
                    id="awa-cookie-accept"
                    class="awa-cookie-banner__btn awa-cookie-banner__btn--accept"
                    title="<?= $block->escapeHtmlAttr(__('Permitir cookies')) ?>">
                <span><?= $block->escapeHtml(__('Permitir cookies')) ?></span>
            </button>
            <button type="button"
                    id="awa-cookie-decline"
                    class="awa-cookie-banner__btn awa-cookie-banner__btn--decline"
                    title="<?= $block->escapeHtmlAttr(__('Apenas essenciais')) ?>">
                <span><?= $block->escapeHtml(__('Apenas essenciais')) ?></span>
            </button>
        </div>
    </div>
</div>
<script>
(function (w, d) {
    var isHome = d.body && d.body.classList.contains('cms-index-index');

    function runWhenRequire(callback) {
        if (typeof w.awaRunWhenRequire === 'function') {
            w.awaRunWhenRequire(callback, { key: 'awa-cookie-consent' });
            return;
        }

        if (typeof w.require === 'function' && !w.require._awaStub) {
            callback();
            return;
        }

        w.setTimeout(function () {
            runWhenRequire(callback);
        }, 120);
    }

    function loadCookieConsent() {
        runWhenRequire(function () {
            w.require(['GrupoAwamotos_CookieConsent/js/cookie-consent'], function (cookieConsent) {
                cookieConsent.init();
            });
        });
    }

    var loaded = false;

    function loadOnce() {
        if (loaded) {
            return;
        }
        loaded = true;
        loadCookieConsent();
    }

    function fallbackDelay() {
        return w.matchMedia && w.matchMedia('(max-width: 767px)').matches ? 6500 : 2500;
    }

    document.addEventListener('pointerdown', loadOnce, { once: true, passive: true });
    document.addEventListener('keydown', loadOnce, { once: true });
    document.addEventListener('touchstart', loadOnce, { once: true, passive: true });

    if (!isHome) {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                w.setTimeout(loadOnce, fallbackDelay());
            }, { once: true });
        } else {
            w.setTimeout(loadOnce, fallbackDelay());
        }
    }
}(window, document));
</script>
<?php endif; ?>
