<?php
declare(strict_types=1);

/**
 * Header search form override (Magento_Search) - AWA Home5 child
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

// @codingStandardsIgnoreFile
/** @var \Magento\Search\ViewModel\ConfigProvider|null $configProvider */
$configProvider = $block->getData('configProvider');
/** @var \Magento\Search\Helper\Data $searchHelper */
$searchHelper = $configProvider instanceof \Magento\Search\ViewModel\ConfigProvider
    ? $configProvider->getSearchHelperData()
    : $this->helper(\Magento\Search\Helper\Data::class);
$fallbackSuggestUrl = $block->getUrl('search/ajax/suggest');
$searchQueryText = (string) $searchHelper->getEscapedQueryText();
$searchFormClass = 'form minisearch search-content is-ready';
$isHomePage = $block->getRequest()->getFullActionName() === 'cms_index_index';

if ($searchQueryText === '') {
    $searchFormClass .= ' is-empty';
}
?>
<div class="block block-search awa-professional-search"
     role="search"
     aria-label="<?php echo $block->escapeHtmlAttr(__('Busca de produtos')) ?>"
     data-awa-search-root="true"
     data-awa-component="search-autocomplete"
     data-awa-variant="magento-search">
    <div class="block-content">
        <form class="<?php echo $block->escapeHtmlAttr($searchFormClass) ?>"
              id="search_mini_form"
              data-awa-search-form="true"
              action="<?php echo $block->escapeUrl($searchHelper->getResultUrl()) ?>"
              method="get">
            <div class="field search">
                <label class="label" for="search" id="awa-search-label" data-role="minisearch-label">
                    <span><?php echo $block->escapeHtml(__('Buscar')); ?></span>
                </label>
                <?php
                /**
                 * Do not put search-help copy under header_main (text OR attributes OR inline JS).
                 * Cursor DOM picker aggregates header_main outerHTML and was showing
                 * "Digite ao menos 2 caracteres…". Portal is created by theme JS on body.
                 */
                ?>
                <span id="awa-search-status"
                      class="awa-sr-only"
                      data-awa-search-status="true"
                      aria-live="polite"
                      aria-atomic="true"></span>
                <div class="control" data-awa-search-control="true">
                    <input id="search"
                           aria-label="<?php echo $block->escapeHtmlAttr(__('Buscar produtos')) ?>"
                           data-awa-search-input="true"
                           type="search"
                           name="<?php echo $block->escapeHtmlAttr($searchHelper->getQueryParamName()) ?>"
                           value="<?php echo $block->escapeHtmlAttr($searchQueryText) ?>"
                           placeholder="<?php echo $block->escapeHtmlAttr(__('Buscar peça, marca ou moto')); ?>"
                           class="input-text"
                           minlength="2"
                           maxlength="<?php echo (int) $searchHelper->getMaxQueryLength(); ?>"
                           role="combobox"
                           aria-labelledby="awa-search-label"
                           aria-describedby="awa-search-status"
                           aria-autocomplete="both"
                           aria-expanded="false"
                           aria-haspopup="listbox"
                           aria-controls="search_autocomplete"
                           autocomplete="search"
                           autocapitalize="off"
                           autocorrect="off"
                           spellcheck="false"
                           inputmode="search"
                           enterkeyhint="search" />
                    <div id="search_autocomplete"
                         class="search-autocomplete searchsuite-autocomplete"
                         data-role="search-autocomplete"
                         data-awa-search-panel="true"
                         role="listbox"
                         aria-hidden="true"
                         aria-label="<?php echo $block->escapeHtmlAttr(__('Sugestões de busca')) ?>"></div>
                    <?php echo $block->getChildHtml() ?>
                </div>
            </div>
            <div class="actions" data-awa-search-actions="true">
                <button type="submit"
                        title="<?php echo $block->escapeHtmlAttr(__('Buscar')) ?>"
                        aria-label="<?php echo $block->escapeHtmlAttr(__('Buscar produtos')) ?>"
                        class="action search"
                        data-awa-search-submit="true"
                        data-awa-search-icon="single-lupa">
                    <?php /* Accessible name comes from aria-label; avoid extra text nodes under header_main. */ ?>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true" focusable="false"
                         data-awa-search-svg-icon="lupa">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                </button>
            </div>
        </form>
        <?php /* Kept for CSS hooks; no copy — was display:none but still polluted header_main textContent. */ ?>
        <p class="awa-search-helper-copy" data-awa-search-helper-copy="true" aria-hidden="true"></p>
    </div>
</div>
<?php if ($isHomePage): ?>
<script type="text/x-magento-init">
{
    "#search_mini_form": {
        "js/awa-search-autocomplete-compat": {
            "inputSelector": "#search",
            "panelSelector": "#search_autocomplete",
            "resultsRootSelector": ".searchsuite-autocomplete",
            "fallbackEndpoint": "<?php echo $block->escapeUrl($fallbackSuggestUrl) ?>",
            "searchResultUrl": "<?php echo $block->escapeUrl($searchHelper->getResultUrl()) ?>",
            "minQueryLength": 2
        }
    }
}
</script>
<?php endif; ?>
