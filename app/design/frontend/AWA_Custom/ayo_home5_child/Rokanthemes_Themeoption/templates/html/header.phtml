		<script>
			/* Fechamento síncrono: o primeiro clique não pode depender do runtime deferido. */
			(function () {
				var bar = document.getElementById('awa-b2b-promo-bar');
				var closeButton = document.getElementById('awa-b2b-promo-close');

				function setHiddenInert(el, hidden) {
					if (!el) {
						return;
					}
					if (hidden) {
						el.setAttribute('aria-hidden', 'true');
						el.setAttribute('inert', '');
					} else {
						el.removeAttribute('aria-hidden');
						el.removeAttribute('inert');
					}
				}

				function collapsePromo(persist) {
					if (!bar) {
						return;
					}
					bar.style.setProperty('display', 'none', 'important');
					setHiddenInert(bar, true);
					/* A11Y/BUG 2026-08-05: NÃO esconder #header.header-container —
					   collapse antigo aplicava display:none+aria-hidden no shell
					   inteiro (logo/busca/nav), deixando só o sticky clone e
					   focáveis órfãos dentro de aria-hidden. */
					var shell = bar.closest('#header.header-container');
					if (shell) {
						shell.style.removeProperty('display');
						if (shell.getAttribute('aria-hidden') === 'true') {
							shell.removeAttribute('aria-hidden');
						}
						shell.removeAttribute('inert');
					}
					if (persist) {
						try {
							localStorage.setItem('awa_b2b_promo_dismissed', '1');
							sessionStorage.setItem('awa_b2b_promo_dismissed_session', '1');
						} catch (storageError) {
							/* Storage pode estar bloqueado; o fechamento atual ainda funciona. */
						}
					}
				}

				/* Recuperação: sessões com o bug antigo (shell escondido junto da promo). */
				(function recoverShellFromLegacyDismiss() {
					var shell = document.getElementById('header');
					if (!shell || !bar) {
						return;
					}
					var shellHidden = shell.style.display === 'none'
						|| shell.getAttribute('aria-hidden') === 'true';
					var barHidden = bar.style.display === 'none'
						|| bar.getAttribute('aria-hidden') === 'true';
					if (shellHidden && barHidden) {
						shell.style.removeProperty('display');
						shell.removeAttribute('aria-hidden');
						shell.removeAttribute('inert');
					}
				}());

				try {
					if (localStorage.getItem('awa_b2b_promo_dismissed') === '1'
						|| sessionStorage.getItem('awa_b2b_promo_dismissed_session') === '1') {
						collapsePromo(false);
					}
				} catch (storageError) {
					/* Storage indisponível: a barra permanece visível até ser fechada. */
				}

				if (closeButton) {
					var handlePromoClose = function (event) {
						var target = event.target && event.target.closest
							? event.target.closest('#awa-b2b-promo-close')
							: null;
						if (target !== closeButton) {
							return;
						}
						window.removeEventListener('click', handlePromoClose, true);
						collapsePromo(true);
					};
					window.addEventListener('click', handlePromoClose, true);
				}

				/* Sync inicial: containers já aria-hidden no SSR (menu, cookie, etc.). */
				(function syncInitialInert() {
					var nodes = document.querySelectorAll(
						'[aria-hidden="true"]:not([inert]),' +
						'#awa-cookie-banner[hidden],' +
						'.awa-header-account-prompt__customer[hidden],' +
						'#awa-minicart-addons-source[hidden]'
					);
					var i;
					var n;
					for (i = 0; i < nodes.length; i += 1) {
						n = nodes[i];
						if (n.getAttribute('aria-hidden') === 'true' || n.hasAttribute('hidden')) {
							n.setAttribute('inert', '');
							if (!n.getAttribute('aria-hidden')) {
								n.setAttribute('aria-hidden', 'true');
							}
						}
					}
				}());
			}());
		</script>
	</div>
