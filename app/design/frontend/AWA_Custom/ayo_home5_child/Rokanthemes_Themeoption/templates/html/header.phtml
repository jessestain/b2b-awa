<script>
/* Home: sticky leve no scroll; runtime completo só na interação com controles.
 * r45: NÃO chamar require() durante o parse do header — require.min.js é classic
 * (sem defer) e o 1º require() sync competia com o paint LCP (~2.2s longtask,
 * evidência soft-wrap inl_13). Armar boots só após window.load; interação após load. */
(function (w, d) {
    'use strict';
    var fullDone = false;
    var stickyDone = false;
    var canBoot = false;

    function armBoots() {
        canBoot = true;
if ((w.pageYOffset || 0) > 0) {
            bootSticky();
        }
    }

    function bootFull() {
        if (!canBoot || fullDone) { return; }
        fullDone = true;
        if (typeof w.require !== 'function') { w.setTimeout(bootFull, 200); fullDone = false; return; }
        w.require(['awa-header-runtime-bootstrap'], function (initHeaderRuntime) {
            if (typeof initHeaderRuntime === 'function') {
                initHeaderRuntime();
            }
            stickyDone = true;
        }, function () {
            fullDone = false;
        });
    }

    function bootSticky() {
        if (!canBoot || stickyDone) { return; }
        stickyDone = true;
        if (typeof w.require !== 'function') { w.setTimeout(bootSticky, 200); stickyDone = false; return; }
        w.require(['awa-header-sticky'], function (initStickyHeader) {
            if (typeof initStickyHeader === 'function') {
                initStickyHeader();
            }
        }, function () {
            stickyDone = false;
        });
    }

    var events = ['pointerdown', 'touchstart', 'keydown'];
    events.forEach(function (ev) {
        w.addEventListener(ev, bootFull, { capture: true, passive: ev !== 'keydown', once: true });
    });
