<script>
(function (w, d) {
    'use strict';
    var src = <?= /* @noEscape */ json_encode($awaFooterBootUrl, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>;
    var loaded = false;
    function load() {
        if (loaded || d.getElementById('awa-footer-boot-js')) {
            return;
        }
        loaded = true;
        var s = d.createElement('script');
        s.id = 'awa-footer-boot-js';
        s.src = src;
        s.async = true;
        (d.body || d.documentElement).appendChild(s);
    }
    var footer = d.querySelector('.page-footer, .page_footer, footer');
    if (footer && 'IntersectionObserver' in w) {
        var io = new IntersectionObserver(function (entries) {
            if (entries.some(function (e) { return e.isIntersecting; })) {
                io.disconnect();
                load();
            }
        }, { rootMargin: '200px 0px' });
        io.observe(footer);
    }
    if ('requestIdleCallback' in w) {
        w.requestIdleCallback(load, { timeout: 8000 });
    } else {
        w.setTimeout(load, 5000);
    }
})(window, document);
</script>
<?php else: ?>
<script defer src="<?= $escaper->escapeUrl($awaFooterBootUrl) ?>"></script>
