?>
<?php if (isset($data['font']['custom']) && $data['font']['custom'] && $data['font']['font_family'] == 'google'): ?>
<?php if ($isMontserrat): ?>
<!-- AWA Fonts 2026-06-11: o design system (tokens --awa-font-*) usa Rubik (títulos) e
     Source Sans 3 (corpo). O preload anterior de Montserrat (38KB) baixava fonte não usada
     em nenhum CSS publicado. Agora: preload + @font-face inline das fontes reais acima da
     dobra (rubik-600 para headings, source-sans-3-400 para body), self-hosted, swap.
     As demais variações de peso carregam via awa-super-global (async). -->
<link rel="preload"
      href="<?= $this->escapeUrl($this->getViewFileUrl('fonts/rubik/rubik-600.woff2')) ?>"
      as="font" type="font/woff2" crossorigin="anonymous"/>
<link rel="preload"
      href="<?= $this->escapeUrl($this->getViewFileUrl('fonts/source-sans-3/source-sans-3-400.woff2')) ?>"
      as="font" type="font/woff2" crossorigin="anonymous"/>
<style>
@font-face {
    font-family: 'Rubik';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('<?= $this->escapeUrl($this->getViewFileUrl('fonts/rubik/rubik-600.woff2')) ?>') format('woff2');
}
@font-face {
    font-family: 'Source Sans 3';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('<?= $this->escapeUrl($this->getViewFileUrl('fonts/source-sans-3/source-sans-3-400.woff2')) ?>') format('woff2');
}
</style>
<?php else: ?>
<!-- Non-Montserrat Google font: load from Google with async -->
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" media="print" onload="this.media='all'" href='//fonts.googleapis.com/css?family=<?php echo str_replace(' ', '+', $data['font']['google_font_family']).$font_sizes; echo $charSubset; ?>&display=swap' type='text/css' />
<noscript><link rel="stylesheet" href='//fonts.googleapis.com/css?family=<?php echo str_replace(' ', '+', $data['font']['google_font_family']).$font_sizes; echo $charSubset; ?>&display=swap' type='text/css' /></noscript>
<?php endif; ?>
<?php else: ?>
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin/>
