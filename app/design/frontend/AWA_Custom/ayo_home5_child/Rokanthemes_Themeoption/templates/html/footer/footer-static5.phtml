$addressLabel = $footerData instanceof \GrupoAwamotos\Theme\ViewModel\FooterData
    ? $footerData->getFormattedAddress()
    : 'Araraquara - SP';
/* SEÇÃO 51.8: two-line store address so CEP cannot be ellipsed away. */
$addressStreet = $addressLabel;
$addressCityCep = '';
if ($footerData instanceof \GrupoAwamotos\Theme\ViewModel\FooterData) {
    $street = trim($footerData->getStreetLine1());
    $city = trim($footerData->getCityLabel());
    $postcode = trim($footerData->getPostcode());
    $cityCepParts = array_filter(
        [
            $city,
            $postcode !== '' ? 'CEP: ' . $postcode : '',
        ],
        static fn(string $part): bool => $part !== ''
    );
    if ($street !== '' && $cityCepParts !== []) {
        $addressStreet = $street;
        $addressCityCep = implode(' - ', $cityCepParts);
    }
} elseif (preg_match('/^(.*?)\s+-\s+(.*\bCEP:.*)$/u', $addressLabel, $addressParts) === 1) {
    $addressStreet = $addressParts[1];
    $addressCityCep = $addressParts[2];
}

