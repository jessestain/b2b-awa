<?php
use Magento\Framework\App\Action\Action;
$isHomePage = $block->getRequest()->getFullActionName() === 'cms_index_index';
/** @var \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel|null $cardVm */
$cardVm = $block->getData('bestseller_card_view_model');
$hasCardVm = $cardVm instanceof \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel;
$b2bPriceGate = $hasCardVm ? $cardVm : $this->helper(\GrupoAwamotos\B2B\Helper\Data::class);
if($this->getConfig('enabled')){ // start enable module?>
	<?php $_productCollection = $this->getProducts();
	?>
	<div class="rokan-featuredproduct rokan-featured awa-shelf awa-shelf--carousel" data-awa-shelf="featured">

		<?php
			if ($block->getMode() == 'grid') {
				$viewMode = 'grid';
				$image = 'category_page_grid';
				$showDescription = false;
				$templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
			} else {
				$viewMode = 'list';
				$image = 'category_page_list';
				$showDescription = true;
				$templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::FULL_VIEW;
			}
			$pos = $block->getPositioned();

		?>
		<?php if($this->getConfig('title')){?>
			<div class="rokan-product-heading rokan-featured-heading"><h2><?php echo $this->getConfig('title')?></h2></div>
		<?php }?>
		<?php if(!$_productCollection->getSize()): ?>
			<div class="rokan-featured-slider">
				<p class="note-msg"><?php echo __('There are no products matching the selection.') ?></p>
			</div>
		<?php else: ?>
			<?php
			$rows = $this->getConfig('row_show');
			?>
			<div class="row">
				<ul class="owl">
					<?php $_collectionSize = $_productCollection->count() ?>
					<?php $i=0; foreach ($_productCollection as $_product): ?>
						<?php if($i %$rows == 0) echo "<li class='item featuredproductslider-item'>"; ?>

							<div class="product-item">
								<?php
								$newFromDate = $_product->getNewsFromDate();
								$newToDate = $_product->getNewsToDate();
								$now = date("Y-m-d H:i:s");
								// Get the Special Price
								$specialprice = $_product->getSpecialPrice();
								// Get the Special Price FROM date
								$specialPriceFromDate = $_product->getSpecialFromDate();
								// Get the Special Price TO date
								$specialPriceToDate = $_product->getSpecialToDate();
								// Get Current date
								if ($specialprice&&($specialPriceFromDate <= $now && $specialPriceToDate >= $now)){
									echo "<span class='icon-sale icon-product'>" . __('Promoção') . "</span>";
									}else{
									if($newFromDate <= $now && $newToDate >= $now) {
										echo "<span class='icon-new icon-product'>" . __('Quente') . "</span>";
										//echo $now.' -- '.$newsFrom.' -- '.$newsTo;
									}
								}
								?>
								<?php
								$productImage = $block->getImage($_product, $image);
								if ($pos != null) {
									$position = ' style="left:' . $productImage->getWidth() . 'px;'
										. 'top:' . $productImage->getHeight() . 'px;"';
								}
								$productImageHtml = (string) $productImage->toHtml();
								if (!$isHomePage && $i < 2) {
									$productImageHtml = str_replace(' loading="lazy"', ' loading="eager" fetchpriority="high"', $productImageHtml);
								} else {
									$productImageHtml = str_replace([' loading="eager"', ' fetchpriority="high"'], [' loading="lazy"', ''], $productImageHtml);
								}
								if (strpos($productImageHtml, 'decoding=') === false) {
									$productImageHtml = str_replace('<img ', '<img decoding="async" ', $productImageHtml);
								}
								?>
								<?php // Product Image ?>
								<a href="<?php echo $block->escapeUrl($_product->getProductUrl()) ?>" class="product photo product-item-photo" tabindex="-1" aria-label="<?php echo $block->escapeHtml($_product->getName()); ?>">
									<?php echo /* @noEscape */ $productImageHtml; ?>
								</a>
								<?php
									$_productNameStripped = $block->stripTags($_product->getName(), null, true);
								?>
								<strong class="product name product-item-name">
									<a class="product-item-link"
									   title="<?php echo $block->escapeHtml($_product->getName()); ?>"
									   href="<?php echo $block->escapeUrl($_product->getProductUrl()) ?>">
										<?php echo $block->escapeHtml($_product->getName()); ?>
									</a>
								</strong>

								<?php if($_product->getSku()): ?><span class="awa-b2b-sku"><?= $block->escapeHtml($_product->getSku()) ?></span><?php endif; ?>
								<?php if( $this->getConfig('show_price') ): ?>
									<?php if ($b2bPriceGate->canViewPrices()): ?>
										<?php /* @escapeNotVerified */ echo ($hasCardVm ? $cardVm->priceDisplayHtml((string) $block->getProductPrice($_product)) : $this->helper('Rokanthemes\Themeoption\Helper\Data')->getPriceDisplayCustom($block->getProductPrice($_product))) ?>
									<?php else: ?>
										<div class="b2b-login-to-see-price">
											<span class="b2b-login-to-see-price__title"><?= $block->escapeHtml($b2bPriceGate->getPriceGateHeadline()) ?></span>
											<span class="b2b-login-to-see-price__message"><?= $block->escapeHtml($b2bPriceGate->getPriceGateDescription()) ?></span>
										</div>
									<?php endif; ?>
								<?php endif; ?>

								<?php if($this->getConfig('review')): ?><div class="product-ratting">
									<?php if($this->getConfig('review')): ?>
										<?php echo $block->getReviewsSummaryHtml($_product, $templateType); ?>
									<?php endif; ?>
								</div><?php endif; ?>

								<div class="actions clearfix product-info-cart">
									<div class="action-inner">
										<?php if ($this->getConfig('addtocart')) { ?>
										<div class="actions-primary"<?php echo strpos((string)$pos, $viewMode . '-primary') ? $position : ''; ?>>
											<?php if ($_product->isSaleable()): ?>
												<?php $postParams = $block->getAddToCartPostParams($_product); ?>
												<form data-role="tocart-form" action="<?php /* @escapeNotVerified */ echo $postParams['action']; ?>" method="post">
													<input type="hidden" name="product" value="<?php /* @escapeNotVerified */ echo $postParams['data']['product']; ?>">
													<input type="hidden" name="<?php /* @escapeNotVerified */ echo Action::PARAM_NAME_URL_ENCODED; ?>" value="<?php /* @escapeNotVerified */ echo $postParams['data'][Action::PARAM_NAME_URL_ENCODED]; ?>">
													<?php echo $block->getBlockHtml('formkey')?>
													<button type="submit"
															title="<?php echo $block->escapeHtml(__('Adicionar ao Carrinho')); ?>"
                                                               aria-label="<?php echo $block->escapeHtml(__('Adicionar ao Carrinho') . (isset($_product) ? ': ' . $_product->getName() : (isset($_item) ? ': ' . $_item->getName() : ''))); ?>"
															class="action tocart primary">
														<span><?php /* @escapeNotVerified */ echo __('Adicionar ao Carrinho') ?></span>
													</button>
												</form>
											<?php else: ?>
												<?php if ($_product->getIsSalable()): ?>
													<div class="stock available"><span><?php /* @escapeNotVerified */ echo __('Em estoque') ?></span></div>
												<?php else: ?>
													<div class="stock unavailable"><span><?php /* @escapeNotVerified */ echo __('Esgotado') ?></span></div>
												<?php endif; ?>
											<?php endif; ?>
										</div>
										<?php }?>

										<?php if( false /* B2B */ || false /* B2B */ ){?>
											<ul class="add-to-links">
											<?php if( false /* B2B */): ?>
													<?php if ($this->helper('Magento\Wishlist\Helper\Data')->isAllow()): ?>
													<li>
														<a href="#"
														   class="action towishlist"
														   title="<?php echo $block->escapeHtml(__('Add to Wish List')); ?>"
														   aria-label="<?php echo $block->escapeHtml(__('Add to Wish List')); ?>"
														   data-post='<?php /* @escapeNotVerified */ echo $block->getAddToWishlistParams($_product); ?>'
														   data-action="add-to-wishlist"
														   role="button">
															<span><?php /* @escapeNotVerified */ echo __('Add to Wish List') ?></span>
														</a>
													</li>
													<?php endif; ?>
												<?php endif; ?>

											<?php if( false /* B2B */): ?>
											<?php
												$compareHelper = $this->helper('Magento\Catalog\Helper\Product\Compare');
												?>
												<li><a href="#"
												   class="action tocompare"
												   title="<?php echo $block->escapeHtml(__('Add to Compare')); ?>"
												   aria-label="<?php echo $block->escapeHtml(__('Add to Compare')); ?>"
												   data-post='<?php /* @escapeNotVerified */ echo $compareHelper->getPostDataParams($_product); ?>'
												   role="button">
													<span><?php /* @escapeNotVerified */ echo __('Add to Compare') ?></span>
													</a>
												</li>
											<?php endif; ?>
											</ul>
										<?php }?>
									</div>
								</div>
								<?php if( $this->getConfig('description')){?>
									<div class="ma-desc">
										 <?php echo $block->getProductDetailsHtml($_product); ?>
									</div>
								<?php }?>
							<?php $i++;?>
						</div>
						<?php if($i %$rows == 0) echo "</li>"; ?>
					<?php endforeach; ?>
						<?php if($i %$rows != 0) echo "</li>"; ?>
				</ul>
			</div>
	<?php endif; ?>
	</div>

<?php } ?>
