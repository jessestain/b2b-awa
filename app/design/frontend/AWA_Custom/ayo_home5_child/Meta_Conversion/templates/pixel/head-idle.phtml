    }

    function allowsMarketing() {
        try {
            if (w.localStorage && w.localStorage.getItem('awa_cookie_consent') === 'all') {
                return true;
            }
            if (w.localStorage && w.localStorage.getItem('awa_cookie_consent') === 'essential') {
                return false;
            }
        } catch (e) {}
        return /(?:^|;\s*)awa_cookies_accepted=all(?:;|$)/.test(d.cookie || '');
    }

    function schedulePixel() {
        if (!allowsMarketing()) {
            return;
        }
        var isHome = d.body && d.body.classList.contains('cms-index-index');
        if (isHome) {
            if ('requestIdleCallback' in w) {
                w.requestIdleCallback(bootPixel, { timeout: 3000 });
            } else {
                w.setTimeout(bootPixel, 1200);
            }
            return;
        }
        if ('requestIdleCallback' in w) {
            w.requestIdleCallback(bootPixel, { timeout: 2500 });
        } else {
            w.addEventListener('load', function () {
                w.setTimeout(bootPixel, 0);
            }, { once: true });
        }
    }

    if (allowsMarketing()) {
        schedulePixel();
    } else {
        w.addEventListener('awa:cookie-consent', function (ev) {
            if (ev && ev.detail && ev.detail.value === 'all') {
                schedulePixel();
            }
        });
    }
})(window, document);
