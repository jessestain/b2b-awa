 *
 * AWA: skip OpenSearch "Did you mean" only when q is an existing catalog SKU.
 * Text queries (bagageiro, retrovisor) keep spelling suggestions.
 */

/**
 * @var \Magento\AdvancedSearch\Block\SearchData $block
 * @var \Magento\Framework\Locale\LocaleFormatter $localeFormatter
 */
?>
<?php
$queryText = trim((string) $block->getRequest()->getParam('q', ''));
$skuClassifier = $block->getData('sku_query_classifier');
if (!$skuClassifier instanceof \Awa\CatalogFix\Model\Search\SkuQueryClassifier) {
    $skuClassifier = \Magento\Framework\App\ObjectManager::getInstance()
        ->get(\Awa\CatalogFix\Model\Search\SkuQueryClassifier::class);
}
if (
    $queryText !== ''
    && $skuClassifier->isExistingExactSkuQuery($queryText)
) {
    return;
}

/** @var \Magento\Search\Model\QueryResult[] $data */
$data = $block->getItems();
if (count($data)): ?>
    <dl class="block">
        <dt class="title"><?= $block->escapeHtml(__($block->getTitle())) ?></dt>
        <?php foreach ($data as $additionalInfo): ?>
            <dd class="item">
                <a href="<?= $block->escapeUrl($block->getLink($additionalInfo->getQueryText())) ?>"
                    ><?= $block->escapeHtml($additionalInfo->getQueryText()) ?></a>
                <?php if ($block->isShowResultsCount()): ?>
                    <span class="count">
                        <?= /* @noEscape */ $localeFormatter->formatNumber((int)$additionalInfo->getResultsCount()) ?>
                    </span>
                <?php endif; ?>
            </dd>
        <?php endforeach; ?>
    </dl>
<?php endif; ?>
