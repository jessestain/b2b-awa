<?xml version="1.0"?>
<!--
  Declaracoes versionadas dos templates de e-mail transacional (pt-BR) no TEMA.
  Observacao tecnica: o leitor de email_templates.xml do Magento 2.4.x varre apenas modulos
  (ComponentRegistrar::MODULE em vendor/magento/module-email/Model/Template/Config/FileResolver.php),
  portanto este arquivo de TEMA e declarativo/documental (versiona o mapeamento junto do tema).
  Em runtime valem as declaracoes do modulo Magento_Sales e os arquivos deste tema sobrescrevem
  via fallback de design: app/design/frontend/AWA_Custom/ayo_home5_child/Magento_Sales/email/*.html
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Email:etc/email_templates.xsd">
    <template id="sales_email_order_template"
              label="Confirmacao de Pedido (AWA, pt-BR, tema)"
              file="order_new.html"
              type="html"
              module="Magento_Sales"
              area="frontend"/>
    <template id="sales_email_order_guest_template"
              label="Confirmacao de Pedido Guest (AWA, tema)"
              file="order_new_guest.html"
              type="html"
              module="Magento_Sales"
              area="frontend"/>
    <template id="sales_email_invoice_template"
