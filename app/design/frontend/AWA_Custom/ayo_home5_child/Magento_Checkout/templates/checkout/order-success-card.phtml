<?php
declare(strict_types=1);
/**
 * Card de confirmação B2B — reutilizado em success.phtml e noItems.phtml.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var array<string, mixed>|null $presentation
 */
$presentation = $block->getData('presentation');
if (!is_array($presentation) || ($presentation['incrementId'] ?? '') === '') {
    return;
}

$itemsCountLabel = (int) ($presentation['itemsCount'] ?? 0) === 1
    ? (string) __('1 peça')
    : (string) __('%1 peças', (int) ($presentation['itemsCount'] ?? 0));
$catalogUrl = (string) ($block->getData('catalog_url') ?: $block->getUrl('catalogo'));
$whatsappUrl = (string) ($block->getData('whatsapp_url') ?: '');
$showCategories = (bool) $block->getData('show_categories');
$featuredCategories = is_array($block->getData('featured_categories')) ? $block->getData('featured_categories') : [];
$allCategoriesUrl = (string) ($block->getData('all_categories_url') ?: $catalogUrl);
?>
<div class="awa-order-success"
     data-awa-order-success="1"
     aria-labelledby="awa-order-success-title">
    <div class="awa-order-success__icon-wrap" aria-hidden="true">
        <svg class="awa-order-success__icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="32" cy="32" r="28"/>
            <path d="M20 32l8 8 16-18"/>
        </svg>
    </div>

    <?php /* p estilizado: o H1 da página já anuncia "Pedido confirmado" — evita título duplicado para leitores de tela */ ?>
    <p id="awa-order-success-title" class="awa-order-success__title">
        <?= $block->escapeHtml($presentation['headline'] ?? __('Pedido confirmado!')) ?>
    </p>

    <p class="awa-order-success__subtitle">
        <?= $block->escapeHtml($presentation['subline'] ?? '') ?>
    </p>

    <div class="awa-order-success__card" role="status" aria-live="polite">
        <dl class="awa-order-success__details">
            <div class="awa-order-success__row">
                <dt><?= $block->escapeHtml(__('Número do pedido')) ?></dt>
                <dd class="awa-order-success__number">#<?= $block->escapeHtml((string) $presentation['incrementId']) ?></dd>
            </div>
            <div class="awa-order-success__row">
                <dt><?= $block->escapeHtml(__('Data')) ?></dt>
                <dd><?= $block->escapeHtml((string) ($presentation['formattedDate'] ?? '')) ?></dd>
            </div>
            <?php if ((int) ($presentation['itemsCount'] ?? 0) > 0): ?>
            <div class="awa-order-success__row">
                <dt><?= $block->escapeHtml(__('Itens')) ?></dt>
                <dd><?= $block->escapeHtml($itemsCountLabel) ?></dd>
            </div>
            <?php endif; ?>
            <div class="awa-order-success__row">
                <dt><?= $block->escapeHtml(__('Total')) ?></dt>
                <dd class="awa-order-success__total"><?= $block->escapeHtml((string) ($presentation['grandTotalFormatted'] ?? '')) ?></dd>
            </div>
            <div class="awa-order-success__row">
                <dt><?= $block->escapeHtml(__('Pagamento')) ?></dt>
                <dd><?= $block->escapeHtml((string) ($presentation['paymentLabel'] ?? '')) ?></dd>
            </div>
        </dl>
        <p class="awa-order-success__next">
            <?= $block->escapeHtml((string) ($presentation['nextStep'] ?? '')) ?>
        </p>
    </div>

    <div class="awa-order-success__actions" role="group" aria-label="<?= $block->escapeHtmlAttr(__('Próximos passos')) ?>">
        <a href="<?= $block->escapeUrl((string) ($presentation['orderUrl'] ?? '#')) ?>" class="awa-order-success__cta action primary">
            <?= $block->escapeHtml(__('Ver meu pedido #%1', (string) $presentation['incrementId'])) ?>
        </a>
        <a href="<?= $block->escapeUrl($catalogUrl) ?>" class="awa-order-success__cta-secondary">
            <?= $block->escapeHtml(__('Fazer novo pedido')) ?>
        </a>

        <?php if ($whatsappUrl !== ''): ?>
        <a href="<?= $block->escapeUrl($whatsappUrl) ?>"
           class="awa-order-success__wa"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="<?= $block->escapeHtmlAttr(__('Falar com a equipe (abre no WhatsApp em nova aba)')) ?>">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-9 8.4 8.5 8.5 0 0 1-4.1-1.2L3 20l1.3-4.5a8.47 8.47 0 1 1 16.7-4z"/>
                <path d="M8.5 9.5c.6 2 2 3.4 4 4l1.2-1.2c.2-.2.5-.3.8-.2 1 .3 2 .5 3 .5"/>
            </svg>
            <?= $block->escapeHtml(__('Falar com a equipe')) ?>
        </a>
        <?php endif; ?>
    </div>

    <?php if ($showCategories && $featuredCategories !== []): ?>
    <div class="awa-order-success__categories" aria-labelledby="awa-order-success-categories-heading">
        <h2 id="awa-order-success-categories-heading" class="awa-order-success__categories-heading">
            <?= $block->escapeHtml(__('Comece por estas categorias')) ?>
        </h2>
        <div class="awa-order-success__categories-list">
            <?php foreach ($featuredCategories as $cat): ?>
            <a href="<?= $block->escapeUrl((string) ($cat['url'] ?? '#')) ?>" class="awa-order-success__category-chip">
                <?= $block->escapeHtml($cat['label'] ?? '') ?>
            </a>
            <?php endforeach; ?>
        </div>
        <a href="<?= $block->escapeUrl($allCategoriesUrl) ?>" class="awa-order-success__categories-more">
            <?= $block->escapeHtml(__('Ver todas as categorias')) ?>
        </a>
    </div>
    <?php endif; ?>

    <p class="awa-order-success__trust">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
        </svg>
        <?= $block->escapeHtml(__('Ambiente seguro B2B · Faturamento via CNPJ')) ?>
    </p>
</div>
