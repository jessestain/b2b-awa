<?php
declare(strict_types=1);
/**
 * AWA Motos — Carrinho Vazio / Confirmação pós-pedido (noItems.phtml)
 *
 * @var \Magento\Checkout\Block\Cart $block
 * @var \GrupoAwamotos\B2B\ViewModel\Cart\EmptyCartContext|null $viewModel
 */
$viewModel = $block->getData('view_model');
$catalogUrl = $viewModel instanceof \GrupoAwamotos\B2B\ViewModel\Cart\EmptyCartContext
    ? $viewModel->getCatalogUrl()
    : $block->getUrl('catalogo');
$allCategoriesUrl = $viewModel instanceof \GrupoAwamotos\B2B\ViewModel\Cart\EmptyCartContext
    ? $viewModel->getAllCategoriesUrl()
    : $catalogUrl;
$featuredCategories = $viewModel instanceof \GrupoAwamotos\B2B\ViewModel\Cart\EmptyCartContext
    ? $viewModel->getFeaturedCategories()
    : [];
$whatsappText = rawurlencode((string) __('Olá, acabei de fazer um pedido B2B e preciso de ajuda.'));
$whatsappUrl = 'https://wa.me/5516997367588?text=' . $whatsappText;
$showExpressNotice = $viewModel instanceof \GrupoAwamotos\B2B\ViewModel\Cart\EmptyCartContext
    && $viewModel->consumeExpressCheckoutNotice();
$homeUrl = $block->getUrl('');
$quote = method_exists($block, 'getQuote') ? $block->getQuote() : null;
$serverItemsCount = $quote ? (int) $quote->getItemsCount() : 0;
$orderSuccess = $viewModel instanceof \GrupoAwamotos\B2B\ViewModel\Cart\EmptyCartContext
    ? $viewModel->getOrderSuccessPresentation()
    : null;
$isOrderSuccess = $orderSuccess !== null;
?>
<?php if ($isOrderSuccess): ?>
<div class="cart-empty awa-cart-empty awa-cart-empty--success"
     data-awa-cart-empty="1"
     data-awa-order-success="1"
     data-awa-server-items-count="<?= (int) $serverItemsCount ?>">
    <?= $block->getChildHtml('checkout_cart_empty_widget') ?>
    <?= $block->getLayout()
        ->createBlock(\Magento\Framework\View\Element\Template::class)
        ->setTemplate('Magento_Checkout::checkout/order-success-card.phtml')
        ->setData('presentation', $orderSuccess)
        ->setData('catalog_url', $catalogUrl)
        ->setData('whatsapp_url', $whatsappUrl)
        ->setData('show_categories', true)
        ->setData('featured_categories', $featuredCategories)
        ->setData('all_categories_url', $allCategoriesUrl)
        ->toHtml() ?>
    <?= $block->getChildHtml('shopping.cart.table.after') ?>
</div>
<?php else: ?>
<?php /* 2026-08-04 session 19da9f: layout referência (fundo branco + emoticon + CTA home). */ ?>
<div class="cart-empty awa-cart-empty awa-cart-empty--simple"
     data-awa-cart-empty="1"
     data-awa-server-items-count="<?= (int) $serverItemsCount ?>"
     <?= $showExpressNotice ? ' data-awa-express-notice="1"' : '' ?>
     aria-labelledby="awa-cart-empty-title">
    <?= $block->getChildHtml('checkout_cart_empty_widget') ?>

    <div class="awa-cart-empty__hero">
        <div class="awa-cart-empty__emoticon" aria-hidden="true">:(</div>

        <h2 id="awa-cart-empty-title" class="awa-cart-empty__title">
            <?= $block->escapeHtml(__('Que pena, seu carrinho está vazio!')) ?>
        </h2>

        <?php if ($showExpressNotice): ?>
            <div class="awa-cart-empty__notice" role="status">
                <?= $block->escapeHtml($viewModel->getExpressCheckoutNotice()) ?>
            </div>
        <?php endif; ?>

        <p class="awa-cart-empty__subtitle">
            <?= $block->escapeHtml(__('Acesse a página inicial do nosso site e veja as ofertas especiais que separamos para você.')) ?>
        </p>

        <?php if ($viewModel instanceof \GrupoAwamotos\B2B\ViewModel\Cart\EmptyCartContext && $viewModel->shouldShowMinOrderHint()): ?>
            <p class="awa-cart-empty__min-order" role="note">
                <?= $block->escapeHtml(__('Pedido mínimo B2B:')) ?>
                <strong><?= $block->escapeHtml($viewModel->getMinOrderAmountFormatted()) ?></strong>.
                <?= $block->escapeHtml(__('Adicione peças para seguir à finalização do pedido.')) ?>
            </p>
        <?php endif; ?>

        <div class="awa-cart-empty__actions" role="group" aria-label="<?= $block->escapeHtmlAttr(__('Próximos passos')) ?>">
            <a href="<?= $block->escapeUrl($homeUrl) ?>"
               class="awa-cart-empty__cta"
               data-awa-cart-empty-cta="home">
                <?= $block->escapeHtml(__('Voltar à Página Inicial')) ?>
            </a>
        </div>
    </div>

    <?= $block->getChildHtml('shopping.cart.table.after') ?>
</div>
<?php endif; ?>
<script type="text/x-magento-init">
{
    "*": {
        "Magento_Checkout/js/empty-cart": {}
    }
}
</script>
