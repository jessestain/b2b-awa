	<?php
use Magento\Framework\App\Action\Action;
	$enable = $block->getConfig('enabled');
	if($enable < 1) return ;
	$items = $block->getConfig('items');
	$speed = $block->getConfig('speed');
	$qty = $block->getConfig('qty');
	$showCart = $block->getConfig('addtocart');
	$showWishlist = $block->getConfig('wishlist');
	$showCompare = $block->getConfig('compare');
	$show_navigation = $block->getConfig('navigation');
	$show_pagination = $block->getConfig('pagination');
	$auto = $block->getConfig('auto');
	$image = 'new_products_content_widget_grid';
	$type = 'widget-new-grid';
	$templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::DEFAULT_VIEW;
	$rows = 2;
	$newLabelHelper = $this->helper('Rokanthemes\RokanBase\Helper\Newlabel');
	$isHomePage = $block->getRequest()->getFullActionName() === 'cms_index_index';
	$scopeSuffix = preg_replace('/[^a-zA-Z0-9_-]+/', '-', (string) $block->getNameInLayout());
	if ($scopeSuffix === '') {
		$scopeSuffix = 'widget';
	}
	/** @var \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel|null $cardVm */
	$cardVm = $block->getData('bestseller_card_view_model');
	$hasCardVm = $cardVm instanceof \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel;
	$b2bPriceGate = $hasCardVm ? $cardVm : $this->helper('GrupoAwamotos\B2B\Helper\Data');
	?>
<div class="list-tab-product common-tab-system-fixed producttab-<?php echo $scopeSuffix; ?>">
	<div class="rokan-product-heading clearfix">
    	<h2><?php echo $block->escapeHtml(__('Os Principais')) ?><span class="sup-title"> <?php echo $block->escapeHtml(__('Produtos %1', date('Y'))) ?></span></h2>
    </div>
	<div class="clearfix">
        <div class="vc_tta-tabs-container">
	        <ul class="tabs" role="tablist">
		        <?php
		        $tab_contents = $block->getTabContent() ;
		        $tabIdx = 0;
		        foreach($tab_contents as $tab) {
		          ?>
		          <?php $scopedTabId = 'tab_' . $block->escapeHtmlAttr($scopeSuffix . '_' . $tab['id']); ?>
		          <?php $tabId = $scopedTabId . '_tab'; ?>
		          <li
		              id="<?php echo $tabId; ?>"
		              rel="<?php echo $scopedTabId; ?>"
		              class="<?php echo $block->escapeHtmlAttr($tab['class']); ?>"
		              role="tab"
		              tabindex="0"
		              aria-selected="<?php echo ($tabIdx++ === 0) ? 'true' : 'false'; ?>"
		              aria-controls="<?php echo $scopedTabId; ?>"
		          >
		              <span class="awa-tab-button"><?php echo $block->escapeHtml($tab['name']);?></span>
		          </li>
		          <?php
		        }
		        ?>
	        </ul>
        </div>
    </div>
    <div class="row">
		<div class="tab_container">
		   <?php
			foreach($tab_contents as $tab) {
			?>
			 <div id="<?php echo $scopedTabId; ?>" class="product-tab-slider tab_content <?php echo $block->escapeHtmlAttr($tab['class']); ?>" role="tabpanel" aria-labelledby="<?php echo $tabId; ?>">
			 	<div class="productTabContent">
				<?php
					$i=0;
					$productItems =  $tab['productInfo'];
					$productTabImgIdx = 0;
					foreach($productItems as $_item) {
							$productImage = $block->getImage($_item, $image);
					?>
						<?php if($i++%$rows==0) { ?> <div class="product_row"> <?php } ?>
						<div class="item-product-parent">
							<div class="item-product listview">
								<div class="product-thumb">
									<a href="<?php echo $block->escapeUrl($_item->getProductUrl()); ?>" class="product-thumb-link">
										<?php
										$productImageThumb = $block->getImage($_item, 'category_image_second_small');
										$productImageThumbUrl = (string)$productImageThumb->getImageUrl();
										$productImagePrimaryUrl = (string)$productImage->getImageUrl();
										$tabMainImgHtml = (string) $productImage->toHtml();
										$tabThumbImgHtml = (string) $productImageThumb->toHtml();
										if ($isHomePage) {
											$tabMainImgHtml = str_replace([' loading="eager"', ' fetchpriority="high"'], [' loading="lazy"', ''], $tabMainImgHtml);
											$tabThumbImgHtml = str_replace([' loading="eager"', ' fetchpriority="high"'], [' loading="lazy"', ''], $tabThumbImgHtml);
										} elseif ($productTabImgIdx < 2) {
											$tabMainImgHtml = str_replace(' loading="lazy"', ' loading="eager" fetchpriority="high"', $tabMainImgHtml);
											$tabThumbImgHtml = str_replace(' loading="lazy"', ' loading="eager" fetchpriority="high"', $tabThumbImgHtml);
										} else {
											$tabMainImgHtml = str_replace([' loading="eager"', ' fetchpriority="high"'], [' loading="lazy"', ''], $tabMainImgHtml);
											$tabThumbImgHtml = str_replace([' loading="eager"', ' fetchpriority="high"'], [' loading="lazy"', ''], $tabThumbImgHtml);
										}
										if (strpos($tabMainImgHtml, 'decoding=') === false) {
											$tabMainImgHtml = str_replace('<img ', '<img decoding="async" ', $tabMainImgHtml);
										}
										if (strpos($tabThumbImgHtml, 'decoding=') === false) {
											$tabThumbImgHtml = str_replace('<img ', '<img decoding="async" ', $tabThumbImgHtml);
										}
										?>
										<span class="first-thumb">
											<?php echo /* @noEscape */ $tabMainImgHtml; ?>
										</span>
										<?php $productType = $_item->getTypeID();
										if ($productType === 'simple' && strpos($productImageThumbUrl, '/placeholder/') === false && $productImageThumbUrl !== $productImagePrimaryUrl): ?>
											<span class="second-thumb">
												<?php echo /* @noEscape */ $tabThumbImgHtml; ?>
											</span>
				                		<?php endif; ?>
									</a>
									<div class="hot-onsale">
										<?php if ( $_item->getFinalPrice() < $_item->getPrice() ): ?>

												<span class="onsale">
												<span class="sale-bg"></span>
												<span class="sale-text"><?php /* @noEscape */ echo $block->showLableSalePrice($_item); ?>
												</span>
												</span>
										<?php endif; ?>
											<?php if($newLabelHelper->isProductNew($_item)): ?>
											<div class="onsale new-lable">
										    <?php echo $block->escapeHtml(__('New')); ?>
											</div>
										<?php endif; ?>
									</div>
							    </div>
							    <div class="product-info">
									<h3 class="product-name">
			 							<a title="<?php echo $block->escapeHtml($_item->getName()); ?>" href="<?php echo $block->escapeUrl($_item->getProductUrl()); ?>" class="product-item-link">
											<?php echo $block->escapeHtml($_item->getName()); ?>
										</a>
									</h3>
									<div class="product-rating">
										<?php if ($templateType): ?>
												<?php echo $block->getReviewsSummaryHtml($_item, $templateType,true); ?>
											<?php endif; ?>
									</div>
									<div class="sold-by">
										<?php $cats = $_item->getAttributeText('sold_by'); ?>
										<?php if (!empty($cats)): ?>
											<span><?php echo $block->escapeHtml(__('Sold by:')); ?></span><?php echo $block->escapeHtml($cats); ?>
										<?php endif; ?>
									</div>
									<div class="info-price">
										<?php if ($b2bPriceGate->canViewPrices()): ?>
											<?php /* @noEscape */ echo $hasCardVm
												? $cardVm->priceDisplayHtml((string) $block->getProductPrice($_item))
												: $this->helper('Rokanthemes\Themeoption\Helper\Data')->getPriceDisplayCustom($block->getProductPrice($_item)) ?>
										<?php else: ?>
											<div class="b2b-login-to-see-price">
												<span class="b2b-login-to-see-price__title"><?php echo $block->escapeHtml($b2bPriceGate->getPriceGateHeadline()); ?></span>
												<span class="b2b-login-to-see-price__message"><?php echo $block->escapeHtml($b2bPriceGate->getPriceGateDescription()); ?></span>
											</div>
										<?php endif; ?>
									</div>
									<div class="product-info-cart">
						                <?php if ($showCart): ?>
						                    <div class="actions-primary addcart-link">
						                        <?php if ($_item->isSaleable()): ?>
						                        <?php
						                          if (method_exists($block, 'getAddToCartPostParams')) {
						                              $postParams = $block->getAddToCartPostParams($_item);
						                          } else {
						                              $postDataHelper = $this->helper('Magento\Framework\Data\Helper\PostHelper');
						                              $postData = $postDataHelper->getPostData($block->getAddToCartUrl($_item), ['product' => $_item->getEntityId()]);
						                              $postParams = json_decode($postData, true);
						                          }
						                          ?>
						                        <form data-role="tocart-form" action="<?php echo $block->escapeUrl($postParams['action']); ?>" method="post">
						                          <input type="hidden" name="product" value="<?php echo $block->escapeHtmlAttr($postParams['data']['product']); ?>">
						                          <input type="hidden" name="<?php echo $block->escapeHtmlAttr(Action::PARAM_NAME_URL_ENCODED); ?>" value="<?php echo $block->escapeHtmlAttr($postParams['data'][Action::PARAM_NAME_URL_ENCODED]); ?>">
						                          <?php echo $block->getBlockHtml('formkey')?>
						                          <button type="submit"
						                              title="<?php echo $block->escapeHtml(__('Adicionar ao Carrinho')); ?>"
                                                               aria-label="<?php echo $block->escapeHtml(__('Adicionar ao Carrinho') . ': ' . $_item->getName()); ?>"
						                              class="btn-add-to-cart action tocart">
						                            <span><?php echo $block->escapeHtml(__('Adicionar ao Carrinho')); ?></span>
						                          </button>
						                        </form>
						                      <?php else: ?>
						                        <?php if ($_item->getIsSalable()): ?>
						                          <div class="stock available"><span><?php echo $block->escapeHtml(__('Em estoque')) ?></span></div>
						                        <?php else: ?>
						                          <div class="stock unavailable"><span><?php echo $block->escapeHtml(__('Esgotado')) ?></span></div>
						                        <?php endif; ?>
						                      <?php endif; ?>
						                    </div>
			  							<?php endif; ?>
		  							</div>
								</div>
							</div>
						</div>
						 <?php if($i%$rows==0 || $i == count($productItems)) { ?> </div> <?php }?>
					<?php
					$productTabImgIdx++;
					}
					?>
				</div>
			 </div>
			<?php
			}
			?>
		</div>
	</div>
</div>
<?php
$productTabMageInit = [
	'.producttab-<?php echo $scopeSuffix; ?>' => [
		'js/tab-carousel-init' => [
			'tabsSelector' => 'ul.tabs li',
			'contentSelector' => '.tab_content',
			'carouselSelector' => '.productTabContent',
		],
	],
];
?>
<script type="text/x-magento-init">
<?= /* @noEscape */ json_encode($productTabMageInit, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) ?>
</script>
