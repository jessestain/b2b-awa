<?php
declare(strict_types=1);

/**
 * Override: GA4 adiado para interação na home (não compete com LCP/TBT).
 * Nas demais páginas mantém o comportamento original inline.
 *
 * @var \Magento\GoogleGtag\Block\Ga $block
 * @var \Magento\Framework\Escaper $escaper
 */

$analyticsData = $block->getAnalyticsData();
if (!$analyticsData) {
    return;
}

$layoutHandles = $block->getLayout()->getUpdate()->getHandles();
$isHomePage = in_array('cms_index_index', $layoutHandles, true);
?>
<script type="application/json" id="awa-ga4-defer-json"><?= /* @noEscape */ $analyticsData ?></script>
<script>
(function (w, d) {
    'use strict';
    var applied = false;

    function allowsMarketing() {
        try {
            if (w.localStorage && w.localStorage.getItem('awa_cookie_consent') === 'all') {
                return true;
            }
            if (w.localStorage && w.localStorage.getItem('awa_cookie_consent') === 'essential') {
                return false;
            }
        } catch (e) {}
        return /(?:^|;\s*)awa_cookies_accepted=all(?:;|$)/.test(d.cookie || '');
    }

    function boot() {
        var el, cfg;
        if (applied || !allowsMarketing()) { return; }
        if (typeof w.require !== 'function') {
            w.setTimeout(boot, 200);
            return;
        }
        applied = true;
        el = d.getElementById('awa-ga4-defer-json');
        if (!el || !el.textContent) { return; }
        try { cfg = JSON.parse(el.textContent); } catch (e) { return; }
        /* task-65: o bloco `text/x-magento-init` NUNCA era aplicado — `mage/apply/main`
           ja esta inicializado quando este codigo roda, entao re-requere-lo nao varre o
           DOM de novo e o config ficava orfao (GA4 nao subia). Chamamos o modulo direto. */
        w.require(['Magento_GoogleGtag/js/google-analytics'], function (ga) {
            if (typeof ga === 'function') { ga(cfg); }
        });
    }

    function schedule() {
        if (!allowsMarketing()) { return; }
        <?php if ($isHomePage): ?>
        if ('requestIdleCallback' in w) {
            w.requestIdleCallback(boot, { timeout: 3500 });
        } else {
            w.setTimeout(boot, 1500);
        }
        <?php else: ?>
        if ('requestIdleCallback' in w) {
            w.requestIdleCallback(boot, { timeout: 2000 });
        } else {
            w.setTimeout(boot, 800);
        }
        <?php endif; ?>
    }

    if (allowsMarketing()) {
        schedule();
    } else {
        w.addEventListener('awa:cookie-consent', function (ev) {
            if (ev && ev.detail && ev.detail.value === 'all') {
                schedule();
            }
        });
    }
})(window, document);
</script>
