	return trim((string)$cmsBlock->toHtml());
};
$normalizeHtmlSuffixUrl = static function (string $url): string {
        return preg_replace('/\.html\/(?=($|[?#]))/i', '.html', $url) ?? $url;
};

$directUrl = static function (string $path) use ($block, $normalizeHtmlSuffixUrl): string {
        $url = $block->getUrl('', ['_direct' => ltrim($path, '/'), '_nosid' => true]);

        return $normalizeHtmlSuffixUrl($url);
};

$cmsPageUrl = static function (string $path) use ($block): string {
