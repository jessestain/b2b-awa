$buildCarouselImage = function (string $asset, string $alt, int $idx = 0) use ($carouselIconSize, $block): string {
	$webpAsset = str_replace('.png', '.webp', $asset);
	// Sprint perf (2026-06-28): eager APENAS na 1a imagem (LCP). Demais lazy.
	$loadingAttr = ($idx === 0) ? 'eager' : 'lazy';
        // O nome e a quantidade da categoria ja estao no mesmo link.
        // A imagem e decorativa para evitar nomes acessiveis duplicados.
        return '<picture>'
		. '<source srcset="'
		. $block->escapeUrl($block->getViewFileUrl('images/category-carousel/' . $webpAsset))
		. '" type="image/webp" />'
		. '<img src="'
		. $block->escapeUrl($block->getViewFileUrl('images/category-carousel/' . $asset))
        . '" alt="" class="awa-loaded" loading="' . $loadingAttr . '" decoding="async" width="'
		. $carouselIconSize
		. '" height="'
		. $carouselIconSize
                . '" />'
                . '</picture>';
};

