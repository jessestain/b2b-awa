<?php
declare(strict_types=1);

/**
 * AWA B2B — Custom 404 Page
 * Página 404 com branding B2B, busca e links úteis.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

$directUrl = static fn (string $path): string => $block->getUrl('', ['_direct' => ltrim($path, '/')]);
?>
<div class="awa-404-page">
    <div class="awa-404-page__content">
        <div class="awa-404-page__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
                <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
        </div>
        <h1 class="awa-404-page__title awa-404-title"><?= $block->escapeHtml(__('Página não encontrada')) ?></h1>
        <p class="awa-404-page__text">
            <?= $block->escapeHtml(__('O endereço que você acessou não existe ou foi movido.')) ?><br>
            <?= $block->escapeHtml(__('Verifique a URL ou use a busca no topo da página.')) ?>
        </p>
        <script>
        (function () {
            'use strict';
            var currentPath = (window.location.pathname || '').replace(/\/+$/, '') || '/';
            if (currentPath !== '/ofertas.html') {
                return;
            }
            window.location.replace('<?= $block->escapeJs($directUrl('super-ofertas.html')) ?>');
        }());
        </script>
        <nav class="awa-404-page__links" aria-label="<?= $block->escapeHtmlAttr(__('Links úteis')) ?>">
            <a href="<?= $block->escapeUrl($block->getUrl('')) ?>"><?= $block->escapeHtml(__('Ir para o início')) ?></a>
            <a href="<?= $block->escapeUrl($directUrl('bauletos.html')) ?>"><?= $block->escapeHtml(__('Bauletos')) ?></a>
            <a href="<?= $block->escapeUrl($directUrl('guidoes.html')) ?>"><?= $block->escapeHtml(__('Guidões')) ?></a>
            <a href="<?= $block->escapeUrl($directUrl('retrovisores.html')) ?>"><?= $block->escapeHtml(__('Retrovisores')) ?></a>
            <a href="<?= $block->escapeUrl($block->getUrl('contact')) ?>"><?= $block->escapeHtml(__('Fale Conosco')) ?></a>
        </nav>
    </div>
</div>
