<?xml version="1.0"?>
<!--
    AWA Motos — CMS pages (About, FAQ, Terms, políticas, atacado, etc.)
    SSOT shell: awa-cms-shell-final.css (container 1280px, prose 800px, spacing 4–16px)
    Final-wins sobre awa-institutional.css carregado pelo tema pai.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- AWA vfix: CMS B2B landing (seletor escopado por body.cms-seja-cliente-b2b) -->
        <css src="css/awa-vfix-cms-b2b.css"/>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.cms.shell.final"
                   template="Magento_Theme::html/awa-cms-shell-final-loader.phtml"
                   after="-"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.align.grid.terminal.cms"
                   template="Magento_Theme::html/awa-align-grid-terminal-loader.phtml"
                   after="awa.cms.shell.final"/>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.cms.contact.canonical.redirect"
                   template="Magento_Cms::contact-canonical-redirect-v2.phtml"/>
        </referenceContainer>
    </body>
</page>
