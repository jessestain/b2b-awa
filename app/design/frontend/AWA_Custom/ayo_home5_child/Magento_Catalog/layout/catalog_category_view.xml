<?xml version="1.0"?>
<!--
  AWA Motos — Category Page Layout Overrides
  - Remove duplicate H1 (page.main.title) since category hero already has H1
  - PLP-P0-005/006 (docs/visual-qa/VISUAL_FIX_PLAN.md): remove sale.reorder.sidebar —
    mesmo padrao ja aplicado na Home (Magento_Cms/layout/cms_index_index.xml). O widget
    nativo "Pedidos feitos recentemente" nao pertence a PLP: aparecia vazio para guest e,
    para cliente logado com pedidos, exibia CTAs "Adicionar ao carrinho" duplicados/soltos
    na sidebar.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="css/awa-plp-final-polish.css"/>
        <remove src="css/awa-visual-qa-category.css"/>
        <!--
            Fase 6 fatia 2 (2026-08-18) — paridade catalogStrip* ↔ PageConfig.
            Espelha CatalogPlpCssParity::LAYOUT_REMOVE_SRCS (exceto gallery.css,
            já em Magento_Theme/layout/catalog_category_view.xml).
            OptimizeHeadStylesPlugin continua safety-net; não apagar regex.
            Refine standalone não entra na PLP: regras estão no LESS/styles-l.
        -->
        <remove src="css/awa-impeccable-audit-2026-05-28.min.css"/>
        <remove src="css/awa-impeccable-audit-2026-05-28.css"/>
        <remove src="css/awa-commerce-impeccable-refine.min.css"/>
        <remove src="css/awa-ui-simplify-terminal.min.css"/>
        <remove src="css/awa-head-tail-bundle.min.css"/>
        <remove src="css/awa-bundle-async-distill-lock.min.css"/>
        <remove src="css/awa-plp-distill.min.css"/>
        <remove src="css/awa-plp-distill.css"/>
        <!-- AWA vfix scope: PLP/category only -->
        <css src="css/awa-vfix-plp-search.css"/>
        <!-- Reabilitado: arquivo existe em pub/static; trava altura #mst_categorySearch em 44px. -->
        <css src="css/awa-plp-shell-final.css"/>
    </head>
    <body>
        <attribute name="class" value="awa-plp-page-contract"/>
        <referenceBlock name="awa.header.impeccable.critical.global" remove="true"/>
        <!-- Performance: stack PLP dedicado (plp-promax + §89/91/93) — omitir audit global -->
        <referenceBlock name="awa.head.preload">
            <arguments>
                <argument name="awa_skip_audit_bundle" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="awa.impeccable.audit.uncached.global.v10" remove="true"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
        <referenceBlock name="awa.shelf.carousel" remove="true"/>
        <referenceBlock name="category.image">
            <arguments>
                <argument name="visible_product_count_view_model" xsi:type="object">GrupoAwamotos\Theme\ViewModel\CategoryVisibleProductCount</argument>
            </arguments>
        </referenceBlock>
        <!-- Trilho vazio sob o menu (ul 1280×23). Crumbs vão para o hero, junto do H1. -->
        <move element="breadcrumbs" destination="category.image"/>
        <referenceBlock name="category.products.list">
            <arguments>
                <argument name="bestseller_card_view_model" xsi:type="object">GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel</argument>
                <argument name="product_labels" xsi:type="object">GrupoAwamotos\Theme\ViewModel\ProductLabels</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="catalog.leftnav">
            <arguments>
                <argument name="layered_nav" xsi:type="object">GrupoAwamotos\Theme\ViewModel\LayeredNav</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="catalog.navigation.renderer">
            <arguments>
                <argument name="layered_nav" xsi:type="object">GrupoAwamotos\Theme\ViewModel\LayeredNav</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="awa.custom.global.js.loader">
            <arguments>
                <argument name="load_search_compat_js" xsi:type="boolean">true</argument>
                <argument name="load_home_category_compat_js" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>

        <!-- AWA - PLP extras: FAB filtros removido (audit #19); suggestions mantidas -->
        <referenceBlock name="awa.plp.filter.button" remove="true"/>
        <referenceContainer name="main.content">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.plp.suggestions"
                   template="Magento_Catalog::product/awa-plp-suggestions.phtml"
                   after="category.products.list"/>
        </referenceContainer>

        <!--
            ACHADO SEO-001: o JSON-LD ItemList da PLP (GrupoAwamotos\\SchemaOrg\\Block\\CategoryItemList)
            monta offers.price sem consultar o gate B2B. Passamos o gate por argumento de layout
            (sem construtor novo => sem setup:di:compile) para o bloco parar de publicar preço.
        -->
        <referenceBlock name="grupoawamotos.schema.category.itemlist">
            <arguments>
                <argument name="b2b_gate" xsi:type="object">GrupoAwamotos\B2B\ViewModel\PdpGate</argument>
            </arguments>
        </referenceBlock>

    </body>
</page>
