<?php
/**
 * AWA override: adiciona <label> para o <select> de ordenação.
 * Fase 3.10 — WCAG 1.3.1 / 4.1.2: controle de formulário deve ter label associado.
 *
 * @var $block \Magento\Catalog\Block\Product\ProductList\Toolbar
 */
declare(strict_types=1);

$availableOrders = $block->getAvailableOrders();
$selectedOrder = null;

foreach (array_keys($availableOrders) as $orderKey) {
    if ($block->isOrderCurrent($orderKey)) {
        $selectedOrder = (string) $orderKey;
        break;
    }
}

/*
 * Magento already sorts a search collection by relevance when no explicit
 * order was requested. Some Mirasvit responses do not expose that default to
 * isOrderCurrent(), leaving the browser to select the first option (name).
 * Keep the control aligned with the collection without overriding a choice
 * explicitly made by the visitor.
 */
if (
    $selectedOrder === null
    && $block->getRequest()->getFullActionName() === 'catalogsearch_result_index'
    && isset($availableOrders['relevance'])
) {
    $selectedOrder = 'relevance';
}
?>
<div class="toolbar-sorter sorter">
    <label for="sorter" class="sorter-label"><?= $block->escapeHtml(__('Ordenar por:')) ?></label>
    <select id="sorter" data-role="sorter" class="sorter-options">
        <?php foreach ($availableOrders as $_key => $_order): ?>
            <option value="<?= $block->escapeHtmlAttr((string) $_key) ?>"
                <?php if ((string) $_key === $selectedOrder): ?>
                    selected="selected"
                <?php endif; ?>>
                <?= $block->escapeHtml(__($_order)) ?>
            </option>
        <?php endforeach; ?>
    </select>
</div>
