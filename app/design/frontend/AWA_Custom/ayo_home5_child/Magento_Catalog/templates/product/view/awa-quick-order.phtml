<script>
(function (w, d) {
    'use strict';
    if (w.__awaQuickOrderInit) return;
    w.__awaQuickOrderInit = true;

    var form, rowsContainer, feedback, csvBox, counter = 1;

    function init() {
        form = d.querySelector('[data-awa-quick-order-form]');
        if (!form) return;

        rowsContainer = form.querySelector('[data-awa-quick-order-rows]');
        feedback = form.querySelector('[data-awa-quick-order-feedback]');
        csvBox = form.querySelector('[data-awa-quick-order-csv]');

        // Add row
        form.querySelector('[data-awa-quick-order-add-row]').addEventListener('click', addRow);
        // Remove rows (event delegation)
        rowsContainer.addEventListener('click', function (e) {
            var remove = e.target.closest('[data-awa-quick-order-remove]');
            if (remove) {
                var row = remove.closest('[data-awa-quick-order-row]');
                if (row) row.remove();
                updateCount();
            }
        });
        // CSV import
        form.querySelector('[data-awa-quick-order-import]').addEventListener('click', function () {
            csvBox.hidden = false;
        });
        form.querySelector('[data-awa-quick-order-csv-import]').addEventListener('click', importCsv);
        // SKU autocomplete
        rowsContainer.addEventListener('input', handleSkuInput);
    }

    function addRow() {
        counter++;
        var row = d.createElement('div');
        row.className = 'awa-quick-order__row';
        row.setAttribute('role', 'listitem');
        row.setAttribute('data-awa-quick-order-row', '');
        row.innerHTML =
            '<div class="awa-quick-order__field awa-quick-order__field--sku">' +
            '<label for="awa-quick-order-sku-' + counter + '" class="awa-sr-only">SKU</label>' +
            '<input type="text" name="items[' + counter + '][sku]" id="awa-quick-order-sku-' + counter + '" class="awa-quick-order__input" placeholder="SKU ou codigo" autocomplete="off" inputmode="text" data-awa-quick-order-sku aria-label="SKU do produto linha ' + counter + '">' +
            '</div>' +
            '<div class="awa-quick-order__field awa-quick-order__field--qty">' +
            '<label for="awa-quick-order-qty-' + counter + '" class="awa-sr-only">Quantidade</label>' +
            '<input type="number" name="items[' + counter + '][qty]" id="awa-quick-order-qty-' + counter + '" class="awa-quick-order__input" min="1" value="1" inputmode="numeric" data-awa-quick-order-qty aria-label="Quantidade linha ' + counter + '">' +
            '</div>' +
            '<div class="awa-quick-order__field awa-quick-order__field--remove">' +
            '<button type="button" class="awa-quick-order__remove" data-awa-quick-order-remove aria-label="Remover linha ' + counter + '">' +
            '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>' +
            '</button></div>';
        rowsContainer.appendChild(row);
        // Focus no novo input
        var skuInput = row.querySelector('[data-awa-quick-order-sku]');
        if (skuInput) skuInput.focus();
    }

    function updateCount() {
        var rows = rowsContainer.querySelectorAll('[data-awa-quick-order-row]');
        // Atualizar labels aria
        rows.forEach(function (row, i) {
            var n = i + 1;
            var skuInput = row.querySelector('[data-awa-quick-order-sku]');
            var qtyInput = row.querySelector('[data-awa-quick-order-qty]');
            if (skuInput) skuInput.setAttribute('aria-label', 'SKU do produto linha ' + n);
            if (qtyInput) qtyInput.setAttribute('aria-label', 'Quantidade linha ' + n);
        });
    }

    function importCsv() {
        var text = form.querySelector('[data-awa-quick-order-csv-input]').value.trim();
        if (!text) {
            showFeedback('Por favor, cole sua lista de SKUs.', 'error');
            return;
        }
        var lines = text.split(/[\r\n]+/);
        var firstRow = rowsContainer.querySelector('[data-awa-quick-order-row]');
        var firstSku = firstRow.querySelector('[data-awa-quick-order-sku]');
        var firstQty = firstRow.querySelector('[data-awa-quick-order-qty]');
        var imported = 0;
        lines.forEach(function (line) {
            var parts = line.split(/[,;\t]/).map(function (p) { return p.trim(); });
            if (parts.length < 2) return;
            var sku = parts[0];
            var qty = parts[1];
            if (!sku || !qty) return;
            var target = imported === 0 ? firstRow : null;
            if (!target) {
                addRow();
                var rows = rowsContainer.querySelectorAll('[data-awa-quick-order-row]');
                target = rows[rows.length - 1];
            }
            target.querySelector('[data-awa-quick-order-sku]').value = sku;
            target.querySelector('[data-awa-quick-order-qty]').value = qty;
            imported++;
        });
        if (imported > 0) {
            showFeedback(imported + ' produto(s) importado(s) com sucesso!', 'success');
            csvBox.hidden = true;
        } else {
            showFeedback('Nenhum SKU valido encontrado.', 'error');
        }
    }

    function handleSkuInput(e) {
        if (!e.target.matches('[data-awa-quick-order-sku]')) return;
        // Futuramente: autocomplete via AJAX para /awamotos_quickorder/search/sku
    }

    function showFeedback(msg, type) {
        if (!feedback) return;
        feedback.textContent = msg;
        feedback.className = 'awa-quick-order__feedback awa-quick-order__feedback--' + (type || 'info');
        setTimeout(function () {
            if (feedback.textContent === msg) feedback.textContent = '';
            feedback.className = 'awa-quick-order__feedback';
        }, 5000);
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
        init();
    }
})(window, document);
</script>

