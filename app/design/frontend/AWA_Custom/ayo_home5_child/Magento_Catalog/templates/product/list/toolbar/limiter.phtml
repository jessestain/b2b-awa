<?php
/**
 * AWA override — limiter com rótulo acessível.
 * O label permanece visualmente oculto no desktop e é exibido no mobile,
 * onde o controle volta a fazer parte da toolbar (auditoria UX).
 * O display inline neutraliza apenas os locks legados com !important;
 * dimensões e composição responsiva continuam na folha PLP.
 *
 * @var \Magento\Catalog\Block\Product\ProductList\Toolbar $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div class="field limiter" style="display: flex !important;">
    <label class="label limiter-label" for="limiter">
        <span><?= $escaper->escapeHtml(__('Itens por página')) ?></span>
    </label>
    <div class="control">
        <select id="limiter"
                data-role="limiter"
                class="limiter-options"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Itens por página')) ?>">
            <?php foreach ($block->getAvailableLimit() as $_key => $_limit): ?>
                <option value="<?= $escaper->escapeHtmlAttr($_key) ?>"
                    <?php if ($block->isLimitCurrent($_key)): ?> selected="selected"<?php endif ?>>
                    <?= $escaper->escapeHtml($_limit) ?>
                </option>
            <?php endforeach; ?>
        </select>
    </div>
</div>
