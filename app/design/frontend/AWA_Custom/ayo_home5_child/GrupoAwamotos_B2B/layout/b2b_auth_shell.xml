<?xml version="1.0"?>
<!--
    AWA B2B auth shell — performance + a11y (login, forgot, claim, register).
    Header/footer e bundles globais omitidos do DOM; CSS crítico cobre o shell auth.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
        <remove src="css/print.css"/>
        <!-- BUG-CSS-AUTHORITY-011 (2026-07-04): awa-visual-fixes-2026-06-29-final.css é
             adicionado incondicionalmente em default_head_blocks.xml (todas as rotas);
             seletores são 100% PLP/carrossel/galeria de produto, inexistentes neste shell. -->
        <remove src="css/awa-visual-fixes-2026-06-29-final.css"/>
        <!-- Auth empty-layout: tokens já no crítico inline; 186KB síncrono só atrasa LCP. -->
        <remove src="css/awa-design-system.css"/>
        <remove src="GrupoAwamotos_AiAssistant::css/ai-assistant.css"/>
        <!-- Fase 6 fatia 5 — authStrip restante; manter awa-b2b-auth-shell-final.css. -->
        <remove src="css/awa-ui-promax-bundle.min.css"/>
        <remove src="css/awa-commerce-impeccable-refine.min.css"/>
        <remove src="css/awa-structural-fix-2026-05-20.min.css"/>
        <remove src="css/awa-impeccable-layout-2026-06-16.min.css"/>
        <remove src="css/awa-plp-final-polish.css"/>
        <remove src="css/awa-ui-ux-pro-max-header-2026-05-19.min.css"/>
        <remove src="css/custom_default.css"/>
        <remove src="css/styles-m.css"/>
        <remove src="css/styles-l.css"/>
        <css src="css/awa-b2b-auth-shell-final.css" order="10000"/>
        <css src="css/awa-cnpj-autofill.css" order="10001"/>
        <css src="css/awa-ux-b2b-auth-polish-20260804.css" order="10010"/>
        <!-- AWA vfix scope: B2B auth shell only -->
        <css src="css/awa-vfix-b2b-auth.css"/>
        <!-- CTA lock: filename novo vence cache immutable de login.min.css -->
        <css src="GrupoAwamotos_B2B::css/account/cta-lock-20260815.css" order="10020"/>
    </head>
    <body>
        <attribute name="class" value="awa-b2b-auth-page-contract"/>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.b2b.auth.critical.css"
                   template="GrupoAwamotos_B2B::html/awa-b2b-auth-critical-css.phtml"
                   before="-"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.b2b.auth.seo"
                   template="GrupoAwamotos_B2B::html/awa-b2b-auth-seo.phtml"
                   after="awa.b2b.auth.critical.css"/>
        </referenceBlock>

        <!-- Auth usa b2b-login-messages no card; page.messages global (columns.top) só gera gap vazio. -->
        <referenceContainer name="page.messages" remove="true"/>
        <referenceBlock name="add_custom_theme_head" remove="true"/>
        <referenceBlock name="authentication-popup" remove="true"/>
        <referenceBlock name="toki_header" remove="true"/>
        <referenceBlock name="toki_footer" remove="true"/>
        <referenceBlock name="grupoawamotos.menu.bootstrap" remove="true"/>
        <referenceBlock name="awa.nav.quick.links" remove="true"/>
        <referenceBlock name="awa.cls.nav.fix" remove="true"/>
        <referenceBlock name="awa.critical.inline.css" remove="true"/>
        <referenceBlock name="awa.deferred.interaction.css" remove="true"/>
        <referenceBlock name="awa.deferred.cosmetic.css" remove="true"/>
        <referenceBlock name="awa.styles.l.last" remove="true"/>
        <referenceBlock name="awa.search.autocomplete.head.css" remove="true"/>
        <referenceBlock name="awa.search.autocomplete.body.css" remove="true"/>
        <referenceBlock name="awa.mobile.nav" remove="true"/>
        <!-- Auth shell: PWA modal e overlays de marketing não fazem parte do fluxo de cadastro/login. -->
        <referenceBlock name="awa.pwa.install" remove="true"/>
        <referenceBlock name="awa.push.notifications" remove="true"/>
        <referenceBlock name="awa.dark.mode.toggle" remove="true"/>
        <referenceBlock name="awa.ab.testing" remove="true"/>
        <referenceBlock name="awa.audit.bundle.css" remove="true"/>
        <referenceBlock name="awa.header.impeccable.critical.global" remove="true"/>
        <referenceBlock name="awa.impeccable.audit.uncached.global.v10" remove="true"/>
        <referenceBlock name="awa.impeccable.loopback.guard.global" remove="true"/>
        <referenceBlock name="awa.shelf.carousel" remove="true"/>
        <!-- r4d: auth pages — Magento_Ui storage/pageCache/messages KO not needed -->
        <referenceBlock name="frontend-storage-manager" remove="true"/>
        <referenceBlock name="customer.data.invalidation.rules" remove="true"/>
        <referenceBlock name="pageCache" remove="true"/>
        <referenceBlock name="messages" remove="true"/>
        <referenceBlock name="ajax.message.placeholder" remove="true"/>
        <referenceBlock name="awa.back.to.top" remove="true"/>
        <referenceBlock name="awa.a11y.product.links" remove="true"/>
        <referenceBlock name="awa.a11y.nav.links" remove="true"/>
        <referenceBlock name="awa.card.enhance" remove="true"/>
        <referenceBlock name="grupoawamotos_whatsapp_btn" remove="true"/>
        <referenceBlock name="grupoawamotos.ai.chat.widget" remove="true"/>
        <referenceBlock name="meta.pixel.idle" remove="true"/>
        <referenceBlock name="pagebuilder.widget.initializer" remove="true"/>
        <referenceBlock name="customer.customer.data" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
        <referenceBlock name="awa.og.meta" remove="true"/>
        <referenceBlock name="autocomplete.injection.js" remove="true"/>
        <referenceBlock name="autocomplete.injection.template" remove="true"/>
        <referenceBlock name="quickview" remove="true"/>
        <referenceBlock name="ajaxWishlistJs" remove="true"/>
        <referenceBlock name="ajaxsuite.popup.wrapper" remove="true"/>
        <referenceBlock name="grupoawamotos.schema.organization" remove="true"/>
        <referenceBlock name="awa.cookie.consent.fix.css" remove="true"/>
        <referenceBlock name="awa.cookie.consent.defer.loader" remove="true"/>
        <referenceBlock name="awa.custom.global.js.loader" remove="true"/>
        <referenceBlock name="newsletter_popup" remove="true"/>

        <!-- BUG-CSS-AUTHORITY-011 (2026-07-04): 3 blocos adicionados a default.xml/tema pai
             depois desta lista ter sido escrita, nunca incluídos aqui. Todos escopados a
             header/nav/PLP (.awa-site-header, #header, .products-grid) — inexistentes neste
             shell, já que toki_header/toki_footer são removidos acima. Ver
             var/fase-b-css-authority/relatorio.md. -->
        <!-- app/design/frontend/ayo/ayo_home5/Rokanthemes_Themeoption/layout/default.xml (tema pai):
             4 dos 6 links desse bloco (round9/round10/components-b2b-foundation/compat-b2b-nav)
             já nem têm arquivo-fonte no tema filho — servidos de cache órfã em pub/static. -->
        <referenceBlock name="awa.post.themeoption.css" remove="true"/>
        <referenceBlock name="awa.header.mobile.grid.critical.global" remove="true"/>
        <referenceBlock name="awa.visual.qa.fixes.css" remove="true"/>

        <!-- tabindex=-1 em #maincontent: awa-b2b-auth-critical-css.phtml (layout <attribute> inválido no XSD 2.4) -->
    </body>
</page>
