<?xml version="1.0"?>
<!--
    AWA B2B Register — Layout Override
    Handle: b2b_register_index  (rota: /b2b/register/index/)

    SSOT 2026-08-10: shell auth + CNPJ autofill vivem apenas em b2b_auth_shell.xml
    (update handle do módulo). Não redeclarar aqui para evitar dupla autoridade CSS.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="empty"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <meta name="description"
              content="Cadastre sua empresa no portal B2B da AWA Motos. Acesso a preços de atacado, crédito e cotações para revendas de peças para motos."/>
        <css src="css/awa-ai-assistant-auth.css" order="10050"/>
    </head>
    <body>
        <referenceBlock name="awa.minicart.open.terminal" remove="true"/>
        <!-- Captcha anti-bot no cadastro B2B (2026-10-05): o form e custom, entao o
             observer nativo nao valida; o Save.php valida explicitamente via CaptchaStringResolver. -->
        <referenceBlock name="b2b.register.form">
            <block class="Magento\Captcha\Block\Captcha"
                   name="b2b.register.captcha"
                   as="captcha"
                   cacheable="false">
                <action method="setFormId">
                    <argument name="formId" xsi:type="string">user_create</argument>
                </action>
                <action method="setImgWidth">
                    <argument name="width" xsi:type="string">230</argument>
                </action>
                <action method="setImgHeight">
                    <argument name="height" xsi:type="string">50</argument>
                </action>
            </block>
        </referenceBlock>
        <!-- r4d: light auth — storage/pageCache/home widgets; keep AI coach for register -->
        <referenceBlock name="frontend-storage-manager" remove="true"/>
        <referenceBlock name="customer.data.invalidation.rules" remove="true"/>
        <referenceBlock name="pageCache" remove="true"/>
        <referenceBlock name="pagebuilder.widget.initializer" remove="true"/>
        <referenceBlock name="awa.shelf.carousel" remove="true"/>
        <!-- Coach de cadastro: o shell auth remove o FAB global; restaura só nesta rota. -->
        <referenceBlock name="grupoawamotos.ai.chat.widget" remove="false"/>
    </body>
</page>
