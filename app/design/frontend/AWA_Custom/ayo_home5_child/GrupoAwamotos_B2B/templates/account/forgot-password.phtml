    <?= $block->getChildHtml('auth_logo') ?>

    <div class="b2b-login-card">
        <header class="b2b-auth-card-head">
            <h1 id="b2b-forgot-heading" class="b2b-login-title"><?= $escaper->escapeHtml(__('Recuperar senha')) ?></h1>
            <p class="b2b-login-subtitle">
                <?= $escaper->escapeHtml(__('Informe o e-mail cadastrado na sua conta empresarial.')) ?>
            </p>
        </header>

        <div class="b2b-login-messages" role="status" aria-live="polite" aria-atomic="true">
            <?= $block->getChildHtml('b2b_forgot_messages') ?>
        </div>

        <form class="b2b-login-form"
              action="<?= $escaper->escapeUrl($block->getPostActionUrl()) ?>"
              method="post"
              id="b2b-forgot-form"
              novalidate
              data-mage-init='{"validation":{}}'>
            <?= $block->getBlockHtml('formkey') ?>

            <div class="b2b-field">
                <label class="b2b-field-label" for="b2b-forgot-email"><?= $escaper->escapeHtml(__('E-mail cadastrado')) ?></label>
                <input type="email"
                       name="email"
                       id="b2b-forgot-email"
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck="false"
                       inputmode="email"
                       required
                       aria-required="true"
                       data-validate="{required:true, 'validate-email':true}"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('E-mail cadastrado')) ?>"
                       aria-describedby="b2b-forgot-email-note" />
                <p id="b2b-forgot-email-note" class="b2b-field-note">
                    <?= $escaper->escapeHtml(__('Enviaremos um link de recuperação para este e-mail.')) ?>
                </p>
            </div>

            <?php
            $b2bCaptchaHtml = $block->getChildHtml('captcha');
            $captchaInputId = 'captcha_user_forgotpassword';
            $captchaNoteId = 'b2b-forgot-captcha-note';
            $captchaInputMarker = 'id="' . $captchaInputId . '"';
            $captchaInputReplacement = $captchaInputMarker
                . ' required aria-describedby="' . $captchaNoteId . '"';
            $b2bCaptchaHtml = str_replace(
                $captchaInputMarker,
                $captchaInputReplacement,
                (string) $b2bCaptchaHtml
            );
            ?>
            <?php if (trim((string)$b2bCaptchaHtml) !== ''): ?>
            <div class="b2b-field b2b-field-captcha">
                <?= $b2bCaptchaHtml ?>
                <p id="<?= $escaper->escapeHtmlAttr($captchaNoteId) ?>" class="b2b-field-note">
                    <?= $escaper->escapeHtml(__('Digite os caracteres exibidos na imagem. Se estiverem difíceis de ler, recarregue o código.')) ?>
                </p>
                <a href="<?= $escaper->escapeUrl($block->getUrl('b2b/account/claim')) ?>"
                   class="b2b-btn-claim b2b-captcha-alternative">
                    <?= $escaper->escapeHtml(__('Não consigo usar o código — recuperar com e-mail ou CNPJ')) ?>
                </a>
            </div>
            <?php endif; ?>

            <div class="b2b-login-actions">
                <button type="submit" class="b2b-btn-entrar">
                    <span><?= $escaper->escapeHtml(__('Enviar link de recuperação')) ?></span>
                </button>
            </div>
        </form>

        <div class="b2b-login-divider" role="separator" aria-hidden="true">
