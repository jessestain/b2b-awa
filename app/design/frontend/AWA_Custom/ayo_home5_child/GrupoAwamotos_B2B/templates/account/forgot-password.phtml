                <?= $escaper->escapeHtml(__('Voltar para entrar')) ?>
            </a>

            <a href="<?= $escaper->escapeUrl($block->getRegisterUrl()) ?>" class="b2b-btn-claim">
                <?= $escaper->escapeHtml(__('Criar conta B2B')) ?>
            </a>
        </nav>
