<?php
declare(strict_types=1);

/**
 * Logo compacto — shell auth B2B.
 *
 * @var \GrupoAwamotos\B2B\Block\Account\AuthLogo $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div class="b2b-login-logo b2b-login-logo--compact">
    <a class="awa-auth-lockup"
       href="<?= $escaper->escapeUrl($block->getHomeUrl()) ?>"
       aria-label="<?= $escaper->escapeHtmlAttr(__('Ir para a página inicial da AWA Motos — MOTO COMPONENTES')) ?>">
