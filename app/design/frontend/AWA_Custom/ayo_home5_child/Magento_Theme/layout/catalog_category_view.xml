<?xml version="1.0"?>
<!--
    AWA Motos — Catalog Category (PLP) Layout Overrides — Magento_Theme scope.
    Remove CSS exclusivo da homepage para evitar conflitos no catálogo.
    FASE 6B: CSS page-specific via layout XML nativo (BUG-01).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- CSS de grid/densidade exclusivos da home — não carregar no catálogo -->
        <remove src="css/awa-home-corporate-density-grid-2026-06.css"/>
        <remove src="css/awa-home-density-grid-20260611.min.css"/>
        <!-- CSS de shell da home removido no catálogo; stack PLP é aplicado por bundles/critical ativos. -->
        <remove src="css/awa-home-shell-final.css"/>
        <!-- Fotorama/PDP only — na PLP o CSS bloqueava o 1º paint (~5KB, 150ms no Lighthouse).
             Fase 6 fatia 2: faz parte de CatalogPlpCssParity::LAYOUT_REMOVE_SRCS. -->
        <remove src="mage/gallery/gallery.css"/>
        <!-- Checkout-only: seletores body.checkout-* — parse morto na PLP (~32KB). -->
        <remove src="css/awa-page-b2b-cart-checkout-premium.css"/>
    </head>
    <body>
        <!-- PLP é grade, não vitrine carousel — loader global em default.xml. -->
        <referenceBlock name="awa.shelf.carousel" remove="true"/>
    </body>
</page>
