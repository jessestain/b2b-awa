<?xml version="1.0"?>
<!--
    AWA Motos — Magento_Theme/layout/default_head_blocks.xml
    Assets adicionados ao <head> em todas as páginas do child theme.

    O CSS principal vem do pipeline LESS via _extend.less (não precisa de
    declaração aqui). Este arquivo cobre:
      - Open Graph + Twitter Card meta tags (SEO social)
      - Fallback para JS build runtime
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!--
            Viewport: sobrescreve o meta do tema pai adicionando viewport-fit=cover.
            Necessário para que env(safe-area-inset-*) funcione corretamente em iPhones
            com notch/Dynamic Island. Magento deduplica meta por nome.
        -->
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
        <!--
            Grid unificado legado removido: o source of truth atual é o pipeline
            LESS (_grid-system.less + bundles AWA). Manter este CSS causa conflito
            de layout na PDP.
        -->
        <!--
            Bootstrap v3 + icon fonts (font-awesome, icomoon, simple-line-icons, owl)
            Removidos do merged bundle bloqueante 2026-05-08.
            Recarregados de forma assíncrona via awa-head-preload.phtml.
            Critical Bootstrap grid (~2KB) já coberto pelo grid inline do awa-head-preload.phtml.
        -->
        <!--
            themes5.css (ayo_home5 parent) — removido do merged bundle 2026-05-09
            Carregado async via awa-head-preload.phtml.
        -->
        <remove src="css/themes5.css"/>
        <!--
            mage/calendar.css (jquery-ui datepicker) — removido do merged bundle 2026-05-09
            Carregado async via awa-head-preload.phtml. Só é utilizado em checkout/account.
        -->
        <remove src="mage/calendar.css"/>
        <!--
            GrupoAwamotos_CookieConsent — cookie banner LGPD, below-fold, seguro async.
            Removido do merged bundle 2026-05-09.
        -->
        <remove src="GrupoAwamotos_CookieConsent::css/cookie-consent.css"/>
        <!--
            Rokanthemes RokanBase: chosen.css + jquery.fancybox.css
            chosen: select enhancement (not above-fold)
            fancybox: lightbox (only on interaction)
            Ambos removidos do merged bundle 2026-05-09. Asyncados via awa-head-preload.phtml.
        -->
        <remove src="Rokanthemes_RokanBase::css/chosen.css"/>
        <remove src="Rokanthemes_RokanBase::css/jquery.fancybox.css"/>
        <!--
            Rokanthemes Themeoption: loader.css — loading spinner.
            Removido do merged bundle 2026-05-09.
        -->
        <remove src="Rokanthemes_Themeoption::css/loader.css"/>
        <!--
            Uppy file uploader CSS — from Magento_Catalog base layout. Not needed above fold.
            Removido do merged bundle 2026-05-09.
        -->
        <remove src="jquery/uppy/dist/uppy-custom.css"/>
        <!--
            Rokanthemes Brand widget CSS — brand list/grid. Not needed above fold.
            Removido do merged bundle 2026-05-09.
        -->
        <remove src="Rokanthemes_Brand::css/styles.css"/>
        <!--
            Rokanthemes QuickView CSS — modal overlay, non-critical above fold.
            Removido do merged bundle 2026-05-09.
        -->
        <remove src="Rokanthemes_QuickView::css/rokan_quickview.css"/>
        <remove src="css/bootstrap.css"/>
        <remove src="css/font-awesome.min.css"/>
        <remove src="css/icomoon.css"/>
        <remove src="css/simple-line-icons.css"/>
        <!-- owl.carousel.css removido: carrosséis AWA usam Swiper/scroll-snap, não Owl. -->
        <remove src="css/owl.carousel.css"/>

        <remove src="css/awa-grid-unified.css"/>

        <!-- CSS Consolidation 2026-04-26: 6 CSS do tema pai movidos para _extend.less via _awa-consolidated.less -->
        <remove src="css/awa-core.css"/>
        <remove src="css/awa-layout.css"/>
        <remove src="css/awa-components.css"/>
        <remove src="css/awa-consistency.css"/>
        <remove src="css/awa-consistency-ui.css"/>
        <remove src="css/awa-fixes.css"/>

        <!--
            themes.css: o merge herdado do tema pai (ayo_default) inclui <css src="css/themes.css"/>
            bloqueante. O child já carrega o mesmo ficheiro de forma assíncrona em
            awa-head-preload.phtml (preload + media=print onload). Sem este remove,
            o browser descarrega o mesmo URL duas vezes (blocking + async).
        -->
        <remove src="css/themes.css"/>

        <!--
            animation_theme.css (94KB) — CSS de animações puras, seguro para async.
            Carregado via awa-deferred-cosmetic-css.phtml (media=print + onload swap).
        -->
        <remove src="css/animation_theme.css"/>
        <!--
            styles-l.css — CSS de desktop (4.3MB). Removido do merged bundle 2026-05-08
            para que mobile (PSI/Lighthouse) NAO bloqueie neste CSS.
            Recarregado via awa-head-preload.phtml com media="screen and (min-width: 768px)".
        -->
        <remove src="css/styles-l.css"/>
        <!--
            styles-m.css — CSS principal Magento/Rokanthemes (5.1MB). Removido do merged
            bundle 2026-05-08 pois causava freeze no Chrome/Blink (PSI "página parou de
            responder"). Chrome resolve 17,503 regras CSS + 14,610 var() refs antes de
            pintar — bloqueia main thread por mais de 60s. Carregado via
            awa-head-preload.phtml com media="print" onload swap (async).
        -->
        <remove src="css/styles-m.css"/>

        <!--
            Google Fonts (Rubik) — redundante: Rubik já é self-hosted no tema AWA.
            Manter causa download duplo do woff2 (googleapis + self-hosted).
        -->
        <remove src="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&amp;display=swap"/>
        <!--
            Montserrat é a fonte base do tema — self-hosted pelo tema pai (ayo_home5).
            Não carregamos fonte externa aqui para evitar requisição extra ao Google Fonts.
            Meta tags de SEO/performance gerenciadas via
            Admin > Content > Design > Configuration (não duplicar aqui).
        -->
        <!--
            AWA Layout Override CSS (2026-05-04): movidos para awa-head-preload.phtml.
            Em XML estes CSSes carregavam ANTES do super-global (renderizado pelo
            head.additional PHTML), perdendo especificidade — o super-global os sobrescrevia.
            Agora carregam DEPOIS do super-global via PHTML, garantindo que "canonical" e
            "fixed" realmente ganhem (cascata correta). Ver awa-head-preload.phtml.
        -->
        <!--
            Patch CSS unificado (2026-06-29): corrige 17 bugs visuais/estruturais
            identificados na auditoria (home, PLP, PDP, busca, login, carrinho).
            - C1 Home mobile carousel overflow
            - C2 Home desktop bestseller overflow
            - C3 Hero mobile density
            - C4/M4 PLP/PDP card heights
            - C5 PLP breadcrumb spacing
            - M1 sections bg consistency
            - M2 PLP toolbar
            - M3 PDP gallery placeholder
            - M5 search empty state
            - M6 login B2B mobile
            - M7 cart empty state
            + 5 minor fixes (focus, a11y, z-index, button height)
            Carregado aqui (XML head) como último recurso. Os bundles AWA existentes
            já estão resolvidos via _extend.less/head.additional; este CSS patch
            carrega POR ÚLTIMO na cascata do head.
        -->
        <!--
            Visual Autopilot 2026-07-02 (causa raiz, não workaround): NÃO colocar
            query string (?v=...) diretamente no atributo `src` de <css>. O core
            do Magento resolve o content-type do asset via
            `strtolower(pathinfo($path, PATHINFO_EXTENSION))`
            (Magento\Framework\View\Asset\Source::getContentType) — com
            "arquivo.min.css?v=xxx" o pathinfo() retorna a extensão
            "css?v=xxx" (não "css"), então `Renderer::addDefaultAttributes()`
            nunca casa `$contentType === 'css'` e o atributo `rel="stylesheet"`
            é OMITIDO do <link> renderizado. Resultado: o navegador ignora o
            <link> inteiro (link sem rel não é reconhecido como stylesheet) e
            NENHUMA regra deste arquivo chega a aplicar — bug confirmado ao
            vivo via curl no HTML bruto, antes de qualquer plugin deste tema
            rodar. Isso já custou ciclos inteiros de debugging tentando migrar
            regras para outros arquivos; a causa real nunca era CSS/cascata.

            Cache-busting continua necessário (nginx serve pub/static com
            `cache-control: immutable` de 1 ano), mas agora é aplicado
            DEPOIS da resolução do asset pelo core, via
            GrupoAwamotos\Theme\Plugin\Response\OptimizeHeadStylesPlugin
            (pós-processamento do HTML já renderizado — não altera o `src`
            usado pelo Magento para resolver o asset, então não quebra o
            pathinfo()). Ver AWA_VISUAL_FIXES_QUERY em
            HeaderImpeccableCascadeLockCss.php.
        -->
        <css src="css/awa-visual-fixes-2026-06-29-final.css"/>
        <!--
            AWA 2026-07-16: tokens + superfícies do modo escuro (classe body.awa-dark-mode).
            Removido 2026-07-17: toggle awa.dark.mode.toggle já remove=true em default.xml —
            folha morta no critical path (prática Magento: não carregar CSS sem UI).
            <remove> órfão retirado 2026-08-11 (nenhum layout declara mais essa folha).
        -->
        <!--
            AWA 2026-07-15: refinamento de ruído visual desktop (home/footer),
            baseado em métricas runtime do probe H6/H8.
            CONSOLIDADO 2026-08-10 (P2): conteúdo fundido em
            awa-visual-fixes-2026-06-29-final.css (seção "MERGED — ex-awa-visual-noise").
            Arquivo-fonte preservado em web/css/ para referência do deferred-stack build.
        -->
        <!--
            AWA 2026-07-08: fix isolado — FAB modo escuro colidindo com botão
            "Permitir cookies" no mobile.
            CONSOLIDADO 2026-08-10 (P2): conteúdo fundido em
            awa-visual-fixes-2026-06-29-final.css (seção "MERGED — ex-awa-cookie-fab").
            Arquivo-fonte preservado em web/css/ para referência do deferred-stack build.
        -->
        <!--
            AWA 2026-08-01 / BUG-SHELL-SSOT-DUP-001 (2026-08-05):
            awa-m2-visual-ssot NÃO é registrado aqui.
            Cópia early no <head> + loader/plugin após align-grid = 2× na PDP/carrinho.
            Fonte única (após align-grid): awa-align-grid-terminal-loader.phtml
            e OptimizeHeadStylesPlugin::consolidateM2VisualSsotTerminal().
        -->
        <!--
            AWA Onda 1 — Design System (único ponto de override visual a partir de agora).
            Deve permanecer como ÚLTIMO <css> deste <head>.
        -->
        <css src="css/awa-design-system.css"/>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.jsbuild.runtime.fallback"
                   template="Magento_Theme::html/awa-jsbuild-fallback.phtml"/>
            <!--
                AWA: Open Graph + Twitter Card meta tags.
                Audit 2026-04-23: zero og:* encontradas em nenhuma página.
                Template detecta contexto (Home/PLP/PDP/CMS) e gera tags corretas.
            -->
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.og.meta"
                   template="Magento_Theme::html/awa-og-meta.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">GrupoAwamotos\Theme\ViewModel\OpenGraph</argument>
                    <argument name="open_graph_view_model" xsi:type="object">GrupoAwamotos\Theme\ViewModel\OpenGraph</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
