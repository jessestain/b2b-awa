<?php
/**
 * AWA Product Shelf Carousel — loader global
 *
 * Emite o par CSS shelf+contract + JS uma única vez por resposta HTML.
 * Guard anti-duplicação: layout/plugin não deve renderizar este bloco duas vezes.
 *
 * Isolation r4 (cms_index_index): não emite JS. CSS scroll-snap fica no
 * deferred stack / design-system (SEÇÃO 48/49). Sem setas JS até reabilitar init barato.
 */
declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
if (!empty($GLOBALS['__awaShelfCarouselLoaderEmitted'])) {
    return;
}
$GLOBALS['__awaShelfCarouselLoaderEmitted'] = true;

$request = $block->getRequest();
$isHomePage = $request && $request->getFullActionName() === 'cms_index_index';
if ($isHomePage) {
    return;
}
/* ESCOPO PROVADO (04/10/2026): as rotas INSTITUCIONAIS nao tem carrossel de shelf.
   Este loader injeta awa-shelf-carousel.min.css (49 KB) + awa-carousel-contract.min.css
   (15 KB). MEDIDO com probe-dependencia-folhas.js em /contact/: desabilitar as duas
   nao altera NENHUM valor computado de 25 componentes-ancora — confirmado nas 4
   combinacoes (desktop+mobile x anonimo+logado), restauracao integra em todas.
   E o proprio tema ja faz o equivalente: b2b_auth_shell.xml remove print.css e outras,
   e este arquivo ja se exclui da home. Estendo a mesma condicao que ele ja usa. */
$rotaInstitucional = in_array($request ? $request->getFullActionName() : '', [
    'contact_index_index',
], true);
if ($rotaInstitucional) {
    return;
}

$assetVersion = '20260902-home-idle-carousel-r4';
$cssUrl = $block->getViewFileUrl('css/awa-shelf-carousel.min.css') . '?v=' . $assetVersion;
$contractCssUrl = $block->getViewFileUrl('css/awa-carousel-contract.min.css') . '?v=' . $assetVersion;
$jsUrl = $block->getViewFileUrl('js/awa-scroll-carousel.min.js') . '?v=' . $assetVersion;
?>
<?php /* PSI: print→all — geometria pré-init coberta onde há critical inline. */ ?>
<link rel="stylesheet"
      href="<?= $block->escapeUrl($cssUrl) ?>"
      data-awa-shelf-js="<?= $block->escapeHtmlAttr($jsUrl) ?>"
      data-awa-shelf-loader="1"
      media="print"
      onload="this.media='all'"/>
<link rel="stylesheet"
      href="<?= $block->escapeUrl($contractCssUrl) ?>"
      data-awa-carousel-contract="1"
      media="print"
      onload="this.media='all'"/>
<noscript>
    <link rel="stylesheet" href="<?= $block->escapeUrl($cssUrl) ?>"/>
    <link rel="stylesheet" href="<?= $block->escapeUrl($contractCssUrl) ?>"/>
</noscript>
<script src="<?= $block->escapeUrl($jsUrl) ?>" defer></script>
