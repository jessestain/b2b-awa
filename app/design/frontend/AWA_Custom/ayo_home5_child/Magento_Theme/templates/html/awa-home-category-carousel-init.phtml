<?php
declare(strict_types=1);
?>
<script>
(function (w, d) {
    'use strict';

    var started = false;
    var ready = false;
    var requireRetries = 0;
    var maxRequireRetries = 80;
    var pendingDir = 0; // -1 prev, +1 next (first-click race)

    function getScroller(track) {
        return track && (track.closest('.awa-category-carousel__viewport') || track);
    }

    function getScrollAmount(track, scroller) {
        var items = track ? track.querySelectorAll('.awa-category-carousel__item') : [];
        var style = track ? w.getComputedStyle(track) : null;
        var gap = style ? (parseInt(style.gap, 10) || 16) : 16;
        var itemW = items[0] ? (items[0].offsetWidth + gap) : 280;
        return Math.max(Math.floor(scroller.clientWidth / itemW) * itemW, 280);
    }

    function scrollNative(track, dir, behavior) {
        var scroller = getScroller(track);
        if (!track || !scroller || !dir) {
            return;
        }
        scroller.scrollBy({
            left: dir * getScrollAmount(track, scroller),
            behavior: behavior || 'auto'
        });
    }

    function isCarouselIntentTarget(target) {
        if (!target || typeof target.closest !== 'function') {
            return false;
        }

        return !!target.closest('.top-home-content--category-carousel, #awa-cat-carousel, .awa-category-carousel__prev, .awa-category-carousel__next');
    }

    function applyPendingNav(track) {
        var dir = pendingDir;
        pendingDir = 0;
        if (!track || !dir) {
            return;
        }
        scrollNative(track, dir, 'auto');
    }

    function initCategoryCarousel() {
        if (started) {
            return;
        }

        var target = d.getElementById('awa-cat-carousel');
        if (!target) {
            return;
        }

        started = true;

        function boot() {
            if (typeof w.require !== 'function') {
                requireRetries += 1;
                if (requireRetries < maxRequireRetries) {
                    w.setTimeout(boot, 120);
                }
                return;
            }

            w.require(['js/awa-home-category-carousel'], function (init) {
                if (typeof init === 'function') {
                    init({ mobileBreakpoint: 768 }, target);
                }
                ready = true;
                applyPendingNav(target);
            });
        }

        if (typeof w.awaRunWhenRequire === 'function') {
            w.awaRunWhenRequire(boot, { key: 'awa-home-category-carousel' });
            return;
        }

        boot();
    }

    function onIntent(event) {
        var target = event && event.target ? event.target : null;
        if (!isCarouselIntentTarget(target)) {
            return;
        }

        var btn = target && target.closest
            ? target.closest('.awa-category-carousel__prev, .awa-category-carousel__next')
            : null;
        if (btn && !ready) {
            if (btn.classList.contains('awa-category-carousel__next')) {
                pendingDir = 1;
            } else if (btn.classList.contains('awa-category-carousel__prev')) {
                pendingDir = -1;
            }
        }

        initCategoryCarousel();
    }

    function onClickFallback(event) {
        var target = event && event.target ? event.target : null;
        var btn = target && typeof target.closest === 'function'
            ? target.closest('.awa-category-carousel__prev, .awa-category-carousel__next')
            : null;
        var track;
        var dir;

        if (!btn || ready) {
            return;
        }

        track = d.getElementById('awa-cat-carousel');
        dir = btn.classList.contains('awa-category-carousel__next') ? 1 : -1;
        pendingDir = 0;
        scrollNative(track, dir, 'smooth');
    }

    function schedule() {
        var target = d.getElementById('awa-cat-carousel');
        if (!target) {
            return;
        }

        var eager = function () { initCategoryCarousel(); };
        if (typeof w.requestIdleCallback === 'function') {
            w.requestIdleCallback(eager, { timeout: 1800 });
        } else {
            w.setTimeout(eager, 400);
        }

        ['pointerdown', 'keydown', 'touchstart'].forEach(function (name) {
            w.addEventListener(name, onIntent, { capture: true, passive: name !== 'keydown' });
        });
        w.addEventListener('click', onClickFallback, { capture: true, passive: true });
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', schedule, { once: true });
    } else {
        schedule();
    }
}(window, document));
</script>
