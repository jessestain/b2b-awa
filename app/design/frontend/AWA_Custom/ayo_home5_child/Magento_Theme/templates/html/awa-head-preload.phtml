<?php /* MISSÃO HOME MOBILE 18/10/2026 — colapso da faixa B2B dispensada.
   awa-header-runtime-bootstrap.js esconde a barra e tenta display:none no
   #header.header-container, mas o shell do header e re-renderizado e o estilo
   inline se perde, sobrando 44px vazios no topo. Aqui a classe e aplicada no
   head (antes do 1o paint quando ja dispensada) + o shell recebe display:none
   inline (vence qualquer CSS) assim que o DOM existe e ao clicar em fechar. */ ?>
<script>
(function (d, w) {
    'use strict';
    function hideShell() {
        try {
            var shell = d.getElementById('header');
            if (shell && shell.classList && shell.classList.contains('header-container')) {
                shell.style.setProperty('display', 'none', 'important');
                shell.setAttribute('aria-hidden', 'true');
            }
        } catch (e) {}
    }
    function apply() {
        try {
            if (w.localStorage.getItem('awa_b2b_promo_dismissed') === '1'
                || w.sessionStorage.getItem('awa_b2b_promo_dismissed_session') === '1') {
                d.documentElement.classList.add('awa-promo-dismissed');
                hideShell();
            }
        } catch (e) {}
    }
    apply();
    d.addEventListener('DOMContentLoaded', function () {
        apply();
        var btn = d.getElementById('awa-b2b-promo-close');
        if (!btn) { return; }
        btn.addEventListener('click', function () {
            d.documentElement.classList.add('awa-promo-dismissed');
            hideShell();
        }, true);
    }, { once: true });
}(document, window));
</script>
