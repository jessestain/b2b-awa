/**
 * AWA — DNS Prefetch + CSS/Font Preload + Async CSS Bundles
 *
 * Estes elementos NÃO podem ficar no layout XML porque o schema do Magento
 * (page_configuration.xsd) não suporta:
 *  - <link href="..."> (só aceita src)
 *  - <css onload="..."> (atributo não permitido)
 *  - <noscript> (elemento não esperado em <head>)
 *
 * Adicionado em head.additional via default_head_blocks.xml.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

// === Preconnect (economiza handshake DNS + TCP + TLS — ~200-400ms por domínio) ===
$preconnect = [
    // OPT-20261024: hints de marketing removidos — os domínios só carregam após
    // consentimento (GA4) ou estão desativados (pixel FB). Mantido o esqueleto.
];
// === DNS Prefetch (outros domínios externos — menor benefício que preconnect) ===
$dnsPrefetch = [
];

// === CSS Preload ===
// awa-bundle-core, awa-bundle-refinements, awa-visual-fixes-critical:
// já carregados como <link rel="stylesheet"> bloqueante via default_head_blocks.xml
// → preload redundante removido (browser já descobre imediatamente).
$cssPreloads = [];

// === Font Preload ===
// Plus Jakarta Sans (Fase 6) — body via --awa-font; Google Fonts / awa-super-global.
// Preload Rubik removido (legado). Montserrat: Rokanthemes_Themeoption/head.phtml.
$fontPreloads = [];

// === JS Preload (early fetch for modules loaded later by RequireJS) ===
// Swiper preload removed — IntersectionObserver defers loading until carousel enters viewport.
// Preloading a resource not used on initial load wastes bandwidth and triggers PSI warnings.
$jsPreloads = [];

// === Async CSS Bundles (CSS Consolidation 2026-04-25 — Issue #6) ===
$__superGlobalUrl = $block->getViewFileUrl('css/' . HeaderImpeccableCascadeLockCss::SUPER_GLOBAL_CSS_FILE)
    . HeaderImpeccableCascadeLockCss::SUPER_GLOBAL_QUERY;
$__deferGlobalUrl = $block->getViewFileUrl('css/awa-defer-global-bundle.min.css');
$__requestForPage = $block->getRequest();
$__fullActionForPage = $__requestForPage ? (string) $__requestForPage->getFullActionName() : '';
$handles = $block->getLayout()->getUpdate()->getHandles();
// Handles + FA name: garante HOME mesmo se merge de handles divergir (Varnish/FPC/contextos).
$isHomePage = in_array('cms_index_index', $handles, true)
    || $__fullActionForPage === 'cms_index_index';
/** Home: gate por clique causava layout quebrado no 1º pointerdown (reflow de MB de CSS). */
$__homeCssInteractionGate = false;
/** Home freeze 2026-09-02: do not idle-queue CSS via awa-css-gate on cms_index_index. */
$__homeIdleCssGate = false;
$isCheckoutFlow = in_array('checkout_index_index', $handles, true)
    || in_array('checkout_cart_index', $handles, true)
    || in_array('onepagecheckout_index_index', $handles, true)
    || in_array('checkout_onepage_success', $handles, true)
    || $__fullActionForPage === 'checkout_onepage_success';
$isProductPage = $__fullActionForPage === 'catalog_product_view';
$isCatalogCssGate = in_array($__fullActionForPage, [
    'catalog_category_view',
    'catalogsearch_result_index',
], true);
$isLightCssGate = in_array($__fullActionForPage, [
    'checkout_cart_index',
    'checkout_index_index',
], true);
$isCartPageOnly = $__fullActionForPage === 'checkout_cart_index';
$__pathInfo = trim((string) ($__requestForPage ? $__requestForPage->getPathInfo() : ''), '/');
$isCheckoutPath = in_array($__pathInfo, ['checkout/cart', 'checkout'], true)
    || str_starts_with($__pathInfo, 'checkout/cart/')
    || str_starts_with($__pathInfo, 'checkout/')
    || str_contains($__pathInfo, 'onepagecheckout');
/** Rotas auth B2B: login.css + register.css + critical inline cobrem o shell. */
$authFocusActions = \GrupoAwamotos\Theme\Model\HeaderImpeccableCascadeLockCss::AUTH_FOCUS_ACTIONS;
$isB2bAuthLightShell = in_array($__fullActionForPage, $authFocusActions, true)
    || array_reduce(
        $authFocusActions,
        static fn(bool $carry, string $action): bool => $carry || in_array($action, $handles, true),
        false
    );
$isB2bAuthShell = $isB2bAuthLightShell;
/** Painel B2B logado — CSS próprio (dashboard/pages); omitir tema global (~8MB). */
$isB2bAccountOperational = !$isB2bAuthShell && (
    in_array(
        $__fullActionForPage,
        \GrupoAwamotos\Theme\Model\HeaderImpeccableCascadeLockCss::B2B_ACCOUNT_FOCUS_ACTIONS,
        true
    )
    || (str_starts_with($__fullActionForPage, 'b2b_account_')
        && !in_array($__fullActionForPage, $authFocusActions, true))
);
/** Carrinho/checkout usam stack dedicado (polish + layout-terminal + refine); bundles legados quebram grid.
 * B2B operacional (dashboard/pedidos/cotações): PRECISA dos bundles globais (themes.min.css,
 * awa-super-global, awa-layout-bundle) para o header, minicart e footer renderizarem. */
$__skipLegacyFlowCss = $isCheckoutFlow || $isLightCssGate || $isCheckoutPath || $isB2bAuthShell;
$__cssGateFull = static function () use ($isCatalogCssGate): bool {
    return $isCatalogCssGate;
};
$__cssGateAny = static function () use ($isCatalogCssGate, $isLightCssGate): bool {
    return $isCatalogCssGate || $isLightCssGate;
};

// Homepage scope flag — antes guardava a URL do bundle awa-super-home
// (arquivo inexistente; emissão removida 2026-08-11). Mantida como flag booleana
// porque os blocos abaixo a reutilizam para escopo home.
