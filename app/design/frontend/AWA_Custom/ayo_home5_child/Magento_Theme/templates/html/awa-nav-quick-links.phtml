<?php
declare(strict_types=1);
/**
 * AWA Nav Quick Links — Links rápidos de categorias populares na barra de navegação.
 * Renderiza links de categorias level-2 com include_in_menu=true, posicionados
 * na nav-bar entre "Departamentos" e o locale selector.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

$escaper = $block->getEscaper() ?? $this;

$normalizeHtmlSuffixUrl = static function (string $url): string {
    return preg_replace('/\.html\/(?=($|[?#]))/i', '.html', $url) ?? $url;
};

$directUrl = static function (string $path) use ($block, $normalizeHtmlSuffixUrl): string {
    $url = $block->getUrl('', ['_direct' => ltrim($path, '/'), '_nosid' => true]);

    return $normalizeHtmlSuffixUrl($url);
};

// CMS pages (ex.: lancamentos) resolvem em /slug sem sufixo .html nesta loja.
$cmsPageUrl = static function (string $path) use ($block): string {
    return rtrim((string) $block->getBaseUrl(), '/') . '/' . ltrim($path, '/');
};

/** @var \Magento\Catalog\Model\ResourceModel\Category\CollectionFactory $collectionFactory */
$collectionFactory = $this->helper(\Magento\Catalog\Helper\Data::class);

// Categorias de destaque hardcoded (IDs das mais vendidas)
// Fallback para nomes + URLs se a collection não estiver disponível.
$quickLinks = [
    ['name' => 'Nossas Marcas', 'url' => $directUrl('nossas-marcas')],
    ['name' => 'Lançamentos',   'url' => $cmsPageUrl('lancamentos')],
    ['name' => 'Catálogo',      'url' => $cmsPageUrl('catalogo')],
];

$requestPath = trim((string) $block->getRequest()->getOriginalPathInfo(), '/');
?>
<div class="awa-nav-quick-links" data-awa-nav-quick="true">
    <ul class="awa-nav-quick-links__list">
        <?php foreach ($quickLinks as $link): ?>
        <?php
            $linkPath = trim((string) (parse_url((string) $link['url'], PHP_URL_PATH) ?: ''), '/');
            $isCurrent = $linkPath !== '' && strcasecmp($linkPath, $requestPath) === 0;
        ?>
        <li class="awa-nav-quick-links__item">
            <a href="<?= $escaper->escapeUrl($link['url']) ?>"
               class="awa-nav-quick-links__link"<?= $isCurrent ? ' aria-current="page"' : '' ?>>
                <?= $escaper->escapeHtml($link['name']) ?>
            </a>
        </li>
        <?php endforeach; ?>
    </ul>
</div>
