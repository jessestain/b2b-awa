<?php
/**
 * AWA Motos — Open Graph + Twitter Card Meta Tags
 *
 * Usa ViewModel via DI (GrupoAwamotos\Theme\ViewModel\OpenGraph).
 * Sem ObjectManager — compatível com boas práticas Magento 2 / FPC.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

declare(strict_types=1);

use GrupoAwamotos\Theme\ViewModel\OpenGraph;

$viewModel = $block->getData('view_model') ?: $block->getData('open_graph_view_model');
if (!$viewModel instanceof OpenGraph) {
    return;
}

$meta = $viewModel->getMetaData();

// ACHADO SEO-001: o visitante que não pode ver preço não recebe o valor no HTML.
// Gate recebido pelo <argument name="b2b_gate"> do layout (Magento_Theme/layout/default.xml).
// Fail-closed: sem gate válido, ou em erro, o preço NÃO é emitido.
$b2bGate = $block->getData('b2b_gate');
$awaPricesVisible = false;
if ($b2bGate instanceof \GrupoAwamotos\B2B\ViewModel\PdpGate) {
    try {
        $awaPricesVisible = $b2bGate->canViewPrices();
    } catch (\Throwable $exception) {
        $awaPricesVisible = false;
    }
}
if (!$awaPricesVisible) {
    unset($meta['price_amount'], $meta['price_currency']);
}

$esc = static function (string $value) use ($block): string {
    return $block->escapeHtmlAttr($value);
};
$urlEsc = static function (string $value) use ($block): string {
    return $block->escapeUrl($value);
};
?>
<!-- AWA Motos — Open Graph / Social Meta Tags -->
<meta property="og:type"        content="<?= $esc($meta['type'] ?? 'website') ?>">
<meta property="og:site_name"   content="<?= $esc($meta['site_name'] ?? 'AWA Motos') ?>">
<meta property="og:title"       content="<?= $esc($meta['title'] ?? '') ?>">
<meta property="og:description" content="<?= $esc($meta['description'] ?? '') ?>">
<meta property="og:image"       content="<?= $urlEsc($meta['image'] ?? '') ?>">
<meta property="og:image:alt"   content="<?= $esc($meta['image_alt'] ?? ($meta['title'] ?? '')) ?>">
<?php if (!empty($meta['image_width']) && !empty($meta['image_height'])): ?>
<meta property="og:image:width"  content="<?= $esc((string) $meta['image_width']) ?>">
<meta property="og:image:height" content="<?= $esc((string) $meta['image_height']) ?>">
<?php endif; ?>
<meta property="og:url"         content="<?= $urlEsc($meta['url'] ?? '') ?>">
<meta property="og:locale"      content="<?= $esc($meta['locale'] ?? 'pt_BR') ?>">
<?php if (($meta['type'] ?? '') === 'product' && !empty($meta['price_amount'])): ?>
<meta property="product:price:amount"   content="<?= $esc($meta['price_amount']) ?>">
<meta property="product:price:currency" content="<?= $esc($meta['price_currency'] ?? 'BRL') ?>">
<?php endif; ?>
<?php if (!empty($meta['availability'])): ?>
<meta property="product:availability" content="<?= $esc($meta['availability']) ?>">
<?php endif; ?>
<!-- Twitter Card -->
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content="<?= $esc($meta['title'] ?? '') ?>">
<meta name="twitter:description" content="<?= $esc($meta['description'] ?? '') ?>">
<meta name="twitter:image"       content="<?= $urlEsc($meta['image'] ?? '') ?>">
<meta name="twitter:image:alt"   content="<?= $esc($meta['image_alt'] ?? ($meta['title'] ?? '')) ?>">
