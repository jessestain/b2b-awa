<?php declare(strict_types=1);

/**
 * AWA Cookie Consent — carrega CSS async (head não aceita inline script).
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
$cookieFixUrl = $block->getViewFileUrl('css/awa-cookie-consent-fix.min.css') . '?v=20261020-ava-consent-r1';
$urlJson = json_encode($block->escapeUrl($cookieFixUrl), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
?>
<script>
(function (d, url) {
    'use strict';
    /* Checa QUALQUER <link rel=stylesheet> já apontando pro arquivo (não só o
       criado por este script) — na home, awa-cookie-consent-home-head.phtml já
       injeta o mesmo CSS de forma síncrona (media=print->all); sem esse check
       amplo o defer loader duplicava o <link> após o idle callback (confirmado
       via telemetria de runtime 2026-07-05). */
    if (!url || d.querySelector('link[rel="stylesheet"][href*="awa-cookie-consent-fix"]')) {
        return;
    }
    function load() {
        var link = d.createElement('link');
        link.rel = 'stylesheet';
        link.href = url;
        link.media = 'all';
        link.setAttribute('data-awa-cookie-consent-css', '1');
        d.head.appendChild(link);
    }
    if ('requestIdleCallback' in window) {
        requestIdleCallback(load, { timeout: 2000 });
    } else {
        setTimeout(load, 600);
    }
}(document, <?= /* @noEscape */ $urlJson ?>));
</script>
