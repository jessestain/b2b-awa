<?php
/**
 * AWA_Custom/ayo_home5_child — Override de Magento_Theme::html/skip-links.phtml
 *
 * Correção WCAG 2.1 SC 2.4.1 (Bypass Blocks):
 *   – O link original usava href="#store.menu" que não existe no DOM customizado.
 *   – Corrigido para #awa-category-navigation, ID já existente no menu.
 *     #awa-primary-navigation permanece como shell do drawer mobile.
 *   – O link "Ir para o conteúdo" mantém #maincontent (Magento padrão).
 *
 * Template original: app/design/frontend/ayo/ayo_default/Magento_Theme/templates/html/skip-links.phtml
 */
declare(strict_types=1);

$fullActionName = (string) $block->getRequest()->getFullActionName();
$isB2bAuthLightShell = in_array($fullActionName, [
    'b2b_account_login',
    'b2b_account_forgotpassword',
    'b2b_account_claim',
    'b2b_register_index',
    'b2b_register_success',
], true);

$mainContentTarget = match ($fullActionName) {
    'cms_index_index', 'cms_home' => '#awa-main-content',
    'b2b_account_login', 'b2b_account_forgotpassword', 'b2b_account_claim', 'b2b_register_index', 'b2b_register_success' => '#maincontent',
    default => '#maincontent',
};
?>
<a class="action skip content awa-skip-link skip-to-main-content" href="<?= $block->escapeHtmlAttr($mainContentTarget) ?>">
    <span><?= $block->escapeHtml(__('Ir para o conteúdo principal')) ?></span>
</a>
<?php if (!$isB2bAuthLightShell): ?>
<a class="action skip nav awa-skip-link" href="#awa-category-navigation">
    <span><?= $block->escapeHtml(__('Ir para a navegação')) ?></span>
</a>
<?php endif; ?>
