<script>
(function (w, d) {
    'use strict';
    if (w.__awaPwaInstallInit) return;
    w.__awaPwaInstallInit = true;

    var STORAGE_KEY = 'awa-pwa-install-dismissed';
    var DISMISS_DAYS = 7;
    var MIN_PROMPT_DELAY_MS = 60000;
    var MIN_PROMPT_SCROLL_PX = 500;
    var promptEl = null;
    var deferredPrompt = null;
    var previousFocus = null;
    var scrollLockClass = 'awa-pwa-install-open';

    function ensureHomeModalScheduler() {
        if (w.__awaRequestHomeModal) return;

        var VISIT_KEY = 'awa-home-visited-before';
        var SESSION_KEY = 'awa-home-modal-shown';
        var visitType = 'first';

        try {
            visitType = localStorage.getItem(VISIT_KEY) ? 'returning' : 'first';
        } catch (e) {}

        w.__awaHomeVisitType = visitType;

        function markVisited() {
            try {
                localStorage.setItem(VISIT_KEY, '1');
            } catch (e) {}
        }

        if (d.readyState === 'complete') {
            setTimeout(markVisited, 0);
        } else {
            w.addEventListener('load', function () {
                setTimeout(markVisited, 0);
            }, { once: true });
        }

        w.__awaRequestHomeModal = function (type, callback) {
            try {
                if (sessionStorage.getItem(SESSION_KEY) === '1') return false;
            } catch (e) {}

            if (w.__awaHomeModalPending) return false;
            if (visitType === 'first' && type !== 'notification') return false;
            if (visitType === 'returning' && type !== 'install') return false;

            w.__awaHomeModalPending = type;

            var run = function () {
                try {
                    if (sessionStorage.getItem(SESSION_KEY) === '1') return;
                    sessionStorage.setItem(SESSION_KEY, '1');
                } catch (e) {}
                callback();
            };

            var hasMeaningfulEngagement = function () {
                var scrollTop = w.scrollY
                    || d.documentElement.scrollTop
                    || (d.body ? d.body.scrollTop : 0)
                    || 0;

                if (d.visibilityState === 'hidden') return false;
                if (scrollTop >= MIN_PROMPT_SCROLL_PX) return true;

                // Páginas curtas (ex.: carrinho vazio) não têm 500px para
                // rolar; nesse caso o engajamento é considerado satisfeito
                // assim que o delay mínimo vence.
                var docHeight = Math.max(
                    d.documentElement ? d.documentElement.scrollHeight : 0,
                    d.body ? d.body.scrollHeight : 0
                );
                var viewHeight = w.innerHeight
                    || (d.documentElement ? d.documentElement.clientHeight : 0)
                    || 0;

                return docHeight - viewHeight <= MIN_PROMPT_SCROLL_PX;
            };

            var schedule = function () {
                var delayElapsed = false;
                var maybeRun;

                var cleanup = function () {
                    w.removeEventListener('scroll', maybeRun);
                    d.removeEventListener('visibilitychange', maybeRun);
                };

                maybeRun = function () {
                    if (!delayElapsed || !hasMeaningfulEngagement()) return;
                    cleanup();
                    run();
                };

                w.addEventListener('scroll', maybeRun, { passive: true });
                d.addEventListener('visibilitychange', maybeRun);
                w.setTimeout(function () {
                    delayElapsed = true;
                    maybeRun();
                }, MIN_PROMPT_DELAY_MS);
            };

            if (d.readyState === 'complete') {
                schedule();
            } else {
                w.addEventListener('load', schedule, { once: true });
            }

            return true;
        };
    }

    ensureHomeModalScheduler();

    function isReturningVisitor() {
        return w.__awaHomeVisitType === 'returning';
    }

    function shouldShow() {
        if (!isReturningVisitor()) return false;
        try {
            var dismissed = localStorage.getItem(STORAGE_KEY);
            if (!dismissed) return true;
            var ts = parseInt(dismissed, 10);
            if (!ts) return true;
            return (Date.now() - ts) > (DISMISS_DAYS * 24 * 60 * 60 * 1000);
        } catch (e) {
            return true;
        }
    }

    function dismiss() {
        try {
            localStorage.setItem(STORAGE_KEY, String(Date.now()));
        } catch (e) {}
    }

    function show() {
        if (!promptEl) promptEl = d.querySelector('[data-awa-pwa-install]');
        if (promptEl) {
            previousFocus = d.activeElement;
            promptEl.hidden = false;
            d.documentElement.classList.add(scrollLockClass);
            d.body.classList.add(scrollLockClass);
            var cta = promptEl.querySelector('[data-awa-pwa-install-accept]');
            if (cta) setTimeout(function () { cta.focus(); }, 100);
        }
    }

    function hide() {
        if (promptEl) {
            promptEl.hidden = true;
            d.documentElement.classList.remove(scrollLockClass);
            d.body.classList.remove(scrollLockClass);
            if (previousFocus && typeof previousFocus.focus === 'function') {
                previousFocus.focus();
            }
        }
    }

    // Bind close handlers
    d.addEventListener('click', function (e) {
        var t = e.target.closest('[data-awa-pwa-install-close]');
        if (t) { hide(); dismiss(); }
    });

    d.addEventListener('keydown', function (e) {
        if ((e.key === 'Escape' || e.keyCode === 27) && promptEl && !promptEl.hidden) {
            hide();
            dismiss();
        }
    });

    // Bind accept
    d.addEventListener('click', function (e) {
        var t = e.target.closest('[data-awa-pwa-install-accept]');
        if (t) {
            e.preventDefault();
            hide();
            dismiss();
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then(function (choice) {
                    deferredPrompt = null;
                });
            }
        }
    });

    // Capturar beforeinstallprompt
    w.addEventListener('beforeinstallprompt', function (e) {
        // Só assumimos o controle do evento (suprimindo o banner nativo)
        // quando vamos realmente mostrar o nosso modal. Nos demais casos
        // (primeira visita, modal já exibido na sessão etc.) o browser
        // fica livre para mostrar o banner nativo de instalação — isso
        // elimina o aviso "Banner not shown: ...
        // beforeinstallpromptevent.preventDefault() called".
        if (shouldShow() && w.__awaRequestHomeModal('install', show)) {
            e.preventDefault();
            deferredPrompt = e;
        }
    });

    // iOS - detectar
    var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !w.MSStream;
    if (isIOS && shouldShow() && !w.navigator.standalone) {
        w.__awaRequestHomeModal('install', show);
    }
})(window, document);
</script>

