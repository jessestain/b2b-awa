<?php
/**
 * AWA Motos - PDP Add to Cart safety net (2026-07-03)
 *
 * Causa raiz (Fase 8 / P1, ligada ao bug P0 de "Adicionar ao Carrinho" silencioso):
 * o template Magento_Catalog::product/view/addtocart.phtml (core, nao customizado
 * pela AWA) renderiza o botao "#product-addtocart-button" com o atributo
 * "disabled" fixo no HTML. Isso e intencional no Magento: o botao so deve ficar
 * clicavel depois que "Magento_Catalog/js/validate-product" inicializa via
 * x-magento-init e chama $('.action.tocart').attr('disabled', false) dentro do
 * seu metodo _create(). Ou seja, o carrinho inteiro depende de jQuery + RequireJS
 * + essa cadeia de modulos carregarem sem erro ANTES do cliente clicar.
 *
 * Esta pagina carrega dezenas de scripts customizados (awa-*.js) no
 * before.body.end. Se qualquer modulo requerido antes dessa inicializacao
 * falhar (erro de sintaxe, 404, timeout de rede), o botao pode permanecer
 * clicavel apenas visualmente mas com "disabled" nunca removido — o clique
 * simplesmente nao dispara o submit do form, sem NENHUM feedback (exatamente
 * o sintoma relatado: cliques sem efeito, carrinho permanece vazio).
 *
 * Correcao (defesa em profundidade, nao substitui a inicializacao normal):
 * script standalone, sem dependencia de jQuery/RequireJS, que apenas GARANTE
 * que o botao nao fique preso desabilitado por tempo indefinido. Nao ha
 * nenhuma regra de negocio no tema que precise manter esse botao desabilitado
 * apos o carregamento da pagina (grep confirmado: nenhum outro script
 * reaplica disabled=true nele por estoque/B2B/configuravel). Se o fallback
 * disparar, reporta ao dataLayer (mesmo canal do awa-rum.phtml) para dar
 * visibilidade real de producao — não mascara o problema, apenas evita que o
 * cliente fique irremediavelmente travado por uma falha de terceiro/rede.
 *
 * 2026-09-15: GRACE_MS recalibrado de 2500ms para 8000ms. Runtime evidence
 * (CDP, paginas reais) mostrou DOMContentLoaded consistentemente entre
 * 2.8s-5.7s nesta PDP (dezenas de scripts awa-*.js no before.body.end) —
 * ou seja, o timer disparava um falso positivo em toda carga normal da
 * pagina, antes mesmo de Magento_Catalog/js/validate-product ter chance de
 * inicializar. O botao sempre terminava habilitado; o warning era so ruido
 * de telemetria. 8000ms da margem real sobre o pior caso observado sem
 * deixar de detectar uma trava genuina (falha de terceiro/rede).
 *
 * 2026-10-13: gate B2B SSR (addtocart.phtml) entrega o botao DESABILITADO
 * para visitantes POR DESIGN (b2b-guest-mode) e para clientes pendentes
 * (b2b-pending-mode). O probe passou a ignorar esses estados (sem warning,
 * sem dataLayer) — antes acusava falso positivo em TODA sessao anonima,
 * mesmo com o gate funcionando perfeitamente. Cliente aprovado que recebe
 * SSR de visitante (FPC) ganha uma segunda checagem (+6s) para o
 * login-to-cart.js restaurar o botao antes de qualquer report.
 */
?>
<script>
(function (w, d) {
    'use strict';
    if (w.__awaAddToCartSafetyInit) return;
    w.__awaAddToCartSafetyInit = true;

    var GRACE_MS = 8000;

    function reportStuckButton(button) {
        if (typeof w.dataLayer === 'undefined') {
            w.dataLayer = w.dataLayer || [];
        }
        w.dataLayer.push({
            event: 'awa_js_error',
            message: 'add-to-cart button still disabled; Magento validation remains authoritative',
            filename: 'awa-pdp-addtocart-safety.phtml',
            page_path: w.location.pathname
        });
        if (w.console && w.console.warn) {
            w.console.warn('[AWA] #product-addtocart-button ainda desabilitado após ' + GRACE_MS + 'ms; Magento_Catalog/js/validate-product continua sendo a única autoridade para habilitá-lo.');
        }
    }

    function isB2bRestricted() {
        return !!(d.body && (d.body.classList.contains('b2b-guest-mode')
            || d.body.classList.contains('b2b-pending-mode')
            || d.body.classList.contains('b2b-restricted-mode')));
    }

    function checkButton(attempt) {
        var button = d.getElementById('product-addtocart-button');
        if (!button || !button.disabled) {
            return;
        }
        if (isB2bRestricted()) {
            // Botao desabilitado POR DESIGN (visitante/pendente). Um cliente
            // aprovado pode ter recebido SSR de visitante via FPC: da uma
            // segunda chance para o login-to-cart.js restaurar antes de
            // desistir em silencio.
            if (!attempt) {
                w.setTimeout(function () { checkButton(true); }, 6000);
            }
            return;
        }
        // Nao ha estado B2B restrito e o botao segue desabilitado: trava real.
        // Apenas reporta para monitoramento (fail-closed: a unica autoridade
        // que habilita o botao continua sendo Magento_Catalog/js/validate-product).
        reportStuckButton(button);
    }

    function schedule() {
        w.setTimeout(function () { checkButton(false); }, GRACE_MS);
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', schedule);
    } else {
        schedule();
    }
})(window, document);
</script>
