<?php declare(strict_types=1);

/**
 * Home PSI P7 — grid mobile do header no 1º paint (link externo cacheável — 2026-06-10).
 * CSS: web/css/awa-header-mobile-grid-critical.min.css
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

use GrupoAwamotos\Theme\Model\MinicartAssetVersion;

$__headerGridCriticalUrl = $block->getViewFileUrl('css/awa-header-mobile-grid-critical.min.css') . '?v=20260717-scroll-offset-116';
$__headerGridCriticalEsc = $block->escapeUrl($__headerGridCriticalUrl);
$__minicartRuntimeVersion = MinicartAssetVersion::RUNTIME;
$__request = $block->getRequest();
$__fullActionName = $__request ? (string) $__request->getFullActionName() : '';
$__layoutHandles = $block->getLayout() ? $block->getLayout()->getUpdate()->getHandles() : [];
$__isCatalogListRoute = in_array($__fullActionName, ['catalog_category_view', 'catalogsearch_result_index'], true)
    || in_array('catalog_category_view', $__layoutHandles, true)
    || in_array('catalogsearch_result_index', $__layoutHandles, true);
?>
<link rel="stylesheet" href="<?= $__headerGridCriticalEsc ?>" media="all" id="awa-header-mobile-grid-critical"/>
<script>
(function (w, d) {
    if (d.getElementById('awa-home-critical-stack')) {
        var dup = d.getElementById('awa-header-mobile-grid-critical');
        if (dup) {
            dup.remove();
        }
        return;
    }
    var isHomeByPath = !w.location || w.location.pathname === '' || w.location.pathname === '/';
    var body = d.body;
    var skipCatalogAutoBoot = <?= $__isCatalogListRoute ? 'true' : 'false' ?>;
    var runtime = w.__awaHeaderMinicartRuntime = w.__awaHeaderMinicartRuntime || {};
    var src;
    var script;
    var attempts = 0;

    function appendDeferScript() {
        if (!src) {
            return;
        }
        if (w.__awaMinicartDeferClaim || d.querySelector('script[src="' + src + '"], script[data-awa-defer-init="' + src + '"]')) {
            return;
        }
        runtime.functionalOwner = 'defer';
        runtime.functionalOwnerSource = runtime.functionalOwnerSource || 'awa-header-mobile-grid-critical-inline-v10';
        runtime.functionalOwnerClaimedAt = runtime.functionalOwnerClaimedAt || Date.now();
        w.__awaMinicartDeferClaim = true;

        script = d.createElement('script');
        script.src = src;
        script.defer = true;
        script.setAttribute('data-awa-defer-init', src);
        (d.head || d.documentElement).appendChild(script);
    }

    function waitForRuntimeOwner() {
        if (attempts >= 8) {
            appendDeferScript();
            return;
        }

        attempts += 1;

        if (runtime.functionalOwner && runtime.functionalOwner !== 'defer') {
            return;
        }

        if (w.__awaMinicartDeferClaim || runtime.functionalOwner === 'defer') {
            appendDeferScript();
            return;
        }

        w.setTimeout(waitForRuntimeOwner, 140);
    }

    var isHomeByBodyClass = !!(body && (
        body.classList.contains('cms-index-index') ||
        body.classList.contains('cms-home') ||
        body.classList.contains('cms-homepage_ayo_home5')
    ));
    var isHomeByMarker = !!d.getElementById('awa-home-bootstrap-merged');
    if (isHomeByPath || isHomeByBodyClass || isHomeByMarker) {
        return;
    }
    // PLP/busca: o loader primário controla o boot por intenção para reduzir TBT.
    if (skipCatalogAutoBoot) {
        return;
    }
    src = <?= json_encode(
        $block->getViewFileUrl('js/awa-minicart-defer-init.js') . '?v=' . rawurlencode($__minicartRuntimeVersion),
        JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT
    ) ?>;

    waitForRuntimeOwner();
}(window, document));
</script>
<?= $block->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class)
    ->setTemplate('Magento_Theme::html/awa-header-early-sticky-sync.phtml')
    ->toHtml() ?>
