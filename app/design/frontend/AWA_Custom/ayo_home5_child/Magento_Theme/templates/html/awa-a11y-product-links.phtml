<script>
(function (w, d) {
    'use strict';

    var LINK_SELECTOR = '.product-item-photo, .product-thumb-link, a.product-item-photo';

    function fixProductLinks(root) {
        var scope = root && root.querySelectorAll ? root : d;
        scope.querySelectorAll(LINK_SELECTOR).forEach(function (link) {
            if (link.getAttribute('aria-label') ||
                link.getAttribute('aria-labelledby') ||
                link.textContent.trim()) {
                return;
            }

            var img = link.querySelector('img[alt]');
            if (img && img.alt && img.alt.trim()) {
                link.setAttribute('aria-label', img.alt.trim());
            }
        });
    }

    var intentEvents = ['pointerdown', 'keydown', 'touchstart'];
    var fixesScheduled = false;

    function scheduleFixes() {
        if (fixesScheduled) {
            return;
        }
        fixesScheduled = true;
        intentEvents.forEach(function (name) {
            w.removeEventListener(name, scheduleFixes, true);
        });
        fixProductLinks(d);
    }

    d.addEventListener('contentUpdated', function (event) {
        var target = event && event.target && event.target.querySelectorAll ? event.target : d;
        fixProductLinks(target);
    });

    intentEvents.forEach(function (name) {
        w.addEventListener(name, scheduleFixes, { capture: true, passive: name !== 'keydown', once: true });
    });
}(window, document));
</script>
