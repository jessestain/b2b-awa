<?php
/**
 * AWA Mobile Bottom Navigation
 * Renderizado fora do <footer> para evitar bug Chrome com position:fixed
 * dentro de scroll containers (footer com scrollHeight > clientHeight).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

declare(strict_types=1);

/** @var \GrupoAwamotos\Theme\ViewModel\FooterData $viewModel */
$viewModel = $block->getData('view_model');
$enableMenu = $viewModel ? $viewModel->isMobileMenuEnabled() : false;

if (!$enableMenu) {
    return;
}

$fullActionName = (string) $block->getRequest()->getFullActionName();
$isHome = $fullActionName === 'cms_index_index';
$isAccount = str_starts_with($fullActionName, 'customer_account')
    || str_starts_with($fullActionName, 'b2b_account');
$isCart = $fullActionName === 'checkout_cart_index';
$accountUrl = $block->getUrl('b2b/account/login');

?>
<nav class="fixed-bottom hidden-sm hidden-md hidden-lg" role="navigation" aria-label="<?= $escaper->escapeHtmlAttr(__('Navegação Móvel')) ?>" data-awa-mobile-nav="v4-deptos">
    <div class="link-on-bottom">
        <ul class="mobile-bottom-link flex-layout space-between list-unstyled">
            <li class="<?= $isHome ? 'active' : '' ?>">
                <a href="<?= $escaper->escapeUrl($block->getUrl('')) ?>" aria-label="<?= $escaper->escapeHtmlAttr(__('Início')) ?>" title="<?= $escaper->escapeHtmlAttr(__('Início')) ?>"<?= $isHome ? ' aria-current="page"' : '' ?>>
                    <span class="icon icon-home" aria-hidden="true"></span>
                    <?= $escaper->escapeHtml(__('Home')) ?>
                </a>
            </li>
            <li>
                <?php /* A11Y-001: aria-label precisa conter o texto visivel ("Deptos.")
                   para nao falhar label-content-name-mismatch (WCAG 2.5.3). */ ?>
                <button type="button" class="toggle-nav-footer" aria-haspopup="true" aria-expanded="false" aria-label="<?= $escaper->escapeHtmlAttr(__('Deptos. — abrir departamentos e menu')) ?>" title="<?= $escaper->escapeHtmlAttr(__('Departamentos')) ?>">
                    <span class="icon icon-menu" aria-hidden="true"></span>
                    <?= $escaper->escapeHtml(__('Deptos.')) ?>
                </button>
            </li>
            <li class="<?= $isAccount ? 'active' : '' ?>">
                <?php /* O controller B2B redireciona clientes já autenticados ao painel. */ ?>
                <a href="<?= $escaper->escapeUrl($accountUrl) ?>" aria-label="<?= $escaper->escapeHtmlAttr(__('Minha Conta')) ?>" title="<?= $escaper->escapeHtmlAttr(__('Minha Conta')) ?>"<?= $isAccount ? ' aria-current="page"' : '' ?>>
                    <span class="icon icon-users" aria-hidden="true"></span>
                    <?= $escaper->escapeHtml(__('Conta')) ?>
                </a>
            </li>
            <li class="<?= $isCart ? 'active' : '' ?>">
                <a href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart/')) ?>" aria-label="<?= $escaper->escapeHtmlAttr(__('Carrinho de Compras')) ?>" title="<?= $escaper->escapeHtmlAttr(__('Carrinho de Compras')) ?>"<?= $isCart ? ' aria-current="page"' : '' ?>>
                    <span class="icon icon-shopping-cart" aria-hidden="true"></span>
                    <?= $escaper->escapeHtml(__('Carrinho')) ?>
                </a>
            </li>
        </ul>
    </div>
</nav>
