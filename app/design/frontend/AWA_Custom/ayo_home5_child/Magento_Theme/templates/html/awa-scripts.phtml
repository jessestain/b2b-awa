<script type="text/javascript">
(function (w) {
    'use strict';

    var queued = false;

    function isMobileViewport() {
        return w.innerWidth < 992;
    }

    function loadMobileNav() {
        if (w.__AWA_MENU_V2 || queued || !isMobileViewport() || w.__awaMobileNavInit) {
            return;
        }

        function start() {
            queued = true;
            w.require(['js/awa-mobile-nav-v2'], function () {});
        }

        if (typeof w.awaRunWhenRequire === 'function') {
            w.awaRunWhenRequire(start, { key: 'awa-mobile-nav-v2' });
            return;
        }

        if (typeof w.require === 'function') {
            start();
            return;
        }

        w.setTimeout(loadMobileNav, 200);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadMobileNav, { once: true });
    } else {
        loadMobileNav();
    }

    w.addEventListener('resize', loadMobileNav, { passive: true });
}(window));
</script>
