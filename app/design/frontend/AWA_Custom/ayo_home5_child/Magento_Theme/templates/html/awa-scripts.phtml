<script type="text/javascript">
(function (w) {
    'use strict';

    function runWhenRequire(loadFn, key) {
        if (typeof w.awaRunWhenRequire === 'function') {
            w.awaRunWhenRequire(loadFn, { key: key });
            return;
        }

        if (typeof w.require === 'function') {
            loadFn();
            return;
        }

        w.setTimeout(function () {
            runWhenRequire(loadFn, key);
        }, 120);
    }

    // r45: nav-cls-reset também só após load (evita require sync no parse da home).
    function bootNavCls() {
        runWhenRequire(function () {
            w.require(['js/awa-nav-cls-fix-reset']);
        }, 'awa-nav-cls-fix-reset-home');
    }
    if (w.document.readyState === 'complete') {
        bootNavCls();
    } else {
        w.addEventListener('load', bootNavCls, { once: true });
    }

    function loadHomeDeferredModules() {
        runWhenRequire(function () {
            w.require([
                'js/awa-card-enhance',
                'js/awa-qty-control',
                'js/awa-ux-enhancements.mobile-width-r4'
            ]);
        }, 'awa-home-deferred-modules');
    }

    var intentEvents = ['pointerdown', 'keydown', 'touchstart'];
    var homeDeferStarted = false;
    var shelfIntentSel = '.product-item, .item-product, .awa-shelf, .products-grid, .hot-deal-tab-slider-customcss, .rokan-bestseller, .rokan-newproduct, [data-role="tocart-form"], .action.tocart, .awa-qty';

    function onHomeIntent(evt) {
        var target;
        if (homeDeferStarted) {
            return;
        }
        target = evt && evt.target;
        if (!target || !target.closest || !target.closest(shelfIntentSel)) {
            return;
        }
        homeDeferStarted = true;
        intentEvents.forEach(function (name) {
            w.removeEventListener(name, onHomeIntent, true);
        });
        loadHomeDeferredModules();
    }

    intentEvents.forEach(function (name) {
        w.addEventListener(name, onHomeIntent, { capture: true, passive: name !== 'keydown' });
    });
}(window));
</script>
