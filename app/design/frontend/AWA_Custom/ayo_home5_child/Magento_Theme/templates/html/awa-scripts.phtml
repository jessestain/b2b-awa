/**
 * AWA Motos — Scripts globais
 * Carregados em todas as páginas via before.body.end (default.xml).
 *
 * awa-card-enhance:       indicadores de estoque + deduplicação CTA nos cards
 * awa-qty-control:        controles +/- de quantidade (item.phtml, carrosséis)
 * awa-mobile-nav:         drawer mobile (inline — sem cache de arquivo externo)
 * awa-nav-cls-fix-reset:  remove inline height:0 do CLS fix no desktop
 * awa-ux-enhancements:    melhorias UX do audit 50 pontos (WhatsApp, trust, filtros, etc.)
 * awa-search-clear-init:  limpar busca síncrono (AMD deferido na home)
 *
 * Footer accordion: IIFE inline acima (não depende de AMD stub).
 *
 * Todos usam DOMContentLoaded internamente.
 */
$request = $block->getRequest();
$fullActionName = $request ? (string) $request->getFullActionName() : '';
$pathInfo = $request ? (string) ($request->getOriginalPathInfo() ?: $request->getPathInfo()) : '';
$pathSlug = trim($pathInfo, '/');
$isCmsHomeRoute = $fullActionName === 'cms_index_index' || $pathSlug === '';
$isCatalogMerchandisingRoute = in_array($fullActionName, [
    'catalog_category_view',
    'catalog_product_view',
    'catalogsearch_result_index',
], true);
$isCheckoutFlowRoute = in_array($fullActionName, [
    'checkout_cart_index',
    'checkout_index_index',
    'onepagecheckout_index_index',
], true) || str_starts_with($fullActionName, 'multishipping_');
$b2bAuthRoutes = [
    'b2b_register_index',
];
$isB2bAccountSurface = str_starts_with($fullActionName, 'b2b_')
    && !in_array($fullActionName, $b2bAuthRoutes, true);
$isCustomerAccountRoute = str_starts_with($fullActionName, 'customer_account_')
    || str_starts_with($fullActionName, 'b2b_account_')
    || $isB2bAccountSurface
    || in_array($fullActionName, [
        'sales_order_history',
        'sales_order_view',
        'customer_address_index',
        'customer_address_form',
        'wishlist_index_index',
        'b2b_register_index',
        'customer_account_login',
        'customer_account_create',
        'customer_account_forgotpassword',
    ], true);
$isCartPageOnly = $fullActionName === 'checkout_cart_index';
$useSlimGlobalScripts = $isCheckoutFlowRoute || $isCustomerAccountRoute;
?>
