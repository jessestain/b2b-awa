<script>
(function (w, d) {
    'use strict';
    if (!d.body || !d.body.classList.contains('catalog-product-view')) {
        return;
    }

    function forcePdpLightMode() {
        if (d.body.classList.contains('awa-dark-mode')) {
            d.body.classList.remove('awa-dark-mode');
        }
        if (!d.body.classList.contains('awa-light-mode')) {
            d.body.classList.add('awa-light-mode');
        }
    }

    forcePdpLightMode();

    function localizeFotoramaLabels(root) {
        var scope = root && root.querySelectorAll ? root : d;
        var labels = {
            'Previous': 'Imagem anterior',
            'Next': 'Próxima imagem',
            'Exit fullscreen': 'Sair da tela cheia',
            'Zoom in': 'Ampliar imagem',
            'Zoom out': 'Reduzir imagem'
        };
        Object.keys(labels).forEach(function (source) {
            scope.querySelectorAll('[aria-label="' + source + '"], [title="' + source + '"]').forEach(function (el) {
                if (el.getAttribute('aria-label') === source) {
                    el.setAttribute('aria-label', labels[source]);
                }
                if (el.getAttribute('title') === source) {
                    el.setAttribute('title', labels[source]);
                }
            });
        });
    }

    var galleryRoot = d.querySelector('.product.media, .gallery-placeholder');
    var localizeTimer = null;

    function scheduleFotoramaLabelLocalization(root) {
        if (localizeTimer !== null) {
            return;
        }

        localizeTimer = w.setTimeout(function () {
            localizeTimer = null;
            localizeFotoramaLabels(root || d);
        }, 80);
    }

    localizeFotoramaLabels(galleryRoot || d);
    d.addEventListener('DOMContentLoaded', function () {
        scheduleFotoramaLabelLocalization(galleryRoot || d);
    }, { once: true });
    d.addEventListener('fotorama:ready', function () {
        scheduleFotoramaLabelLocalization(galleryRoot || d);
    });
    d.addEventListener('fotorama:show', function () {
        scheduleFotoramaLabelLocalization(galleryRoot || d);
    });

    if (w.MutationObserver && galleryRoot) {
        var observer = new MutationObserver(function (mutations) {
            var shouldLocalize = false;

            for (var i = 0; i < mutations.length; i++) {
                if (mutations[i].type === 'childList') {
                    shouldLocalize = true;
                    break;
                }
            }

            if (shouldLocalize) {
                scheduleFotoramaLabelLocalization(galleryRoot);
            }
        });

        observer.observe(galleryRoot, {
            subtree: true,
            childList: true
        });

        // Evita observer permanente na PDP apos a galeria estabilizar.
        w.setTimeout(function () {
            observer.disconnect();
        }, 15000);
    }

})(window, document);
</script>
