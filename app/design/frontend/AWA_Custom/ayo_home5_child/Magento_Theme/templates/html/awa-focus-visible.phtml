/**
 * AWA Motos - Focus Visible (A11y WCAG 2.4.7)
 *
 * Adiciona estilo de foco visivel consistente em todos os elementos
 * interativos, especialmente para usuarios de teclado.
 *
 * Antes estava espalhado em 5+ parciais; aqui consolidado.
 */
?>
<style id="awa-focus-visible">
/* Focus visivel global - WCAG 2.4.7 */
*:focus {
    outline: none;
}
*:focus-visible,
.awa-focus-visible {
    outline: 3px solid var(--awa-primary, #b73337) !important;
    outline-offset: 2px !important;
    border-radius: 2px;
    box-shadow: 0 0 0 1px #ffffff inset !important;
}
/* Botoes especificos */
button:focus-visible,
.action:focus-visible {
    outline: 3px solid var(--awa-primary, #b73337) !important;
    outline-offset: 2px !important;
}
/* Inputs */
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline: 3px solid var(--awa-primary, #b73337) !important;
    outline-offset: 1px !important;
    border-color: var(--awa-primary, #b73337) !important;
}
/* Links */
a:focus-visible {
    outline: 3px solid var(--awa-primary, #b73337) !important;
    outline-offset: 2px !important;
    border-radius: 2px;
}
/* Remove outline para mouse users apenas (mantem teclado) */
*:focus:not(:focus-visible) {
    outline: none;
}
@media (prefers-reduced-motion: reduce) {
    *, *::focus-visible { transition: none !important; }
}
</style>
