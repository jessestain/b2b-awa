<script>
(function (w, d) {
    var deferOnCatalogIntentOnly = <?= $isCatalogListRoute ? 'true' : 'false' ?>;
    var isHomeByPath = !w.location || w.location.pathname === '' || w.location.pathname === '/';
    var body = d.body;
    var isHomeByBodyClass = !!(body && (
        body.classList.contains('cms-index-index') ||
        body.classList.contains('cms-home') ||
        body.classList.contains('cms-homepage_ayo_home5')
    ));
    var isHomeByMarker = !!d.getElementById('awa-home-bootstrap-merged');
    var isHome = isHomeByPath || isHomeByBodyClass || isHomeByMarker;
    var src;
    var script;
    var runtime = w.__awaHeaderMinicartRuntime = w.__awaHeaderMinicartRuntime || {};
    var intentBound = false;
    var pendingReplayTarget = null;
    var idleTimerId = null;
    var idleCallbackId = null;

    if (isHome) {
        return;
    }

    src = <?= json_encode(
        $block->getViewFileUrl('js/awa-minicart-defer-init.js') . '?v=' . rawurlencode($minicartRuntimeVersion),
        JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT
    ) ?>;

    if (runtime.functionalOwner && runtime.functionalOwner !== 'defer') {
        return;
    }

    function appendDeferScript() {
        if (!src) {
            return;
        }
        if (w.__awaMinicartDeferClaim || w.__awaMinicartDeferInit || d.querySelector('script[src="' + src + '"], script[data-awa-defer-init="' + src + '"]')) {
            return;
        }

        runtime.functionalOwner = 'defer';
        runtime.functionalOwnerSource = runtime.functionalOwnerSource || 'awa-custom-js-loader';
        runtime.functionalOwnerClaimedAt = runtime.functionalOwnerClaimedAt || Date.now();
        w.__awaMinicartDeferClaim = true;

        script = d.createElement('script');
        script.src = src;
        script.defer = true;
        script.setAttribute('data-awa-defer-init', src);
        if (pendingReplayTarget) {
            script.addEventListener('load', function () {
                var replayTarget = pendingReplayTarget;
                pendingReplayTarget = null;
                if (!replayTarget || !replayTarget.isConnected) {
                    return;
                }
                w.setTimeout(function () {
                    try {
                        replayTarget.dispatchEvent(new MouseEvent('click', {
                            bubbles: true,
                            cancelable: true,
                            view: w
                        }));
                    } catch (e) {
                        if (typeof replayTarget.click === 'function') {
                            replayTarget.click();
                        }
                    }
                }, 0);
            }, { once: true });
        }
        (d.head || d.documentElement).appendChild(script);
    }

    function clearIntentListeners() {
        if (!intentBound) {
            return;
        }
        intentBound = false;
        w.removeEventListener('pointerdown', onIntent, true);
        w.removeEventListener('touchstart', onIntent, true);
        w.removeEventListener('click', onIntent, true);
        w.removeEventListener('keydown', onIntent, true);
        if (idleTimerId !== null) {
            w.clearTimeout(idleTimerId);
            idleTimerId = null;
        }
        if (idleCallbackId !== null && typeof w.cancelIdleCallback === 'function') {
            w.cancelIdleCallback(idleCallbackId);
            idleCallbackId = null;
        }
    }

    function bootFromIdle() {
        clearIntentListeners();
        appendDeferScript();
    }

    function resolveIntentTarget(event) {
        var target = event && event.target ? event.target : null;
        if (target && target.nodeType === 3) {
            target = target.parentElement;
        }
        if (target && !target.closest && target.parentElement) {
            target = target.parentElement;
        }
        return target && target.closest ? target : null;
    }

    function getMinicartTrigger(target) {
        if (!target) {
            return null;
        }
        return target.closest('.action.showcart,.showcart,.header-mini-cart,[data-awa-minicart-defer="trigger"]');
    }

    function isMinicartIntent(event) {
        var target = resolveIntentTarget(event);
        if (!target || !target.closest) {
            return false;
        }
        return !!target.closest(
            '.action.showcart,.showcart,.header-mini-cart,[data-awa-minicart-defer="trigger"],' +
            '.minicart-wrapper,.mini-cart-wrapper,[data-awa-header-minicart-shell="true"],' +
            '[data-block="minicart"],[data-role="minicart-content"]'
        );
    }

    function onIntent(event) {
        if (!isMinicartIntent(event)) {
            return;
        }
        var eventType = event && event.type ? event.type : '';
        var target = resolveIntentTarget(event);
        var triggerTarget = getMinicartTrigger(target);

        if (triggerTarget && eventType === 'pointerdown') {
            return;
        }

        if (triggerTarget && (eventType === 'click' || (eventType === 'keydown' && (event.key === 'Enter' || event.key === ' ')))) {
            pendingReplayTarget = triggerTarget;
            if (event.preventDefault) {
                event.preventDefault();
            }
            if (event.stopImmediatePropagation) {
                event.stopImmediatePropagation();
            } else if (event.stopPropagation) {
                event.stopPropagation();
            }
        }

        clearIntentListeners();
        appendDeferScript();
    }

    if (deferOnCatalogIntentOnly) {
        if (w.__awaMinicartDeferClaim || w.__awaMinicartDeferInit || d.querySelector('script[src="' + src + '"], script[data-awa-defer-init="' + src + '"]')) {
            return;
        }
        intentBound = true;
        w.addEventListener('pointerdown', onIntent, { capture: true, passive: true });
        w.addEventListener('touchstart', onIntent, { capture: true, passive: true });
        w.addEventListener('click', onIntent, true);
        w.addEventListener('keydown', onIntent, true);
        return;
    }

    appendDeferScript();
}(window, document));
</script>
