<script>
/* awaCustomCompatBootstrap: home safe3 — só após interação */
(function (w, d) {
    'use strict';
    var cfg = <?= /* @noEscape */ json_encode($compatBootstrapConfig, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>;
    var done = false;
    var events = ['pointerdown', 'keydown', 'touchstart'];
    /* PD6: adia so o require()/script-append (nao o done/cleanup) para tirar
       esse trabalho do tick sincrono do toque/tecla que disparou o boot — ver
       PD5_MOBILE_SEARCH_HEADLESS_CRASH_INVESTIGATION.md. */
    function runBootWork() {
        var s = d.createElement('script');
        s.type = 'text/x-magento-init';
        s.textContent = JSON.stringify({ '*': { awaCustomCompatBootstrap: cfg } });
        d.body.appendChild(s);
        w.require(['mage/apply/main']);
