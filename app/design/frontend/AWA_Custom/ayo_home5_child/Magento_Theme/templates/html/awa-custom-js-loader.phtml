$renderIdleScriptLoader = static function (string $scriptUrl, int $timeout = 2000) use ($homeStrictPerfDefer): string {
    $encodedUrl = json_encode($scriptUrl, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT);
    $encodedTimeout = json_encode($timeout);
    $allowIdleFallbackJs = $homeStrictPerfDefer ? 'false' : 'true';
    $eventsJson = $homeStrictPerfDefer
        ? "['pointerdown', 'touchstart', 'keydown']"
        : "['pointerdown', 'touchstart', 'keydown', 'mouseover', 'scroll']";

    return <<<HTML
<script>
(function (w, d) {
    var src = {$encodedUrl};
    var timeout = {$encodedTimeout};
    var done = false;
    var events = {$eventsJson};

    function cleanup() {
        events.forEach(function (eventName) {
            w.removeEventListener(eventName, trigger, true);
        });
    }

    function appendScript() {
        if (d.querySelector('script[data-awa-lazy-src="' + src + '"]')) {
            return;
        }

        var script = d.createElement('script');
        script.src = src;
        script.defer = true;
        script.setAttribute('data-awa-lazy-src', src);
        (d.body || d.documentElement).appendChild(script);
    }

    function trigger() {
        if (done) {
            return;
        }
        done = true;
        cleanup();
        appendScript();
    }

    events.forEach(function (eventName) {
        w.addEventListener(eventName, trigger, { passive: true, capture: true, once: true });
    });

    if ({$allowIdleFallbackJs}) {
        if ('requestIdleCallback' in w) {
            w.requestIdleCallback(trigger, { timeout: timeout });
        } else {
            w.setTimeout(trigger, timeout);
        }
    }
})(window, document);
</script>
HTML;
};


$renderIntentScriptLoader = static function (
    string $scriptUrl,
    array $intentSelectors,
    int $desktopIdleTimeout = 2200,
    ?bool $allowDesktopIdle = null
) use ($homeStrictPerfDefer): string {
    if ($allowDesktopIdle === null) {
        $allowDesktopIdle = !$homeStrictPerfDefer;
    }
    $encodedUrl = json_encode($scriptUrl, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT);
    $encodedSelectors = json_encode(array_values($intentSelectors), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT);
    $encodedDesktopIdleTimeout = json_encode($desktopIdleTimeout);
    $encodedAllowDesktopIdle = $allowDesktopIdle ? 'true' : 'false';

    return <<<HTML
<script>
(function (w, d) {
    var src = {$encodedUrl};
    var selectors = {$encodedSelectors};
    var desktopIdleTimeout = {$encodedDesktopIdleTimeout};
    var allowDesktopIdle = {$encodedAllowDesktopIdle};

    var done = false;

    function dbg(stage, data) {
    }

    function isMobile() {
        return !!(w.matchMedia && w.matchMedia('(max-width: 767px)').matches);
    }

    function matchesIntentTarget(evTarget) {
        if (!evTarget || !evTarget.closest) {
            return false;
        }
        for (var i = 0; i < selectors.length; i += 1) {
            if (evTarget.closest(selectors[i])) {
                return true;
            }
        }
        return false;
    }

    function appendScript() {
        if (d.querySelector('script[data-awa-lazy-src="' + src + '"]')) {
            dbg('append_skip_existing', { path: w.location.pathname || '' });
            return;
        }
        var script = d.createElement('script');
        script.onload = function () {
            dbg('script_loaded', { path: w.location.pathname || '' });
        };
        script.onerror = function () {
            dbg('script_error', { path: w.location.pathname || '' });
        };
        script.src = src;
        script.defer = true;
        script.setAttribute('data-awa-lazy-src', src);
        dbg('append_script', { path: w.location.pathname || '' });
        (d.body || d.documentElement).appendChild(script);
    }

    function cleanup() {
        d.removeEventListener('pointerdown', onIntent, true);
        d.removeEventListener('touchstart', onIntent, true);
        d.removeEventListener('click', onIntent, true);
        d.removeEventListener('focusin', onIntent, true);
        d.removeEventListener('keydown', onIntent, true);
    }

    /**
     * PD6 (fix/pd6-search-intent-bootstrap-performance): o append do <script>
     * (fetch + parse + execucao) costumava rodar SINCRONAMENTE dentro do proprio
     * handler de pointerdown/touchstart/click/focusin/keydown. Varias instancias
     * deste mesmo loader (uma por script de intencao de busca) escutam os MESMOS
     * eventos no document — um unico toque no campo de busca dispara todas ao
     * mesmo tempo, empilhando N script-appends no mesmo tick do evento de toque.
     * Isso compete pelo main thread exatamente no instante em que o Chromium
     * ainda esta processando o proprio dispatch do evento de toque (ver
     * PD5_MOBILE_SEARCH_HEADLESS_CRASH_INVESTIGATION.md). Adiar so o
     * appendScript() (nao o "done"/cleanup, que continuam imediatos e
     * idempotentes) via requestIdleCallback tira esse trabalho do tick
     * sincrono do evento sem atrasar a decisao de "o script vai carregar" nem
     * mudar QUANDO o usuario pode interagir - so QUANDO o parser/executor do
     * script roda.
     */
    function scheduleAppendScript() {
        dbg('schedule_append', {
            path: w.location.pathname || '',
            ric: w.requestIdleCallback ? 1 : 0
        });
        if (w.requestIdleCallback) {
            w.requestIdleCallback(appendScript, { timeout: 300 });
        } else {
            w.setTimeout(appendScript, 0);
        }
    }

    function trigger() {
        if (done) {
            return;
        }
        done = true;
        dbg('trigger', {
            path: w.location.pathname || '',
            mobile: isMobile() ? 1 : 0
        });
        cleanup();
        scheduleAppendScript();
    }

    function onIntent(ev) {
        var t = ev && ev.target ? ev.target : null;
        if (!matchesIntentTarget(t)) {
            return;
        }

        if (ev.type === 'keydown') {
            var key = ev.key || '';
            if (key && key !== 'Enter' && key !== ' ' && key !== 'Spacebar') {
                return;
            }
        }

        dbg('intent_' + ev.type, {
            path: w.location.pathname || '',
            mobile: isMobile() ? 1 : 0
        });
        trigger();
    }

    // Intent-based only on mobile (evita TBT alto em Lighthouse e não disputa com LCP)
    d.addEventListener('pointerdown', onIntent, { passive: true, capture: true, once: false });
    d.addEventListener('touchstart', onIntent, { passive: true, capture: true, once: false });
    d.addEventListener('click', onIntent, { passive: true, capture: true, once: false });
    d.addEventListener('focusin', onIntent, { passive: true, capture: true, once: false });
    d.addEventListener('keydown', onIntent, { passive: true, capture: true, once: false });

    // Desktop: idle fallback opcional (home produção: intent-only — evita TBT no Lighthouse desktop)
    if (allowDesktopIdle && !isMobile()) {
        if ('requestIdleCallback' in w) {
            w.requestIdleCallback(trigger, { timeout: desktopIdleTimeout });
        } else {
            w.setTimeout(trigger, desktopIdleTimeout);
        }
    }
    dbg('loader_init', {
        path: w.location.pathname || '',
        mobile: isMobile() ? 1 : 0,
        selectors: selectors.length
    });
})(window, document);
</script>
HTML;
};

