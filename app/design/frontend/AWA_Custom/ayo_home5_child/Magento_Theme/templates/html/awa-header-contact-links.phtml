<script data-awa-form-key-sync="1">
/* CORRECAO-DEFINITIVA-CACHE (2026-10-24): sincroniza inputs form_key com o
   cookie da sessao atual. HTML cacheado pode conter form_key de outra sessao;
   o cookie form_key e sempre o da sessao corrente (VCL nao entrega o do cache). */
(function (d) {
    'use strict';
    function readKey() {
        var m = d.cookie.match(/(?:^|;\s*)form_key=([^;]+)/);
        return m ? decodeURIComponent(m[1]) : '';
    }
    function sync() {
        var key = readKey();
        if (!key) { return; }
        var inputs = d.querySelectorAll('input[name="form_key"]');
        for (var i = 0; i < inputs.length; i++) {
            if (inputs[i].value !== key) { inputs[i].value = key; }
        }
    }
    d.addEventListener('submit', sync, true);
    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', sync, { once: true });
    } else {
        sync();
    }
})(document);
</script>
