$serverIsLoggedIn = $accountPrompt ? $accountPrompt->isLoggedIn() : false;
$serverFirstname = '';
$serverFullname = '';

if ($serverIsLoggedIn && $accountPrompt) {
    $serverFirstname = $accountPrompt->getFirstname();
