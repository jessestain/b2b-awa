<script>
/* F24 (19/10/2026) — pintura precoce do cumprimento: lê o customer-data cacheado
   (localStorage mage-cache-storage) e aplica "Olá, {nome}" antes do runtime
   de account-prompt. O runtime continua revalidando via customer-data (fonte da verdade).
   Sem rede, sem conteúdo privado no HTML cacheado. */
(function (w, d) {
    'use strict';

    var root = d.querySelector('.awa-header-account-prompt');
    if (!root || root.getAttribute('data-awa-auth-state') === 'customer') {
        return;
    }

    function pick(data) {
        if (!data || typeof data !== 'object') {
            return '';
        }
        var name = String(data.firstname || data.fullname || data.name || '').trim();
        if (!name) {
            return '';
        }
        return name.length > 20 ? name.slice(0, 20) + '...' : name;
    }

    var raw;
    try {
        raw = w.localStorage.getItem('mage-cache-storage');
    } catch (storageError) {
        return;
    }
    if (!raw) {
        return;
    }

    var parsed;
    try {
        parsed = JSON.parse(raw);
    } catch (parseError) {
        return;
    }

    var name = pick(parsed && parsed.customer);
    if (!name) {
        return;
    }

    var guest = root.querySelector('.awa-header-account-prompt__guest');
    var customer = root.querySelector('.awa-header-account-prompt__customer');
    var line1 = customer ? customer.querySelector('.awa-header-account-prompt__line1') : null;

    if (line1) {
        line1.textContent = 'Olá, ' + name + '!';
    }
    if (customer) {
        customer.hidden = false;
        customer.removeAttribute('aria-hidden');
    }
    if (guest) {
        guest.hidden = true;
        guest.setAttribute('aria-hidden', 'true');
    }
    root.setAttribute('data-awa-auth-state', 'customer');
    root.removeAttribute('data-awa-auth-pending');
})(window, document);
</script>
