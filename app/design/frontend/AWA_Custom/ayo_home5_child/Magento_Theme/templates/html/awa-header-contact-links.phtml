/**
 * B2B Panel Hydration — CORRECAO-1 (2026-10-24): carregamento CONDICIONAL.
 *
 * 1. Superficie decidida server-side por handle (deterministico por URL -> FPC-safe):
 *    apenas paginas FPC onde o painel hidrata o header (home/PLP/PDP/busca/quickorder).
 *    Paginas de conta tem o painel server-rendered (o modulo faria noop).
 * 2. Cliente autenticado decidido CLIENT-SIDE (mage-cache-storage / customer-data):
 *    visitante anonimo NAO baixa nem inicializa os assets do painel.
 * 3. Nenhum dado privado vai para o HTML publico (somente URLs + codigo generico).
 *
 * O modulo mantem fast-path localStorage (DOMContentLoaded) + slow-path RequireJS.
 */
$b2bPanelHandles = [
    'cms_index_index',
    'catalog_category_view',
    'catalog_product_view',
    'catalogsearch_result_index',
    'b2b_quickorder_index',
];
$isB2bPanelSurface = in_array($fullActionName, $b2bPanelHandles, true);
if ($isB2bEnabled && $isB2bPanelSurface):
    $b2bPanelCssUrl      = $block->getViewFileUrl('GrupoAwamotos_B2B::css/header/status-panel.css');
    $b2bPanelThemeCssUrl = $block->getViewFileUrl('css/awa-b2b-status-panel.css');
    $b2bHydrateJsUrl     = $block->getViewFileUrl('GrupoAwamotos_B2B::js/b2b-panel-hydrate.js');
    $cssBust = '20260716-v75-b2b-shell-header';
    $b2bPanelCssFull      = $b2bPanelCssUrl . '?v=' . $cssBust;
    $b2bPanelThemeCssFull = $b2bPanelThemeCssUrl . '?v=' . $cssBust;
    $b2bHydrateJsFull     = $b2bHydrateJsUrl . '?v=' . $cssBust;
?>
<script data-awa-b2b-panel-loader="1">
/* CORRECAO-1 (2026-10-24) — loader condicional do painel B2B.
   Injeta CSS+JS do painel SOMENTE para cliente autenticado (mage-cache-storage /
   customer-data). Visitante anonimo nao baixa nenhum asset. Sem dados privados aqui. */
(function (w, d) {
    'use strict';
    var CSS_A = <?= /* @noEscape */ json_encode($block->escapeUrl($b2bPanelCssFull), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var CSS_B = <?= /* @noEscape */ json_encode($block->escapeUrl($b2bPanelThemeCssFull), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var JS_URL = <?= /* @noEscape */ json_encode($block->escapeUrl($b2bHydrateJsFull), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var injected = false;

    function isCustomer(data) {
        return !!(data && data.customer
            && (data.customer.firstname || data.customer.fullname || data.customer.email));
    }

    function inject() {
        if (injected || d.querySelector('script[data-awa-b2b-hydrate="1"]')) {
            return true;
        }

        var isLogged = false;
        var raw = null;
        try {
            raw = w.localStorage.getItem('mage-cache-storage');
        } catch (storageError) {
            raw = null;
        }
        if (raw) {
            var parsed = null;
            try {
                parsed = JSON.parse(raw);
            } catch (parseError) {
                parsed = null;
            }
            isLogged = isCustomer(parsed);
        } else if (w.customerData && typeof w.customerData.get === 'function') {
            try {
                isLogged = isCustomer(w.customerData.get('customer')());
            } catch (customerDataError) {
                isLogged = false;
            }
        }

        if (!isLogged) {
            return false; /* guest: fail-closed neutro, nenhum download */
        }

        injected = true;

        var cssA = d.createElement('link');
        cssA.rel = 'stylesheet';
        cssA.href = CSS_A;
        cssA.media = 'print';
        cssA.onload = function () { this.media = 'all'; };
        cssA.setAttribute('data-awa-b2b-panel-css', '1');

        var cssB = d.createElement('link');
        cssB.rel = 'stylesheet';
        cssB.href = CSS_B;
        cssB.media = 'print';
        cssB.onload = function () { this.media = 'all'; };
        cssB.setAttribute('data-awa-b2b-status-panel', '1');

        var script = d.createElement('script');
        script.src = JS_URL;
        script.defer = true;
        script.setAttribute('data-awa-b2b-hydrate', '1');

        var target = d.head || d.documentElement;
        target.appendChild(cssA);
        target.appendChild(cssB);
        target.appendChild(script);
        return true;
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', inject, { once: true });
        w.addEventListener('load', function () { inject(); });
    } else {
        inject();
    }
}(window, document));
</script>
