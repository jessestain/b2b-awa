$useServerAuthHint = $isAccountSurface && $serverIsLoggedIn;
// Missão estabilização 2026-10-22: o SSR continua com o default de visitante nas
// páginas FPC (entrada de cache público — estado SSR não pode depender de cookie).
// O estado neutro para sessões com conteúdo privado é aplicado NO CLIENTE, antes
// do primeiro paint, pelo bloco awa.private.session.hint (html.awa-private-session).
$initialAuthState = $useServerAuthHint ? 'customer' : 'guest';
$initialGreeting = (string) __('Olá!');

if ($useServerAuthHint) {
    if ($serverFirstname !== '') {
        $initialGreeting = (string) __('Olá, %1!', $serverFirstname);
    } elseif ($serverFullname !== '') {
        $displayName = mb_strlen($serverFullname) > 20
            ? mb_substr($serverFullname, 0, 20) . '...'
            : $serverFullname;
        $initialGreeting = (string) __('Olá, %1!', $displayName);
