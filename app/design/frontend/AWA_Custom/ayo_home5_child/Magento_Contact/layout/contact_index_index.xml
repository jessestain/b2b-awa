<?xml version="1.0"?>
<!--
    AWA Motos — rota nativa /contact (Magento_Contact).
    SSOT shell: awa-cms-shell-final.css (container 1280px, prose 800px, spacing 4–16px)
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Fale Conosco</title>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.contact.seo.head"
                   template="Magento_Contact::awa-contact-seo-head.phtml"
                   before="-"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.cms.shell.final.contact"
                   template="Magento_Theme::html/awa-cms-shell-final-loader.phtml"
                   after="-"/>
        </referenceBlock>
        <referenceBlock name="awa.institutional.h1" remove="true"/>
        <!-- Magento way: PHTML + ViewModel no lugar do CMS awa_contact_header (span sem tel:). -->
        <referenceBlock name="awa.contact.header" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.contact.header.ssot"
                   template="Magento_Contact::awa-contact-header.phtml"
                   before="contactForm">
                <arguments>
                    <argument name="contact_info" xsi:type="object">GrupoAwamotos\Theme\ViewModel\ContactInfo</argument>
                </arguments>
            </block>
        </referenceContainer>
    

        
        <referenceBlock name="customer.section.config"
                        template="Magento_Theme::html/awa-customer-sections-defer.phtml">
            <arguments>
                <argument name="sectionNamesProvider" xsi:type="object">Magento\Customer\Block\SectionNamesProvider</argument>
                <argument name="auth" xsi:type="object">Magento\Customer\ViewModel\Customer\Auth</argument>
                <argument name="cookie_settings" xsi:type="object">Magento\Customer\ViewModel\CookieSettings</argument>
                <argument name="boot_immediate" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>

        
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.contact.customer.defer.loader"
                   template="Magento_Theme::html/awa-contact-customer-defer-loader.phtml"
                   after="-"/>
        </referenceContainer>

    
    </body>
</page>
