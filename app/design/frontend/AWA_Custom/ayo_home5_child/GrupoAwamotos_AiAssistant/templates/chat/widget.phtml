<script>
(function (w, d) {
    'use strict';
    if (w.__awaAiAssistantDeferInstalled) {
        return;
    }
    w.__awaAiAssistantDeferInstalled = true;
    var cfg = <?= /* @noEscape */ $widgetConfig ?>;
    var loaded = false;
    var intencaoDoUsuario = false;
    function apply() {
        if (loaded) {
            return;
        }
        loaded = true;
        function run() {
            if (typeof w.require !== 'function' || w.require._awaStub) {
                loaded = false;
                return;
            }
            w.require(['Magento_Ui/js/core/app'], function (app) {
                try {
                    app({
                        components: {
                            AwaAiChat: {
                                component: 'js/awa-ai-private-context-r3',
                                config: cfg
                            }
                        }
                    });
                } catch (e) { /* ignore */ }
                if (intencaoDoUsuario) {
                    intencaoDoUsuario = false;
                    reencaminharIntencao();
                }
            }, function () { loaded = false; });
        }
        if (typeof w.awaRunWhenRequire === 'function') {
            w.awaRunWhenRequire(run, { key: 'awa-ai-assistant-defer-plp' });
        } else {
            run();
        }
    }
    /* CONT-001 (v2) — o clique que "acorda" o modulo e consumido: o ko so ganha binding DEPOIS do
     * app(). A intencao do usuario e marcada em onFab (sem depender do tipo do argumento) e o
     * reenvio e AUTO-VERIFICAVEL: clica e confere se o painel abriu; se nao abriu, tenta de novo.
     *
     * MEDIDO na home (1 clique real, depois esta logica): 6 tentativas de 150ms (aprox. 900ms)
     * ate o painel abrir — UM UNICO reenvio NAO basta. E `window.ko` NAO existe nesta loja
     * (temKo=false), entao ko.dataFor NAO serve de condicao de prontidao. */
    function reencaminharIntencao() {
        var alvo = d.getElementById('assistente')
            || d.querySelector('#awa-ai-chat-root .awa-ai-chat__toggle, #awa-ai-chat-root .awa-ai-chat__launcher');
        if (!alvo) {
            return;
        }
        var tentativas = 0;
        function abriu() {
            return !!d.querySelector('.awa-ai-chat__panel--open');
        }
        function tentar() {
            tentativas += 1;
            if (abriu()) {
                return;
            }
            alvo.click();
            w.setTimeout(function () {
                if (abriu()) {
                    return;
                }
                if (tentativas < 12) {
                    tentar();
                }
            }, 150);
        }
        tentar();
    }

    function onFab(evt) {
        var t = evt.target && evt.target.closest && evt.target.closest('#assistente, #awa-ai-chat-root .awa-ai-chat__toggle, #awa-ai-chat-root .awa-ai-chat__launcher');
        if (!t) {
            return;
        }
        intencaoDoUsuario = true;
        apply();
    }
    d.addEventListener('click', onFab, true);
    ['pointerdown', 'keydown', 'touchstart'].forEach(function (evtName) {
        w.addEventListener(evtName, apply, { once: true, passive: true, capture: true });
    });
    function idleLoad() {
        apply();
    }
    if (w.requestIdleCallback) {
        w.requestIdleCallback(idleLoad, { timeout: 1000 });
    } else {
        w.setTimeout(idleLoad, 1000);
    }
})(window, document);
</script>
