<!-- Reserved navigation/footer launcher: no message is sent by opening. -->
<script>
(function () {
'use strict';
function mount() {
 var root=document.getElementById('awa-ai-chat-root'), original=document.getElementById('assistente');
 var mobile=document.querySelector('[data-awa-mobile-nav] .mobile-bottom-link');
 var desktop=document.querySelector('.awa-nav-quick-links__list');
 var footer=document.querySelector('footer.page-footer');
 if(!root||!original||!mobile||!desktop||!footer||document.querySelector('[data-awa-inline-ava]')) return;
 function button(label){var b=document.createElement('button');b.type='button';b.className='awa-inline-ava';b.setAttribute('data-awa-inline-ava','1');b.setAttribute('aria-label','Abrir Ava, assistente da AWA');b.setAttribute('aria-haspopup','dialog');b.textContent=label;b.addEventListener('click',function(){original.click();});return b;}
 var m=document.createElement('li');m.className='awa-inline-ava-mobile';m.appendChild(button('Ava'));mobile.appendChild(m);
 var d=document.createElement('li');d.className='awa-nav-quick-links__item awa-inline-ava-desktop';d.appendChild(button('Fale com Ava'));desktop.insertBefore(d,desktop.firstChild);
 var f=document.createElement('div');f.className='awa-inline-ava-footer';f.appendChild(button('Fale com Ava - assistente virtual'));footer.insertBefore(f,footer.firstChild);
 document.body.classList.add('awa-inline-ava-ready');
 function syncExpanded(){document.querySelectorAll('[data-awa-inline-ava]').forEach(function(b){b.setAttribute('aria-expanded',original.getAttribute('aria-expanded')==='true'?'true':'false');});}
 syncExpanded();new MutationObserver(syncExpanded).observe(original,{attributes:true,attributeFilter:['aria-expanded']});
}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',mount,{once:true});}else{mount();}
})();
</script>
