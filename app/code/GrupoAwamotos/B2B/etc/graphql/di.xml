<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\CatalogGraphQl\Model\PriceRangeDataProvider">
        <plugin name="grupoawamotos_b2b_hide_graphql_price_range"
                type="GrupoAwamotos\B2B\Plugin\GraphQl\HidePriceRangeDataPlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\Price">
        <plugin name="grupoawamotos_b2b_hide_graphql_legacy_price"
                type="GrupoAwamotos\B2B\Plugin\GraphQl\HideLegacyProductPricePlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\SpecialPrice">
        <plugin name="grupoawamotos_b2b_hide_graphql_special_price"
                type="GrupoAwamotos\B2B\Plugin\GraphQl\HideSpecialPricePlugin"
                sortOrder="10"/>
    </type>
</config>
