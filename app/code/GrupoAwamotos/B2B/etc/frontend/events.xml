<?xml version="1.0"?>
<!--
/**
 * Frontend-only B2B events.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="grupoawamotos_b2b_registration_submitted">
        <observer name="grupoawamotos_b2b_registration_enrichment"
                  instance="GrupoAwamotos\B2B\Observer\B2bRegistrationEnrichmentObserver"/>
        <observer name="grupoawamotos_b2b_form_registration_notification"
                  instance="GrupoAwamotos\B2B\Observer\CustomerRegistrationNotification"/>
    </event>

    <event name="customer_login">
        <observer name="grupoawamotos_b2b_customer_login"
                  instance="GrupoAwamotos\B2B\Observer\CustomerLoginObserver"/>
    </event>

    <event name="sales_order_place_after">
        <observer name="grupoawamotos_b2b_order_notification"
                  instance="GrupoAwamotos\B2B\Observer\OrderNotification"/>
        <!-- A alça de aprovação B2B NÃO fica mais aqui: sales_order_place_after dispara antes
             de o pedido ter entity_id e etc/frontend/events.xml não é carregado no admin/API.
             O gatilho foi movido para sales_order_save_after em etc/events.xml (área global). -->
    </event>

    <event name="checkout_submit_all_after">
        <observer name="grupoawamotos_b2b_mark_order_success_empty_cart"
                  instance="GrupoAwamotos\B2B\Observer\MarkOrderSuccessEmptyCartObserver"/>
    </event>

    <event name="checkout_onepage_controller_success_action">
        <observer name="grupoawamotos_b2b_mark_order_success_empty_cart_success_page"
                  instance="GrupoAwamotos\B2B\Observer\MarkOrderSuccessEmptyCartObserver"/>
    </event>

    <event name="checkout_cart_product_add_after">
        <observer name="grupoawamotos_b2b_clear_order_success_empty_cart"
                  instance="GrupoAwamotos\B2B\Observer\ClearOrderSuccessEmptyCartObserver"/>
    </event>

    <event name="catalog_product_collection_load_after">
        <observer name="grupoawamotos_b2b_price_cache_warm"
                  instance="GrupoAwamotos\B2B\Observer\B2BPriceWarmObserver"/>
    </event>

    <event name="controller_action_predispatch">
        <observer name="grupoawamotos_b2b_customer_group_refresh"
                  instance="GrupoAwamotos\B2B\Observer\CustomerGroupRefresh"/>
        <observer name="grupoawamotos_b2b_express_checkout_empty_cart_flag"
                  instance="GrupoAwamotos\B2B\Observer\ExpressCheckoutEmptyCartFlagObserver"/>
    </event>

</config>
