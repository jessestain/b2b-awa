    <!--
        Guard FormKey::set() on GET requests to prevent session_start() overhead on FPC HIT paths.
        RegisterFormKeyFromCookie::beforeDispatch() calls formKey->set() for any visitor with a
        form_key cookie, starting a PHP session even when FPC will serve the cached page.
        REQUIRES: bin/magento setup:di:compile
    -->
    <!-- FormKeySessionGuard desativado: bloqueava FormKey::set em GET e quebrava CSRF no login. -->
    <type name="Magento\Framework\Data\Form\FormKey">
        <plugin name="grupoawamotos_b2b_form_key_cookie_sync"
                type="GrupoAwamotos\B2B\Plugin\FormKeyCookieSyncPlugin"
                sortOrder="20"/>
    </type>

