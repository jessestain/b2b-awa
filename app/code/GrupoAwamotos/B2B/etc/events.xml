<?xml version="1.0"?>
<!--
/**
 * B2B Module Events Configuration (Global scope)
 * Frontend-specific observers are in etc/frontend/events.xml
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <!-- Aprovação de cliente B2B (custom event, fires from admin) -->
    <event name="grupoawamotos_b2b_customer_approved">
        <observer name="grupoawamotos_b2b_erp_approval_sync"
                  instance="GrupoAwamotos\B2B\Observer\ErpApprovalSyncObserver"/>
        <observer name="grupoawamotos_b2b_approval_whatsapp_notification"
                  instance="GrupoAwamotos\B2B\Observer\CustomerApprovalNotification"/>
        <observer name="grupoawamotos_b2b_company_auto_create"
                  instance="GrupoAwamotos\B2B\Observer\CustomerApprovedObserver"/>
        <observer name="grupoawamotos_b2b_attendant_assign_on_approval"
                  instance="GrupoAwamotos\B2B\Observer\AttendantAssignOnApprovalObserver"/>
    </event>

    <!-- Classificação CNAE + score de aprovação no save do cliente (admin + frontend).
         Ordem importa: CNAE grava b2b_cnae_* antes do scoring avaliar o perfil. -->
    <event name="customer_save_after_data_object">
        <observer name="grupoawamotos_b2b_company_profile_sync"
                  instance="GrupoAwamotos\B2B\Observer\CustomerApprovedObserver"/>
        <observer name="grupoawamotos_b2b_cnae_classification"
                  instance="GrupoAwamotos\B2B\Observer\CnaeClassificationObserver"/>
        <observer name="grupoawamotos_b2b_approval_scoring"
                  instance="GrupoAwamotos\B2B\Observer\ApprovalScoringObserver"/>
    </event>

    <!-- Notificação de mudança de status do pedido (admin area triggers) -->
    <event name="sales_order_save_after">
        <observer name="grupoawamotos_b2b_order_status_notification"
                  instance="GrupoAwamotos\B2B\Observer\OrderStatusNotification"/>
        <!-- Alçada B2B: gatilho da aprovação de pedidos por valor.
             Roda em sales_order_save_after (área global = frontend, adminhtml, webapi_rest,
             graphql, crontab) e SOMENTE no primeiro save do pedido recém-criado, porque
             sales_order_place_after dispara antes de o pedido ter entity_id (ver comentário
             do gate Sectra acima) e porque etc/frontend/events.xml não é carregado no admin.
             O próprio observer garante idempotência (não duplica solicitação) e recência
             (não retém pedido histórico salvo depois por sync de ERP/fatura/comentário).
             ORDEM IMPORTA: este observer vem ANTES do gate Sectra para que o pedido acima da
             alçada já esteja retido quando o gate Sectra avaliar — senão um pedido de R$ 237
             mil era marcado "liberado para Importar Pedidos" antes da aprovação interna. -->
        <observer name="grupoawamotos_b2b_order_approval_trigger"
                  instance="GrupoAwamotos\B2B\Observer\OrderPlaceAfterObserver"/>
        <!-- Gate Sectra Importar Pedidos: sales_order_place_after dispara ANTES do pedido
             ter entity_id (Order::place() roda antes do orderRepository->save() em
             Magento\Sales\Model\Service\OrderService::place()), então o guard de entity_id
             nunca passava ali. sales_order_save_after já ocorre com o pedido persistido;
             o observer só age no primeiro save (sectra_import_status ainda NULL) e ignora
             pedido retido (holded), que será reavaliado no save do unhold. -->
        <observer name="grupoawamotos_b2b_sectra_order_import_gate"
                  instance="GrupoAwamotos\B2B\Observer\SectraOrderImportGateObserver"/>
    </event>

    <!-- Cotações B2B (custom events) -->
    <event name="grupoawamotos_b2b_quote_submit_after">
        <observer name="grupoawamotos_b2b_quote_notification"
                  instance="GrupoAwamotos\B2B\Observer\QuoteNotification"/>
    </event>

    <event name="grupoawamotos_b2b_quote_response_after">
        <observer name="grupoawamotos_b2b_quote_response_notification"
                  instance="GrupoAwamotos\B2B\Observer\QuoteNotification"/>
    </event>

    <!-- Persistir preço Sectra no quote item (custom_price) — cobre frontend e webapi_rest -->
    <event name="sales_quote_product_add_after">
        <observer name="grupoawamotos_b2b_apply_erp_authorized_price_on_add"
                  instance="GrupoAwamotos\B2B\Observer\Quote\ApplyErpAuthorizedPriceOnAddObserver"/>
    </event>

    <!-- B2B-QA-001: alinhar options ERP no produto ANTES de representProduct() -->
    <event name="catalog_product_type_prepare_full_options">
        <observer name="grupoawamotos_b2b_align_erp_authorized_options_before_merge"
                  instance="GrupoAwamotos\B2B\Observer\Quote\AlignErpAuthorizedOptionsBeforeMergeObserver"/>
    </event>
    <event name="catalog_product_type_prepare_lite_options">
        <observer name="grupoawamotos_b2b_align_erp_authorized_options_before_merge_lite"
                  instance="GrupoAwamotos\B2B\Observer\Quote\AlignErpAuthorizedOptionsBeforeMergeObserver"/>
    </event>

    <event name="sales_quote_collect_totals_before">
        <observer name="grupoawamotos_b2b_ensure_erp_authorized_price_on_collect"
                  instance="GrupoAwamotos\B2B\Observer\Quote\EnsureErpAuthorizedPriceOnCollectObserver"/>
    </event>

    <!-- Copia PO number da cotação para o pedido -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="grupoawamotos_b2b_copy_po_number"
                  instance="GrupoAwamotos\B2B\Observer\CopyPoNumberToOrder"/>
        <observer name="grupoawamotos_b2b_validate_erp_readiness"
                  instance="GrupoAwamotos\B2B\Observer\ValidateB2bOrderErpReadinessObserver"/>
    </event>

    <!-- Private label: protege SKU de cliente ao salvar produto -->
    <event name="catalog_product_save_after">
        <observer name="grupoawamotos_b2b_private_label_product_save"
                  instance="GrupoAwamotos\B2B\Observer\PrivateLabelProductSave"/>
    </event>

    <event name="grupoawamotos_b2b_registration_submitted">
        
        <observer name="grupoawamotos_b2b_customer_register"
                  instance="GrupoAwamotos\B2B\Observer\CustomerRegisterObserver"/>
    
        
        <observer name="grupoawamotos_b2b_erp_registration_check"
                  instance="GrupoAwamotos\B2B\Observer\ErpRegistrationCheckObserver"/>
    </event>

</config>
