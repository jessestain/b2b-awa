<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="empty"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="b2b_auth_shell"/>
    <head>
        <title>Cadastro B2B - Pessoa Jurídica</title>
        <css src="GrupoAwamotos_B2B::css/account/register.css"/>
    </head>
    <body>
        <referenceBlock name="formkey" remove="true"/>
        <referenceBlock name="messages" remove="true"/>
        <referenceContainer name="main">
            <block class="GrupoAwamotos\B2B\Block\Register\Form" name="b2b.register.form" template="GrupoAwamotos_B2B::register/form.phtml" cacheable="false">
                <block class="GrupoAwamotos\B2B\Block\Account\AuthLogo"
                       name="auth.logo"
                       as="auth_logo"
                       template="GrupoAwamotos_B2B::html/auth-logo.phtml"/>
                <block class="Magento\Framework\View\Element\FormKey" name="b2b.register.form.key" as="b2b_form_key"/>
                <block class="Magento\Captcha\Block\Captcha"
                       name="b2b.register.captcha"
                       as="captcha"
                       cacheable="false">
                    <action method="setFormId">
                        <argument name="formId" xsi:type="string">user_create</argument>
                    </action>
                    <action method="setImgWidth">
                        <argument name="width" xsi:type="string">230</argument>
                    </action>
                    <action method="setImgHeight">
                        <argument name="height" xsi:type="string">50</argument>
                    </action>
                </block>
                <block class="GrupoAwamotos\B2B\Block\Account\SessionMessages"
                       name="b2b_register_messages"
                       as="b2b_register_messages"
                       template="GrupoAwamotos_B2B::account/login-messages.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
