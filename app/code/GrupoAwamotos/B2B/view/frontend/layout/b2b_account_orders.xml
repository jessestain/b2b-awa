<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <attribute name="class" value="b2b-account-orders"/>
        <!-- Evita H1 duplicado: título vem do template account/orders.phtml -->
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="GrupoAwamotos\B2B\Block\Account\Orders"
                   name="b2b.account.orders"
                   template="GrupoAwamotos_B2B::account/orders.phtml"/>
        </referenceContainer>
    </body>
</page>
