<?xml version="1.0"?>
<!--
  AWA B2B — PLP: ERP gate + LoginToCart (substitui add-to-cart nos cards para guest/pending).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="GrupoAwamotos_B2B::css/product/login-to-cart.css"/>
    </head>
    <body>
        <referenceBlock name="category.products.list">
            <arguments>
                <argument name="b2b_gate" xsi:type="object">GrupoAwamotos\B2B\ViewModel\PdpGate</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="GrupoAwamotos\B2B\Block\LoginToCart"
                   name="b2b.login.to.cart.category"
                   template="GrupoAwamotos_B2B::product/login-to-cart.phtml"
                   after="-"/>
        </referenceContainer>
    </body>
</page>
