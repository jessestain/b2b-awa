<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="empty"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="b2b_auth_shell"/>
    <head>
        <title>Recuperar senha</title>
    </head>
    <body>
        <referenceBlock name="messages" remove="true"/>
        <referenceContainer name="main">
            <block class="GrupoAwamotos\B2B\Block\Account\ForgotPassword"
                   name="b2b.account.forgotpassword"
                   template="GrupoAwamotos_B2B::account/forgot-password.phtml"
                   cacheable="false">
                <block class="GrupoAwamotos\B2B\Block\Account\AuthLogo"
                       name="auth.logo"
                       as="auth_logo"
                       template="GrupoAwamotos_B2B::html/auth-logo.phtml"/>
                <block class="Magento\Captcha\Block\Captcha"
                       name="b2b.account.forgot.captcha"
                       as="captcha"
                       cacheable="false">
                    <action method="setFormId">
                        <argument name="formId" xsi:type="string">user_forgotpassword</argument>
                    </action>
                    <action method="setImgWidth">
                        <argument name="width" xsi:type="string">230</argument>
                    </action>
                    <action method="setImgHeight">
                        <argument name="height" xsi:type="string">50</argument>
                    </action>
                </block>
                <block class="GrupoAwamotos\B2B\Block\Account\SessionMessages"
                       name="b2b_forgot_messages"
                       as="b2b_forgot_messages"
                       template="GrupoAwamotos_B2B::account/login-messages.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
