<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="2columns-left">
    <update handle="customer_account"/>
    <head>
        <css src="GrupoAwamotos_B2B::css/account/b2b-cotacao.css"/>
    </head>
    <body>
        <!-- Evita H1 duplicado: título vem do template cotacao/view.phtml -->
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="GrupoAwamotos\B2B\Block\Account\Cotacao\View"
                   name="b2b.cotacao.view"
                   template="GrupoAwamotos_B2B::cotacao/view.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
