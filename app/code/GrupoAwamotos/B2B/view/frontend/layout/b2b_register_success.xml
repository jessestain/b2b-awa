<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="empty"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="b2b_auth_shell"/>
    <head>
        <title>Cadastro Recebido</title>
        <css src="GrupoAwamotos_B2B::css/register/success.css"/>
    </head>
    <body>
        <referenceContainer name="main">
            <block class="GrupoAwamotos\B2B\Block\Register\Success"
                   name="b2b.register.success"
                   template="GrupoAwamotos_B2B::register/success.phtml"
                   cacheable="false">
                <block class="GrupoAwamotos\B2B\Block\Account\AuthLogo"
                       name="auth.logo"
                       as="auth_logo"
                       template="GrupoAwamotos_B2B::html/auth-logo.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
