<?xml version="1.0"?>
<!--
  AWA B2B — PDP: ERP gate + LoginToCart (modal + substituição do add-to-cart para guest/pending).
  Sem este bloco, a PDP renderiza "Adicionar ao Carrinho" visível/clicável para visitante
  (o POST ainda é bloqueado no server, mas a UX fica errada).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="GrupoAwamotos_B2B::css/product/login-to-cart.css"/>
    </head>
    <body>
        <referenceBlock name="catalog.product.related">
            <arguments>
                <argument name="b2b_gate" xsi:type="object">GrupoAwamotos\B2B\ViewModel\PdpGate</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="product.info.upsell">
            <arguments>
                <argument name="b2b_gate" xsi:type="object">GrupoAwamotos\B2B\ViewModel\PdpGate</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="product.info">
            <arguments>
                <argument name="b2b_gate" xsi:type="object">GrupoAwamotos\B2B\ViewModel\PdpGate</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="GrupoAwamotos\B2B\Block\LoginToCart"
                   name="b2b.login.to.cart.product"
                   template="GrupoAwamotos_B2B::product/login-to-cart.phtml"
                   after="-"/>
        </referenceContainer>
    </body>
</page>
