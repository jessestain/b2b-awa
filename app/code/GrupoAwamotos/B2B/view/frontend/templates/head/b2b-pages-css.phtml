<?php
/**
 * AWA B2B Pages — Late CSS Loader (non-blocking)
 * CSS crítico inline evita FOUC em páginas operacionais antes do late.css async.
 * Layout shell (§134/§136) vem de account-b2b.css — não duplicar aqui.
 */
declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
$cssUrl = $block->getViewFileUrl('GrupoAwamotos_B2B::css/account/awa-b2b-pages-late.css');
$salesUrl = $block->getViewFileUrl('GrupoAwamotos_B2B::css/account/pages-sales.css');
$ssotUrl = $block->getViewFileUrl('GrupoAwamotos_B2B::css/account/pages-core-v2.css');
$assetVersion = '20260817-v100-ssot';
?>
<style id="awa-b2b-pages-critical">
/* §148 critical — superfícies operacionais antes do late.css async */

/* 2026-07-16 critical: shell mobile account (anti FOUC overflow 590px) */
@media (max-width: 768px) {
    html body#html-body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .page-main > .columns > :is(
        .sidebar, .sidebar-main, [class*="col-sm-3"],
        .column.main, .col-main, [class*="col-sm-9"], [class*="col-"]
    ) {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        flex: 1 1 auto !important;
        box-sizing: border-box !important;
    }
}

/* Auth KO shell — nunca inline no portal logado (modal-only em catálogo/checkout) */
html body#html-body:is(.account, .b2b-account-dashboard, .b2b-account-shell) #authenticationPopup,
html body#html-body:is(.account, .b2b-account-dashboard, .b2b-account-shell) #authenticationPopup .block-authentication,
html body#html-body:is(.account, .b2b-account-dashboard, .b2b-account-shell) .page-wrapper > :is(#authenticationPopup, .block-authentication, .block.block-customer-login) {
    display: none !important;
    visibility: hidden !important;
    height: 0 !important;
    max-height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
}

html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .b2b-page-shell {
    display: flex !important;
    flex-direction: column !important;
    gap: clamp(12px, 1.5vw, 16px) !important;
}

html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper :is(
    .awa-empty-state,
    .b2b-empty-state,
    .b2b-cotacao-empty,
    .credit-card,
    .table-wrapper,
    .b2b-quote-wrapper
) {
    border-radius: var(--awa-radius-sm, 8px) !important;
    box-shadow: none !important;
}

@media (max-width: 1024px) {
    html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .page-main,
    html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .b2b-breadcrumbs-container {
        padding-inline: var(--awa-page-pad-tablet, 16px) !important;
    }
}

@media (max-width: 768px) {
    html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .page-main > :is(.columns, .columns.layout) {
        display: flex !important;
        flex-direction: column !important;
        gap: clamp(12px, 1.5vw, 16px) !important;
    }

    html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .page-main,
    html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .b2b-breadcrumbs-container {
        padding-inline: var(--awa-page-pad-mobile, 12px) !important;
    }
}

html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper :is(.data.table th, table thead th) {
    text-transform: none !important;
    font-size: 13px !important;
    background: var(--awa-neutral-50, var(--awa-bg-muted)) !important;
}

html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper :is(
    .b2b-quote-wrapper,
    .table-wrapper,
    .box,
    .b2b-shortcut-card
):hover {
    box-shadow: none !important;
    transform: none !important;
}

html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .b2b-quote-form-container :is(
    .b2b-quote-items,
    .b2b-quote-form,
    .b2b-quote-wrapper
) {
    border-radius: var(--awa-radius-sm, 8px) !important;
    box-shadow: none !important;
}

html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .b2b-quote-form-container .action.primary {
    min-height: 44px !important;
    border-radius: var(--awa-radius-sm, 8px) !important;
    box-shadow: none !important;
}

/* §152 critical — header/page-top spacing antes do late.css async */
html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .page-top {
    padding-block: clamp(8px, 1vw, 12px) 0 !important;
    margin: 0 !important;
}

html body#html-body:is(.account, [class*="b2b-"]) .page-wrapper .page-main {
    padding-top: clamp(12px, 1.5vw, 16px) !important;
}

/* Header layout pertence à cascata global do tema; páginas B2B não compactam .awa-site-header. */
</style>
<script>
(function () {
    'use strict';
    var body = document.body;
    if (!body || !body.classList.contains('account')) {
        return;
    }
    var popup = document.getElementById('authenticationPopup');
    if (popup) {
        popup.remove();
    }
    document.querySelectorAll(
        '.page-wrapper > #authenticationPopup, .page-wrapper > .block-authentication, .page-wrapper > .block.block-customer-login'
    ).forEach(function (node) {
        if (!node.closest('.modal-popup._show')) {
            node.remove();
        }
    });
})();
</script>
<link rel="stylesheet"
      href="<?= $block->escapeUrl($cssUrl) ?>?v=<?= $block->escapeHtmlAttr($assetVersion) ?>"
      media="print"
      onload="this.media='all'"/>
<link rel="stylesheet"
      href="<?= $block->escapeUrl($salesUrl) ?>?v=<?= $block->escapeHtmlAttr($assetVersion) ?>"
      media="print"
      onload="this.media='all'"/>
<link rel="stylesheet"
      href="<?= $block->escapeUrl($ssotUrl) ?>?v=<?= $block->escapeHtmlAttr($assetVersion) ?>"
      media="all"/>
<noscript>
    <link rel="stylesheet"
          href="<?= $block->escapeUrl($cssUrl) ?>?v=<?= $block->escapeHtmlAttr($assetVersion) ?>"/>
    <link rel="stylesheet"
          href="<?= $block->escapeUrl($salesUrl) ?>?v=<?= $block->escapeHtmlAttr($assetVersion) ?>"/>
    <link rel="stylesheet"
