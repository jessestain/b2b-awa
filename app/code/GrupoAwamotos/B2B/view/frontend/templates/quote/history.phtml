<?php
/**
 * Quote History Template
 *
 * @var \GrupoAwamotos\B2B\Block\Quote\History $block
 */
?>
<div class="b2b-quote-history b2b-page-shell">
    <div class="b2b-section-header">
        <h1><?= $block->escapeHtml(__('Minhas cotações')) ?></h1>
        <p class="section-subtitle"><?= $block->escapeHtml(__('Acompanhe orçamentos solicitados, status e validade.')) ?></p>
        <?php if ($block->hasQuoteRequests()): ?>
            <a href="<?= $block->escapeUrl($block->getUrl('b2b/quote')) ?>" class="action primary">
                <span><?= $block->escapeHtml(__('Solicitar cotação')) ?></span>
            </a>
        <?php endif; ?>
    </div>

    <?php if (!$block->hasQuoteRequests()): ?>
        <div class="awa-empty-state" role="status" aria-live="polite">
            <p class="awa-empty-state__title"><?= $block->escapeHtml(__('Nenhuma cotação solicitada')) ?></p>
            <p class="awa-empty-state__hint"><?= $block->escapeHtml(__('Monte o carrinho e peça um orçamento formal.')) ?></p>
            <div class="awa-empty-state__actions">
                <a href="<?= $block->escapeUrl($block->getUrl('b2b/quote')) ?>" class="action primary">
                    <span><?= $block->escapeHtml(__('Solicitar cotação')) ?></span>
                </a>
            </div>
        </div>
    <?php else: ?>
        <div class="table-wrapper quote-history">
            <table class="data table table-quote-history"
                   id="quote-history-table"
                   aria-label="<?= $block->escapeHtmlAttr(__('Tabela de histórico de cotações')) ?>">
                <caption class="table-caption sr-only"><?= $block->escapeHtml(__('Minhas Cotações')) ?></caption>
                <thead>
                    <tr>
                        <th scope="col" class="col id"><?= $block->escapeHtml(__('Nº')) ?></th>
                        <th scope="col" class="col date"><?= $block->escapeHtml(__('Data')) ?></th>
                        <th scope="col" class="col status"><?= $block->escapeHtml(__('Status')) ?></th>
                        <th scope="col" class="col total"><?= $block->escapeHtml(__('Valor')) ?></th>
                        <th scope="col" class="col expires"><?= $block->escapeHtml(__('Validade')) ?></th>
                        <th scope="col" class="col actions"><?= $block->escapeHtml(__('Ações')) ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($block->getQuoteRequests() as $quote): ?>
                        <?php
                        $statusClass = '';
                        switch ($quote->getStatus()) {
                            case 'approved':
                            case 'quoted':
                                $statusClass = 'status-success';
                                break;
                            case 'pending':
                            case 'processing':
                                $statusClass = 'status-pending';
                                break;
                            case 'rejected':
                            case 'expired':
                                $statusClass = 'status-failed';
                                break;
                            case 'converted':
                                $statusClass = 'status-complete';
                                break;
                        }
                        ?>
                        <tr>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Nº')) ?>" class="col id">
                                #<?= (int) $quote->getRequestId() ?>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Data')) ?>" class="col date">
                                <?= $block->escapeHtml($block->formatQuoteDate($quote->getCreatedAt())) ?>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Status')) ?>" class="col status">
                                <span class="quote-status <?= $block->escapeHtmlAttr($statusClass) ?>">
                                    <?= $block->escapeHtml($quote->getStatusLabel()) ?>
                                </span>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Valor')) ?>" class="col total">
                                <?php if ($quote->getQuotedTotal()): ?>
                                    <?= /* @noEscape */ $block->formatPrice($quote->getQuotedTotal()) ?>
                                <?php else: ?>
                                    <span class="no-value"><?= $block->escapeHtml(__('Aguardando')) ?></span>
                                <?php endif; ?>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Validade')) ?>" class="col expires">
                                <?php if ($quote->getExpiresAt()): ?>
                                    <?php if ($quote->isExpired()): ?>
                                        <span class="expired"><?= $block->escapeHtml(__('Expirada')) ?></span>
                                    <?php else: ?>
                                        <?= $block->escapeHtml($block->formatQuoteDate($quote->getExpiresAt())) ?>
                                    <?php endif; ?>
                                <?php else: ?>
                                    -
                                <?php endif; ?>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Ações')) ?>" class="col actions">
                                <a href="<?= $block->escapeUrl($block->getViewUrl($quote->getRequestId())) ?>"
                                   class="action view"
                                   title="<?= $block->escapeHtmlAttr(__('Ver detalhes da cotação %1', (int) $quote->getRequestId())) ?>"
                                   aria-label="<?= $block->escapeHtmlAttr(__('Ver detalhes da cotação %1', (int) $quote->getRequestId())) ?>">
                                    <span><?= $block->escapeHtml(__('Ver')) ?></span>
                                </a>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
