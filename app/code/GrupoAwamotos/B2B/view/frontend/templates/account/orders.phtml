<?php
/** @var \GrupoAwamotos\B2B\Block\Account\Orders $block */
/** @var \Magento\Framework\Escaper $escaper */
// $escaper is auto-injected by Magento 2.4+ template engine

$orders = $block->getOrders();
?>

<div class="account b2b-orders-page b2b-page-shell">

    <div class="b2b-section-header">
        <h1><?= $escaper->escapeHtml(__('Meus Pedidos B2B')) ?></h1>
        <p class="section-subtitle"><?= $escaper->escapeHtml(__('Histórico da loja com status, total e sincronização ERP.')) ?></p>
        <a href="<?= $escaper->escapeUrl($block->getUrl('b2b/account')) ?>" class="action secondary">
            <span><?= $escaper->escapeHtml(__('Voltar para Conta B2B')) ?></span>
        </a>
    </div>

    <?php if (empty($orders)): ?>
        <div class="b2b-section">
            <div class="awa-empty-state" role="status" aria-live="polite">
                <p class="awa-empty-state__title"><?= $escaper->escapeHtml(__('Você ainda não realizou pedidos')) ?></p>
                <p class="awa-empty-state__hint"><?= $escaper->escapeHtml(__('Assim que um pedido for finalizado, ele aparecerá neste histórico com status e total.')) ?></p>
                <div class="awa-empty-state__actions">
                    <a href="<?= $escaper->escapeUrl($block->getUrl('catalog')) ?>"
                       class="action primary">
                        <span><?= $escaper->escapeHtml(__('Explorar catálogo')) ?></span>
                    </a>
                </div>
            </div>
        </div>
        <?php else: ?>

        <div class="b2b-section">
            <div class="section-header">
                <h2><?= $escaper->escapeHtml(__('Histórico de Pedidos')) ?></h2>
            </div>
            <div class="table-wrapper b2b-table-scroll">
            <table class="data-table" aria-label="<?= $escaper->escapeHtmlAttr(__('Histórico de pedidos B2B')) ?>">
                <caption class="table-caption sr-only"><?= $escaper->escapeHtml(__('Histórico de pedidos B2B')) ?></caption>
                <thead>
                    <tr>
                        <th scope="col"><?= $escaper->escapeHtml(__('Pedido')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Data')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Status')) ?></th>
                        <th scope="col" class="col-total"><?= $escaper->escapeHtml(__('Total')) ?></th>
                        <th scope="col" class="col-erp"><?= $escaper->escapeHtml(__('ERP Sectra')) ?></th>
                        <th scope="col" class="col-actions"><?= $escaper->escapeHtml(__('Ações')) ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($orders as $order):
                    /** @var \Magento\Sales\Model\Order $order */
                    $erp       = $block->getErpSync((int) $order->getId());
                    $erpStatus = $erp['sync_status'] ?? '';
                    $erpRef    = $erp['erp_reference'] ?? '';
                    $orderStatus = strtolower($order->getStatus());
                    $statusBadgeClass = match (true) {
                        in_array($orderStatus, ['pending', 'pending_payment'], true) => 'status-pending',
                        in_array($orderStatus, ['processing'], true)                 => 'status-processing',
                        in_array($orderStatus, ['complete'], true)                   => 'status-success',
                        in_array($orderStatus, ['canceled', 'closed'], true)         => 'status-failed',
                        default                                                 => 'status-pending',
                    };
                ?>
                    <tr>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Pedido')) ?>">
                            <strong>#<?= $escaper->escapeHtml($order->getIncrementId()) ?></strong>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Data')) ?>"><?= $escaper->escapeHtml(
                            $block->formatDateTime((string) $order->getCreatedAt())
                        ) ?></td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Status')) ?>">
                            <span class="status-badge <?= $escaper->escapeHtmlAttr($statusBadgeClass) ?>">
                                <?= $escaper->escapeHtml($order->getStatusLabel()) ?>
                            </span>
                        </td>
                        <td class="col-total" data-th="<?= $escaper->escapeHtmlAttr(__('Total')) ?>">
                            <?= /* @noEscape */ $block->formatPrice((float) $order->getGrandTotal()) ?>
                        </td>
                        <td class="col-erp" data-th="<?= $escaper->escapeHtmlAttr(__('ERP Sectra')) ?>">
                            <?php if ($erpStatus): ?>
                                <span class="status-badge <?= $escaper->escapeHtmlAttr(
                                    match ($erpStatus) {
                                        'synced'  => 'status-success',
                                        'pending' => 'status-pending',
                                        'error'   => 'status-failed',
                                        default   => 'status-pending',
                                    }
                                ) ?>">
                                    <?= $escaper->escapeHtml($block->getErpStatusLabel($erpStatus)) ?>
                                </span>
                                <?php if ($erpRef): ?>
                                <div class="erp-ref">
                                    <?= $escaper->escapeHtml($erpRef) ?>
                                </div>
                                <?php endif; ?>
                            <?php else: ?>
                                <span class="erp-empty">—</span>
                            <?php endif; ?>
                        </td>
                        <td class="col-actions" data-th="<?= $escaper->escapeHtmlAttr(__('Ações')) ?>">
                            <a href="<?= $escaper->escapeUrl($block->getOrderUrl($order)) ?>"
                               class="action view"
                               aria-label="<?= $escaper->escapeHtmlAttr(__('Ver pedido %1', $order->getIncrementId())) ?>">
                                <?= $escaper->escapeHtml(__('Ver')) ?> <span aria-hidden="true">→</span>
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
            </div><!-- .table-wrapper.b2b-table-scroll -->
        </div>

    <?php endif; ?>
</div>
