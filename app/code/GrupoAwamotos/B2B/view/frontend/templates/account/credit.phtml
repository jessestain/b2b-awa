<?php
/** @var \GrupoAwamotos\B2B\Block\Account\Credit $block */
$credit = $block->getCreditLimit();
$transactions = $block->getTransactions();
$usagePercent = $block->getUsagePercent();
$usage = min(100.0, (float) $usagePercent);
$creditLimit = $credit ? (float) $credit->getCreditLimit() : 0.0;
$usedCredit = $credit ? (float) $credit->getUsedCredit() : 0.0;
$availableCredit = $credit ? (float) $credit->getAvailableCredit() : 0.0;
?>
<div class="b2b-credit-page b2b-page-shell"
     data-mage-init='<?= /* @noEscape */ json_encode(
         ['GrupoAwamotos_B2B/js/account/credit-usage' => new \stdClass()],
         JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
     ) ?>'>
    <div class="b2b-section-header">
        <h1><?= $block->escapeHtml(__('Meu Crédito B2B')) ?></h1>
        <p class="section-subtitle"><?= $block->escapeHtml(__('Limite disponível, uso atual e histórico de movimentações.')) ?></p>
    </div>

    <!-- Resumo de Crédito -->
    <div class="credit-summary-cards">
        <div class="credit-card credit-card--limit">
            <span class="credit-card__label"><?= $block->escapeHtml(__('Limite Total')) ?></span>
            <span class="credit-card__value"><?= /* @noEscape */ $block->formatPrice($creditLimit) ?></span>
        </div>
        <div class="credit-card credit-card--used">
            <span class="credit-card__label"><?= $block->escapeHtml(__('Utilizado')) ?></span>
            <span class="credit-card__value"><?= /* @noEscape */ $block->formatPrice($usedCredit) ?></span>
        </div>
        <div class="credit-card credit-card--available">
            <span class="credit-card__label"><?= $block->escapeHtml(__('Disponível')) ?></span>
            <span class="credit-card__value"><?= /* @noEscape */ $block->formatPrice($availableCredit) ?></span>
        </div>
    </div>

    <!-- Barra de Uso -->
    <div class="credit-usage-bar">
        <div class="credit-usage-bar__label">
            <span><?= $block->escapeHtml(__('Uso do Crédito')) ?></span>
            <span><?= $block->escapeHtml((string) (int) round((float) $usage)) ?>%</span>
        </div>
        <div class="credit-usage-bar__track"
             role="progressbar"
             aria-label="<?= $block->escapeHtmlAttr(__('Uso do crédito')) ?>"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuenow="<?= $block->escapeHtmlAttr((string) $usage) ?>">
            <div class="credit-usage-bar__fill <?= $usagePercent > 80 ? 'credit-usage-bar__fill--warning' : '' ?>"
                 data-usage-percent="<?= $block->escapeHtmlAttr((string) $usage) ?>"></div>
        </div>
    </div>

    <!-- Histórico de Transações -->
    <div class="credit-transactions">
        <h2><?= $block->escapeHtml(__('Histórico de Transações')) ?></h2>

        <?php if ($transactions->getSize() > 0): ?>
            <div class="table-wrapper">
            <table class="data table table-credit-transactions" aria-label="<?= $block->escapeHtmlAttr(__('Histórico de transações de crédito')) ?>">
                <caption class="table-caption sr-only"><?= $block->escapeHtml(__('Histórico de transações de crédito')) ?></caption>
                <thead>
                    <tr>
                        <th scope="col"><?= $block->escapeHtml(__('Data')) ?></th>
                        <th scope="col"><?= $block->escapeHtml(__('Tipo')) ?></th>
                        <th scope="col"><?= $block->escapeHtml(__('Valor')) ?></th>
                        <th scope="col"><?= $block->escapeHtml(__('Saldo Após')) ?></th>
                        <th scope="col"><?= $block->escapeHtml(__('Referência')) ?></th>
                        <th scope="col"><?= $block->escapeHtml(__('Observação')) ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($transactions as $txn): ?>
                        <?php $amount = (float) $txn->getData('amount'); ?>
                        <tr>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Data')) ?>">
                                <?= $block->escapeHtml($block->formatDateTime((string) $txn->getData('created_at'))) ?>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Tipo')) ?>">
                                <span class="txn-type txn-type--<?= $block->escapeHtmlAttr($txn->getData('type')) ?>">
                                    <?= $block->escapeHtml($block->getTransactionTypeLabel($txn->getData('type'))) ?>
                                </span>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Valor')) ?>" class="<?= $amount >= 0 ? 'txn-positive' : 'txn-negative' ?>">
                                <?= $amount >= 0 ? '+' : '' ?><?= /* @noEscape */ $block->formatPrice($amount) ?>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Saldo')) ?>">
                                <?= /* @noEscape */ $block->formatPrice((float) $txn->getData('balance_after')) ?>
                            </td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Ref')) ?>"><?= $block->escapeHtml($txn->getData('reference')) ?></td>
                            <td data-th="<?= $block->escapeHtmlAttr(__('Obs')) ?>"><?= $block->escapeHtml($txn->getData('comment')) ?></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
            </div>
        <?php else: ?>
            <div class="awa-empty-state" role="status" aria-live="polite">
                <p class="awa-empty-state__title"><?= $block->escapeHtml(__('Nenhuma movimentação ainda')) ?></p>
                <p class="awa-empty-state__hint"><?= $block->escapeHtml(__('Compras e pagamentos com crédito aparecem aqui.')) ?></p>
            </div>
        <?php endif; ?>
    </div>
</div>
