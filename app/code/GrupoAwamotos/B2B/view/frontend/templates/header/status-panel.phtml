<?php
/**
 * B2B Header Status Panel — logged-in B2B customers only.
 * Guest login/register: awa-header-account-prompt (theme header).
 *
 * @var \GrupoAwamotos\B2B\Block\Header\StatusPanel $block
 */
?>

<?php if (!$block->shouldDisplay()): ?>
    <?php return; ?>
<?php endif; ?>
<?php $data = $block->getCustomerData(); ?>
<?php
    $company = trim((string) ($data['company'] ?? ''));
    $firstName = (string) ($data['first_name'] ?? ''); // raw — escaped at output via escapeHtml()
    $fullName = trim((string) ($data['full_name'] ?? ''));
    $badgeColor = $block->escapeHtmlAttr((string) ($data['group_badge']['color'] ?? ''));
    $badgeIcon = $block->escapeHtmlAttr((string) ($data['group_badge']['icon'] ?? 'user'));
    $groupName = $block->escapeHtml((string) ($data['group_name'] ?? ''));
    $discount = (int) ($data['discount'] ?? 0);
    $creditLimit = (float) ($data['credit_limit'] ?? 0);
    $creditAvailable = (float) ($data['credit_available'] ?? 0);
    $logoutUrl = $block->getUrl('customer/account/logout');
    $normalizeIdentity = static function (string $value): string {
        return mb_strtolower(trim(preg_replace('/\s+/u', ' ', $value) ?? ''));
    };
    $nameEqualsCompany = $company !== '' && $fullName !== ''
        && $normalizeIdentity($fullName) === $normalizeIdentity($company);
    $displayName = ($nameEqualsCompany && $firstName !== '')
        ? $firstName
        : ($fullName !== '' ? $fullName : $firstName);
    $showCompanyLine = $company !== ''
        && $normalizeIdentity($displayName) !== $normalizeIdentity($company);
    $companyStartsWithFirst = $normalizeIdentity($firstName) !== ''
        && $normalizeIdentity($company) !== ''
        && str_starts_with($normalizeIdentity($company), $normalizeIdentity($firstName));
    $triggerCompanyVisible = $company !== '' && !$companyStartsWithFirst;
    $triggerAria = trim((string) __('Olá, %1', $firstName));
    if ($triggerCompanyVisible) {
        $triggerAria .= ' — ' . $company;
    } elseif ((string) ($data['group_name'] ?? '') !== '') {
        $triggerAria .= ' — ' . (string) $data['group_name'];
    }
?>
<div class="b2b-status-panel"
     data-mage-init='{"GrupoAwamotos_B2B/js/header-status-panel": {}}'
     role="region"
     aria-label="<?= $block->escapeHtmlAttr(__('Painel B2B')) ?>">

    <!-- Trigger Button -->
    <button type="button"
            class="b2b-status-trigger"
            aria-expanded="false"
            aria-controls="b2b-status-dropdown"
            aria-haspopup="true"
            aria-label="<?= $block->escapeHtmlAttr($triggerAria) ?>">
        <span class="status-badge"
              data-badge-color="<?= $badgeColor ?>"
              aria-hidden="true">
            <i class="fa fa-<?= /* @noEscape */ $badgeIcon ?>" aria-hidden="true"></i>
        </span>
        <span class="status-info" aria-hidden="true">
            <span class="status-greeting"><?= $block->escapeHtml(__('Olá, %1', $firstName)) ?></span>
            <?php if ($triggerCompanyVisible): ?>
            <span class="status-company"><?= $block->escapeHtml($company) ?></span>
            <?php endif; ?>
            <span class="status-group">
                <?= $groupName ?>
                <?php if ($discount > 0): ?>
                <span class="status-discount">-<?= $discount ?>%</span>
                <?php endif; ?>
            </span>
        </span>
        <i class="fa fa-chevron-down status-arrow" aria-hidden="true"></i>
    </button>

    <!-- Dropdown Panel -->
    <div id="b2b-status-dropdown" class="b2b-status-dropdown" aria-hidden="true">
        <div class="dropdown-inner">

            <!-- User Info Section -->
            <div class="dropdown-section user-section">
                <div class="user-avatar" data-avatar-color="<?= $badgeColor ?>">
                    <?= $block->escapeHtml(mb_strtoupper(mb_substr($firstName, 0, 1))) ?>
                </div>
                <div class="user-details">
                    <span class="user-name"><?= $block->escapeHtml($displayName) ?></span>
                    <?php if ($showCompanyLine): ?>
                    <span class="user-company">
                        <i class="fa fa-building-o" aria-hidden="true"></i>
                        <?= $block->escapeHtml($company) ?>
                    </span>
                    <?php endif; ?>
                    <span class="user-tier" data-tier-color="<?= $badgeColor ?>">
                        <i class="fa fa-<?= /* @noEscape */ $badgeIcon ?>" aria-hidden="true"></i>
                        <?= $groupName ?>
                    </span>
                </div>
            </div>

            <!-- Stats Section -->
            <?php if ($discount > 0 || $creditLimit > 0): ?>
            <div class="dropdown-section stats-section">
                <?php if ($discount > 0): ?>
                <div class="stat-item discount-stat">
                    <span class="stat-icon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                    <span class="stat-content">
                        <span class="stat-value">-<?= $discount ?>%</span>
                        <span class="stat-label"><?= $block->escapeHtml(__('Desconto Exclusivo')) ?></span>
                    </span>
                </div>
                <?php endif; ?>

                <?php if ($creditLimit > 0): ?>
                <div class="stat-item credit-stat">
                    <span class="stat-icon"><i class="fa fa-credit-card" aria-hidden="true"></i></span>
                    <span class="stat-content">
                        <span class="stat-value"><?= /* @noEscape */ $block->formatPrice($creditAvailable) ?></span>
                        <span class="stat-label"><?= $block->escapeHtml(__('Crédito Disponível')) ?></span>
                    </span>
                    <div class="credit-bar">
                        <?php $creditPercent = $creditLimit > 0 ? ($creditAvailable / $creditLimit) * 100 : 0; ?>
                        <div class="credit-bar-fill" data-credit-width="<?= min(100, (int) $creditPercent) ?>"></div>
                    </div>
                </div>
                <?php endif; ?>
            </div>
            <?php endif; ?>

            <!-- Quick Actions -->
            <div class="dropdown-section actions-section">
                <span class="section-title"><?= $block->escapeHtml(__('Acesso Rápido')) ?></span>
                <nav class="quick-actions" aria-label="<?= $block->escapeHtmlAttr(__('Ações rápidas B2B')) ?>">
                    <?php foreach ($block->getQuickActions() as $action): ?>
                    <a href="<?= $block->escapeUrl($action['url']) ?>"
                       class="quick-action-link"
                       aria-label="<?= $block->escapeHtmlAttr((string) $action['label']) ?>">
                        <i class="fa fa-<?= $block->escapeHtmlAttr($action['icon']) ?>" aria-hidden="true"></i>
                        <span><?= $block->escapeHtml($action['label']) ?></span>
                    </a>
                    <?php endforeach; ?>
                </nav>
            </div>

            <!-- Footer -->
            <div class="dropdown-footer">
                <a href="<?= $block->escapeUrl($block->getUrl('b2b/account/dashboard')) ?>" class="footer-link account-link">
                    <i class="fa fa-user-circle-o" aria-hidden="true"></i>
                    <?= $block->escapeHtml(__('Minha Conta')) ?>
                </a>
                <a href="<?= $block->escapeUrl($logoutUrl) ?>"
                   class="footer-link logout-link"
                   data-post='<?= $block->escapeHtmlAttr((string) json_encode(
                       [
                           'action' => $logoutUrl,
                           'data' => ['uenc' => '']
                       ],
                       JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
                   )) ?>'>
                    <i class="fa fa-sign-out" aria-hidden="true"></i>
                    <?= $block->escapeHtml(__('Sair')) ?>
                </a>
            </div>
        </div>
    </div>
</div>
