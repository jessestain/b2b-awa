<?php
declare(strict_types=1);

/**
 * B2B/conta: inicializa customer-data cedo (minicart + header) sem esperar idle/home defer.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
?>
<script>
(function (w, d) {
    'use strict';

    if (w.__awaB2bCustomerEagerInit) {
        return;
    }
    w.__awaB2bCustomerEagerInit = true;

    function applyOperationalHeader() {
        var header = d.querySelector('.awa-site-header');
        var sticky = d.querySelector('.header-wrapper-sticky');

        if (header) {
            header.classList.add('awa-header-condensed', 'awa-account-header');
        }
        if (sticky) {
            sticky.classList.add('awa-header-condensed', 'is-sticky');
        }
    }

    function boot() {
        applyOperationalHeader();

        if (typeof w.require !== 'function') {
            w.setTimeout(boot, 40);
            return;
        }

        w.require([
            'Magento_Customer/js/customer-data',
            'GrupoAwamotos_B2B/js/account/nav-mobile'
        ], function (customerData, initNavMobile) {
            customerData.get('customer');
            customerData.get('cart');

            if (typeof initNavMobile === 'function') {
                initNavMobile();
            }

            bindCollapsedAccountNav();

            if (typeof w.CustomEvent === 'function') {
                d.dispatchEvent(new w.CustomEvent('awa:customer-data-ready'));
            }
        });
    }

    /**
     * CDP 375: nav-mobile.min.js em cache imutável abre "Minha Conta"
     * (expanded=true por .current). CSS só mostra .content com
     * .awa-nav--user-open; este bind não depende do .min.js.
     */
    function bindCollapsedAccountNav() {
        if (!w.matchMedia('(max-width: 767px)').matches) {
            return;
        }

        var nav = d.querySelector('.block-collapsible-nav, .block.account-nav');
        if (!nav) {
            return;
        }

        nav.classList.add('awa-nav--mobile-collapsible');
        if (!nav.classList.contains('awa-nav--user-open')) {
            nav.classList.remove('awa-nav--expanded');
        }

        var title = nav.querySelector(':scope > .title, :scope > .block-title');
        if (title && !title.dataset.awaNavUserBind) {
            title.dataset.awaNavUserBind = '1';
            title.setAttribute('aria-expanded', 'false');
            title.addEventListener('click', function (event) {
                event.stopImmediatePropagation();
                var open = !nav.classList.contains('awa-nav--user-open');
                nav.classList.toggle('awa-nav--user-open', open);
                nav.classList.toggle('awa-nav--expanded', open);
                title.setAttribute('aria-expanded', open ? 'true' : 'false');
            }, true);
            title.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter' && event.key !== ' ') {
                    return;
                }
                event.preventDefault();
                event.stopImmediatePropagation();
                var open = !nav.classList.contains('awa-nav--user-open');
                nav.classList.toggle('awa-nav--user-open', open);
                nav.classList.toggle('awa-nav--expanded', open);
                title.setAttribute('aria-expanded', open ? 'true' : 'false');
            }, true);
        }

    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
        boot();
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', bindCollapsedAccountNav, { once: true });
    } else {
        bindCollapsedAccountNav();
    }
    w.setTimeout(bindCollapsedAccountNav, 400);
    w.setTimeout(bindCollapsedAccountNav, 1200);
}(window, document));
</script>
