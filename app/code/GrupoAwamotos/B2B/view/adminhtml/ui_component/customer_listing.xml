<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"
                  class="GrupoAwamotos\B2B\Ui\Component\Listing\CustomerListingBookmark"/>
    </listingToolbar>
    <columns name="customer_columns"
             class="GrupoAwamotos\B2B\Ui\Component\Listing\CustomerColumns">
        <column name="taxvat"
                class="GrupoAwamotos\B2B\Ui\Component\Listing\Column\CustomerDocument"
                sortOrder="65">
            <settings>
                <filter>text</filter>
                <label translate="true">CPF/CNPJ</label>
                <visible>true</visible>
            </settings>
        </column>
        <column name="b2b_cnpj">
            <settings>
                <label translate="true">CNPJ</label>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
