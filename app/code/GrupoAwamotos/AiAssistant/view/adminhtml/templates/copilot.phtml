<script>
require(['jquery'], function ($) {
    'use strict';

    var config   = <?= /* @noEscape */ $block->getCopilotConfigJson() ?>;
    var history  = [];
    var $messages = $('#awa-copilot-messages');
    var $input    = $('#awa-copilot-input');
    var $send     = $('#awa-copilot-send');
    var $error    = $('#awa-copilot-error');

    function scrollToBottom() {
        setTimeout(function () {
            $messages[0].scrollTop = $messages[0].scrollHeight;
        }, 60);
    }

    // Markdown mínimo e seguro: escapa TUDO e só então liga **negrito** e
    // títulos "### " (o modelo responde em markdown; texto puro mostrava **).
    function renderReply(content) {
        var html = $('<div>').text(content).html();
        html = html.replace(/^#{1,4}\s*(.+)$/gm, '<strong>$1</strong>');
        return html.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
    }

    function addMessage(role, content) {
        var $msg  = $('<div class="awa-copilot-msg awa-copilot-msg--' + role + '"></div>');
        var $bubble = $('<div class="awa-copilot-msg__bubble"></div>');
        if (role === 'assistant') {
            $bubble.html(renderReply(content));
        } else {
            $bubble.text(content);
        }
        $msg.append($bubble);
        $messages.append($msg);
        scrollToBottom();
        return $msg;
    }

    function addTypingIndicator() {
        var $msg = $('<div class="awa-copilot-msg awa-copilot-msg--assistant awa-copilot-msg--typing"></div>');
        var $bubble = $('<div class="awa-copilot-msg__bubble"><span></span><span></span><span></span></div>');
        $msg.append($bubble);
        $messages.append($msg);
        scrollToBottom();
        return $msg;
    }

    function sendMessage(text) {
        text = (text || '').trim();
        if (!text) { return; }

        $error.hide().text('');
        addMessage('user', text);
        $input.val('').prop('disabled', true);
        $send.prop('disabled', true);

        var $typing = addTypingIndicator();
        var hintTimer = setTimeout(function () {
            $typing.append('<span class="awa-copilot-msg__hint"><?= $escaper->escapeJs(__('consultando o ERP…')) ?></span>');
        }, 2500);

        $.ajax({
            url:         config.endpoint,
            type:        'POST',
            contentType: 'application/json',
            data:        JSON.stringify({ message: text, history: history, form_key: config.formKey }),
            dataType:    'json',
            headers:     { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (resp) {
                clearTimeout(hintTimer);
                $typing.remove();
                $input.prop('disabled', false);
                $send.prop('disabled', false);

                if (resp && resp.reply) {
                    addMessage('assistant', resp.reply);
                    history = resp.history || history;
                } else if (resp && resp.error) {
                    $error.text(resp.error).show();
                }
            },
            error: function () {
                clearTimeout(hintTimer);
                $typing.remove();
                $input.prop('disabled', false);
                $send.prop('disabled', false);
                $error.text('<?= $escaper->escapeJs(__('Erro ao comunicar com o copiloto. Tente novamente.')) ?>').show();
            }
        });
    }

    // Form submit
    $('#awa-copilot-form').on('submit', function (e) {
        e.preventDefault();
        sendMessage($input.val());
    });

    // Keyboard: Enter sends, Shift+Enter inserts newline
    $input.on('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage($input.val());
        }
    });

    // Prompt suggestions
    // Sugestão completa envia na hora; a que termina em espaço ("Como está
    // o cliente ") só preenche o campo para completar.
    $('#awa-copilot-prompts').on('click', '.awa-copilot-prompt-btn', function () {
        var prompt = String($(this).data('prompt') || '');
        if (/\s$/.test(prompt)) {
            $input.val(prompt).focus();
            return;
        }
        if (!$send.prop('disabled')) {
            sendMessage(prompt);
        }
    });
});
</script>
