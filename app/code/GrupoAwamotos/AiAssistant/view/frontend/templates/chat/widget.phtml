<script>
(function (w, d) {
    'use strict';
    if (w.__awaAiAssistantDeferInstalled) {
        return;
    }
    w.__awaAiAssistantDeferInstalled = true;
    var cfg = <?= /* @noEscape */ $widgetConfig ?>;
    var loaded = false;
    function apply(fromClick) {
        if (loaded) {
            return;
        }
        loaded = true;
        function run() {
            if (typeof w.require !== 'function' || w.require._awaStub) {
                loaded = false;
                return;
            }
            w.require(['Magento_Ui/js/core/app'], function (app) {
                try {
                    app({
                        components: {
                            AwaAiChat: {
                                component: 'GrupoAwamotos_AiAssistant/js/ai-assistant',
                                config: cfg
                            }
                        }
                    });
                } catch (e) { /* ignore */ }
            }, function () { loaded = false; });
        }
        if (typeof w.awaRunWhenRequire === 'function') {
            w.awaRunWhenRequire(run, { key: 'awa-ai-assistant-defer' });
        } else {
            run();
        }
    }
    function onFab(evt) {
        var t = evt.target && evt.target.closest && evt.target.closest('#assistente, #awa-ai-chat-root .awa-ai-chat__toggle, #awa-ai-chat-root .awa-ai-chat__launcher');
        if (!t) {
            return;
        }
        apply(true);
    }
    d.addEventListener('click', onFab, true);
    function idleLoad() {
        apply(false);
    }
    d.addEventListener('awa-home-paint-deferred', function () {
        if (w.requestIdleCallback) {
            w.requestIdleCallback(idleLoad, { timeout: 1000 });
        } else {
            w.setTimeout(idleLoad, 1000);
        }
    }, { once: true });
})(window, document);
</script>
