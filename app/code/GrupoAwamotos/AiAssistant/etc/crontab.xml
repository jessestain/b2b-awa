<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="grupoawamotos_aiassistant_purge_conversation_log"
             instance="GrupoAwamotos\AiAssistant\Cron\PurgeConversationLog"
             method="execute">
            <schedule>20 3 * * *</schedule>
        </job>
        <job name="grupoawamotos_aiassistant_quality_check"
             instance="GrupoAwamotos\AiAssistant\Cron\QualityCheck"
             method="execute">
            <schedule>15 * * * *</schedule>
        </job>
    </group>
</config>
