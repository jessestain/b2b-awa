<script>
(function () {
    'use strict';
    var input   = document.getElementById('awa-hc-search');
    var results = document.getElementById('awa-hc-results');
    var root    = document.getElementById('awa-helpcenter');

    function wrapHelpQuery(question) {
        var q = String(question || '').trim();
        if (!q) {
            return '';
        }
        if (/central de ajuda/i.test(q)) {
            return q;
        }
        return 'Central de Ajuda — ' + q;
    }

    function askAssistant(query) {
        var q = wrapHelpQuery(query);
        if (results) {
            results.hidden = true;
        }
        if (!q) {
            document.dispatchEvent(new CustomEvent('awa:helpcenter:open', { bubbles: true }));
            return;
        }
        window.__awaAiAskPending = q;
        document.dispatchEvent(new CustomEvent('awa:helpcenter:ask', {
            bubbles: true,
            detail: { query: q }
        }));
        if (!document.getElementById('awa-ai-chat-root') && input) {
            input.value = q;
            input.focus();
        }
    }

    function onAskClick(event) {
        if (!root) {
            return;
        }
        var btn = event.target && event.target.closest
            ? event.target.closest('[data-awa-ai-ask]')
            : null;
        if (!btn || !root.contains(btn) || btn.disabled) {
            return;
        }
        event.preventDefault();
        if (window.__awaHcAskHandling) {
            return;
        }
        window.__awaHcAskHandling = true;
        try {
            var q = btn.getAttribute('data-awa-ai-ask') || '';
            if (btn.classList.contains('awa-helpcenter__hero-ask') && input) {
                q = input.value.trim();
            }
            askAssistant(q);
        } finally {
            window.__awaHcAskHandling = false;
        }
    }

    if (!window.__awaHcAskClickBound) {
        window.__awaHcAskClickBound = true;
        window.addEventListener('click', onAskClick, true);
    }

    if (input && results) {
        var timer;
        input.addEventListener('input', function () {
            clearTimeout(timer);
            var q = input.value.trim();
            if (q.length < 2) { results.hidden = true; return; }
            timer = setTimeout(function () { doSearch(q); }, 280);
        });
        input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                askAssistant(input.value);
            }
            if (event.key === 'Escape') {
                results.hidden = true;
            }
        });
    }

    function doSearch(q) {
        fetch(input.dataset.searchUrl + '?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (data) { renderResults(data.topics || []); })
            .catch(function () { results.hidden = true; });
    }

    function renderResults(topics) {
        results.innerHTML = '';
        if (!topics.length) {
            results.innerHTML = '<div class="awa-hc-res__none"><?= $block->escapeJs(__('Nenhum resultado encontrado.')) ?></div>';
        } else {
            topics.forEach(function (t) {
                var el = document.createElement('a');
                el.href = t.url;
                el.className = 'awa-hc-res__item';
                el.setAttribute('role', 'option');
                el.innerHTML = '<strong class="awa-hc-res__title">' + escHtml(t.title) + '</strong>'
                    + (t.summary ? '<span class="awa-hc-res__sum">' + escHtml(t.summary) + '</span>' : '');
                results.appendChild(el);
            });
        }
        results.hidden = false;
    }

    function escHtml(s) {
        return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    if (results && input) {
        document.addEventListener('click', function (e) {
            if (!results.contains(e.target) && e.target !== input) { results.hidden = true; }
        });
    }

    function openHashTarget() {
        if (!location.hash) { return; }
        var el = document.querySelector(location.hash);
        if (!el) { return; }
        if (el.tagName === 'DETAILS') {
            el.open = true;
        }
        window.setTimeout(function () {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 160);
    }

    openHashTarget();
    window.addEventListener('hashchange', openHashTarget);
}());
</script>
