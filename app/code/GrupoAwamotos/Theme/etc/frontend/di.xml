<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
      Plugins de Response do storefront — NÃO registrar em etc/di.xml global.
      Rodar no adminhtml injeta CSS/JS de minicart/header e causa 404 AMD
      (js/awa-minicart-position no tema Magento/backend).
    -->
    <type name="GrupoAwamotos\Theme\Plugin\Response\PatchHomeHeaderHtmlPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
        </arguments>
    </type>

    <type name="GrupoAwamotos\Theme\Plugin\Response\OptimizeHeadStylesPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
            <argument name="manifest" xsi:type="object">GrupoAwamotos\Theme\Model\CascadeAssetManifest</argument>
            <argument name="normalizer" xsi:type="object">GrupoAwamotos\Theme\Model\HeadStylesheetNormalizer</argument>
        </arguments>
    </type>

    <type name="GrupoAwamotos\Theme\Plugin\Response\DeferHomeScriptsPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Page\Config\Renderer">
        <plugin name="grupoawamotos_theme_head_asset_rubik_async"
                type="GrupoAwamotos\Theme\Plugin\Framework\View\Page\Config\HeadAssetRendererPlugin"
                sortOrder="5"/>
    </type>

    <type name="Magento\Framework\HTTP\PhpEnvironment\Response">
        <!--
          sortOrder 9999 = roda DEPOIS do OptimizeHeadStylesPlugin (998), no MESMO tipo.
          Precisa ser o mesmo tipo: `Magento\Framework\App\Response\Http` ESTENDE
          `PhpEnvironment\Response`, e sortOrder NAO ordena plugins entre pai e filho.
          Registrando em `Http`, o crosspage-shell-lock-r68 (que vem do plugin de 998)
          continuava aparecendo DEPOIS do meu bloco.
        -->
        <plugin name="grupoawamotos_theme_clamp_send_response"
                type="GrupoAwamotos\Theme\Plugin\Response\CorrigirClampNomePlugin"
                sortOrder="9999"/>
        <plugin name="grupoawamotos_theme_patch_home_header_on_set_body"
                type="GrupoAwamotos\Theme\Plugin\Response\PatchHomeHeaderHtmlPlugin"
                sortOrder="50"/>
        <plugin name="grupoawamotos_theme_optimize_head_styles"
                type="GrupoAwamotos\Theme\Plugin\Response\OptimizeHeadStylesPlugin"
                sortOrder="998"/>
        <!-- Minifica os <script> INLINE (162 KB -> 116 KB medidos): roda DEPOIS de tudo.
             Reverter = remover este bloco + cache:flush. Nada e persistido. -->
        <plugin name="grupoawamotos_theme_minify_inline_scripts"
                type="GrupoAwamotos\Theme\Plugin\Response\MinifyInlineScriptsPlugin"
                sortOrder="10000"/>
    </type>

    <type name="Magento\Framework\App\Response\Http">
        <plugin name="grupoawamotos_theme_defer_home_scripts"
                type="GrupoAwamotos\Theme\Plugin\Response\DeferHomeScriptsPlugin"
                sortOrder="15"/>
    </type>

    <type name="Magento\Framework\App\FrontControllerInterface">
        <plugin name="grupoawamotos_theme_legacy_route_redirect"
                type="GrupoAwamotos\Theme\Plugin\App\FrontController\LegacyRouteRedirectPlugin"
                sortOrder="1"/>
    </type>

    <type name="Mirasvit\SearchAutocomplete\Model\Result">
        <plugin name="grupoawamotos_theme_searchautocomplete_result_text_all"
                type="GrupoAwamotos\Theme\Plugin\Mirasvit\SearchAutocompleteResultPlugin"
                sortOrder="10"/>
    </type>
<!--
  Normaliza a especificidade do CSS inline: colapsa `#html-body` repetido.
  Medido em 06/10/2026: 1.218 de 1.596 regras (76%) repetiam o id, ate 6 vezes,
  custando 98,8 KB de HTML por pagina SEM efeito na cascata
  (tools/checar-especificidade.py prova: 0 disputas por contagem de id).
  sortOrder 999 roda depois do OptimizeHeadStylesPlugin (998).
-->
<type name="Magento\Framework\HTTP\PhpEnvironment\Response">
    <plugin name="grupoawamotos_theme_css_specificity_normalizer"
            type="GrupoAwamotos\Theme\Plugin\Response\CssSpecificityNormalizerPlugin"
            sortOrder="999"/>
</type>
</config>
