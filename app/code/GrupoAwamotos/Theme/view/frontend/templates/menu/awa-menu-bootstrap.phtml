<?php
declare(strict_types=1);

/**
 * AWA Menu v2 bootstrap — flag, preflight mobile hamburger, lazy boot do controller.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
$layoutHandles = $block->getLayout() ? $block->getLayout()->getUpdate()->getHandles() : [];
$isCheckoutFocus = in_array('checkout_index_index', $layoutHandles, true)
    || in_array('onepagecheckout_index_index', $layoutHandles, true);
if ($isCheckoutFocus) {
    return;
}
$isHomePage = in_array('cms_index_index', $layoutHandles, true);
$isCatalogPlp = in_array('catalog_category_view', $layoutHandles, true)
    || in_array('catalogsearch_result_index', $layoutHandles, true);
$menuRuntimeVersion = \GrupoAwamotos\Theme\Model\MinicartAssetVersion::query();
$controllerUrl = $block->getViewFileUrl('js/awa-menu-controller.anchor-r23.js') . $menuRuntimeVersion;
$floatingCoreUrl = '';
$floatingDomUrl = '';

if (is_file(BP . '/app/design/frontend/AWA_Custom/ayo_home5_child/web/js/vendor/floating-ui.core.umd.min.js')) {
    $floatingCoreUrl = $block->getViewFileUrl('js/vendor/floating-ui.core.umd.min.js');
} elseif (is_file(BP . '/app/code/GrupoAwamotos/Theme/view/frontend/web/js/vendor/floating-ui.core.umd.min.js')) {
    $floatingCoreUrl = $block->getViewFileUrl('GrupoAwamotos_Theme::js/vendor/floating-ui.core.umd.min.js');
}

if (is_file(BP . '/app/design/frontend/AWA_Custom/ayo_home5_child/web/js/vendor/floating-ui.dom.umd.min.js')) {
    $floatingDomUrl = $block->getViewFileUrl('js/vendor/floating-ui.dom.umd.min.js');
} elseif (is_file(BP . '/app/code/GrupoAwamotos/Theme/view/frontend/web/js/vendor/floating-ui.dom.umd.min.js')) {
    $floatingDomUrl = $block->getViewFileUrl('GrupoAwamotos_Theme::js/vendor/floating-ui.dom.umd.min.js');
}
$menuConfig = [
    'desktopBreakpoint' => 992,
    'hoverDelay' => 100,
    'limitShow' => 0,
];
$menuCssUrl = $block->getViewFileUrl('css/awa-menu-v2-dept-open-fix.anchor-r18.css');
$runtimeUrl = $block->getViewFileUrl('GrupoAwamotos_Theme::js/awa-menu-bootstrap-runtime.dept-strip-r17.js');
$controllerPinUrl = preg_replace('/\.js(?:\?.*)?$/i', '', $controllerUrl);
$runtimeConfig = [
    'controllerUrl' => $controllerUrl,
    'floatingCoreUrl' => $floatingCoreUrl,
    'floatingDomUrl' => $floatingDomUrl,
    'menuConfig' => $menuConfig,
    'isHome' => $isHomePage,
];
?>
<script>
window.__AWA_MENU_V2 = true; /* awa-dept-typography-strip-r16 */
(function (d, w) {
    'use strict';
    function stripDeptTriggerTypography() {
        d.querySelectorAll('[data-role="awa-vertical-menu-trigger"], .awa-vmenu-trigger-text').forEach(function (el) {
            ['font-size', 'font-weight', 'line-height'].forEach(function (prop) {
                el.style.removeProperty(prop);
            });
            if (!el.getAttribute('style')) {
                el.removeAttribute('style');
            }
        });
    }
    function bootStripGuard() {
        stripDeptTriggerTypography();
        if (w.__awaDeptTypographyStripGuard) {
            return;
        }
        if (w.__awaDeptTypographyStripObserver && typeof w.__awaDeptTypographyStripObserver.disconnect === 'function') {
            w.__awaDeptTypographyStripObserver.disconnect();
            w.__awaDeptTypographyStripObserver = null;
        }
        w.__awaDeptTypographyStripGuard = true;
    }
    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', bootStripGuard, { once: true });
    } else {
        bootStripGuard();
    }
    w.__awaStripDeptTriggerTypography = stripDeptTriggerTypography;

    /* CDN pode ignorar ?v= no path do runtime — fixa require path antes do defer boot. */
    var menuControllerPin = <?= /* @noEscape */ json_encode(
        $controllerPinUrl,
        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
    ) ?>;
    function pinMenuControllerPath() {
        if (typeof w.require !== 'function' || typeof w.require.config !== 'function') {
            return false;
        }
        if (typeof w.require.undef === 'function') {
            w.require.undef('awa-menu-controller');
        }
        w.require.config({
            paths: {
                'awa-menu-controller': menuControllerPin
            }
        });
        return true;
    }
    if (!pinMenuControllerPath()) {
        var pinAttempts = 0;
        var maxPinAttempts = 16;
        function retryPin(delayMs) {
            pinAttempts += 1;
            if (pinMenuControllerPath() || pinAttempts >= maxPinAttempts) {
                return;
            }
            w.setTimeout(function () {
                retryPin(Math.min(delayMs + 30, 260));
            }, delayMs);
        }
        retryPin(60);
    }
})(document, window);
</script>
<script type="application/json" id="awa-menu-bootstrap-config"><?= /* @noEscape */ json_encode(
    $runtimeConfig,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
) ?></script>
<?php if ($isCatalogPlp): ?>
<script type="text/plain" id="awa-menu-bootstrap-runtime" data-awa-catalog-menu-pending="1" data-src="<?= $block->escapeUrl($runtimeUrl) ?>"></script>
<?php else: ?>
<script defer src="<?= $block->escapeUrl($runtimeUrl) ?>" id="awa-menu-bootstrap-runtime"></script>
<?php endif; ?>
<?php if (!$isHomePage && $floatingCoreUrl !== '' && $floatingDomUrl !== ''): ?>
<script defer src="<?= $block->escapeUrl($floatingCoreUrl) ?>"></script>
<script defer src="<?= $block->escapeUrl($floatingDomUrl) ?>"></script>
<?php endif; ?>
<link rel="preload" href="<?= $block->escapeUrl($menuCssUrl) ?>" as="style"/>
<link rel="stylesheet" href="<?= $block->escapeUrl($menuCssUrl) ?>" id="awa-menu-v2-dept-open-fix"/>
<style id="awa-menu-v2-desktop-fallback-static">
@media (min-width: 992px) {
    .navigation.verticalmenu.side-verticalmenu:not([data-awa-menu-controller-ready="1"]):hover > [data-role="awa-vertical-menu-panel"],
    [data-role="awa-vertical-menu"]:not([data-awa-menu-controller-ready="1"]):hover > [data-role="awa-vertical-menu-panel"],
    [data-role="awa-vertical-menu"]:not([data-awa-menu-controller-ready="1"]) > [data-role="awa-vertical-menu-trigger"]:hover ~ [data-role="awa-vertical-menu-panel"],
    [data-role="awa-vertical-menu"]:not([data-awa-menu-controller-ready="1"]) > [data-role="awa-vertical-menu-trigger"]:active ~ [data-role="awa-vertical-menu-panel"],
    [data-role="awa-vertical-menu"]:not([data-awa-menu-controller-ready="1"]) > [data-role="awa-vertical-menu-trigger"]:focus ~ [data-role="awa-vertical-menu-panel"],
    [data-role="awa-vertical-menu"]:not([data-awa-menu-controller-ready="1"]) > [data-role="awa-vertical-menu-trigger"]:focus-visible ~ [data-role="awa-vertical-menu-panel"],
    [data-role="awa-vertical-menu"]:not([data-awa-menu-controller-ready="1"]) > [data-role="awa-vertical-menu-panel"]:hover,
    [data-role="awa-vertical-menu"]:not([data-awa-menu-controller-ready="1"]) > [data-role="awa-vertical-menu-panel"]:focus-within {
        display: flex !important;
        flex-direction: column !important;
        visibility: visible !important;
        opacity: 1 !important;
        pointer-events: auto !important;
        height: auto !important;
        min-height: 120px !important;
        max-height: min(70vh, 560px) !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
    }
}
</style>
<style id="awa-menu-v2-mobile-critical">
<?= $block->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class)
    ->setTemplate('GrupoAwamotos_Theme::menu/awa-menu-v2-mobile-critical-fragment.phtml')
