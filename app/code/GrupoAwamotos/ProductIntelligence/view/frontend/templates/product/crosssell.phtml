<?php
declare(strict_types=1);

/** @var \GrupoAwamotos\ProductIntelligence\Block\Product\CrossSell $block */
$items = $block->getCrossSellProducts();
if (empty($items)) {
    return;
}
// form_key: value vazio, hidratado via JS por-sessao (P0.2). Nao usa getBlockHtml, por isso o plugin central nao cobre este template.
$itemCount = count($items);
$canShowPrice = $block->canShowPrice();
$loginUrl = $block->escapeUrl($block->getUrl('b2b/account/login'));
?>

<div class="rx-pdp-crosssell awa-shelf awa-pdp-shelf" data-item-count="<?= (int) $itemCount ?>">
    <header class="awa-shelf__header rx-pdp-header">
        <h2 class="awa-shelf__title rx-pdp-title">
            <?= $block->escapeHtml(__('Clientes que compraram este produto também compraram')) ?>
        </h2>
    </header>

    <div class="rx-pdp-grid" data-item-count="<?= (int) $itemCount ?>">
        <?php foreach ($items as $item):
            $product = $item['product'];
            $imageUrl = $block->getProductImageUrl($product);
            $badge = $item['badge'];
            $price = $product->getFinalPrice();
            $showPrice = $canShowPrice && $price > 0;
        ?>
        <div class="rx-pdp-card">
            <?php if ($badge): ?>
            <span class="rx-pdp-badge <?= $block->escapeHtmlAttr($badge['class']) ?>"
                  style="--rx-pdp-badge-bg:<?= $block->escapeHtmlAttr($badge['color']) ?>">
                <?= $block->escapeHtml($badge['label']) ?>
            </span>
            <?php endif; ?>

            <a href="<?= $block->escapeUrl($product->getProductUrl()) ?>" class="rx-pdp-img-link">
                <?php if ($imageUrl): ?>
                    <img src="<?= $block->escapeUrl($imageUrl) ?>"
                         alt="<?= $block->escapeHtmlAttr($product->getName()) ?>"
                        loading="lazy" decoding="async" width="180" height="180" />
                <?php endif; ?>
            </a>

            <div class="rx-pdp-info">
                <a href="<?= $block->escapeUrl($product->getProductUrl()) ?>" class="rx-pdp-name">
                    <?= $block->escapeHtml($product->getName()) ?>
                </a>
                <?php if ($showPrice): ?>
                <div class="rx-pdp-price">
                    <?= /* @noEscape */ $block->formatProductPrice($product) ?>
                </div>
                <?php elseif (!$canShowPrice): ?>
                <div class="rx-pdp-price rx-pdp-price--hidden b2b-login-to-see-price">
                    <a class="rx-pdp-login-link" href="<?= /* @noEscape */ $loginUrl ?>">
                        <?= $block->escapeHtml(__('Entrar')) ?>
                    </a>
                    <span class="rx-pdp-login-suffix"><?= $block->escapeHtml(__('para ver preços')) ?></span>
                </div>
                <?php endif; ?>
            </div>

            <?php if ($canShowPrice && $product->isSaleable()): ?>
            <form action="<?= $block->escapeUrl($block->getUrl('checkout/cart/add')) ?>" method="post" class="rx-pdp-form">
                <input type="hidden" name="product" value="<?= (int)$product->getId() ?>">
                <input type="hidden" name="form_key" value="">
                <input type="hidden" name="qty" value="1">
                <button type="submit" class="rx-pdp-addtocart" title="<?= $block->escapeHtmlAttr(__('Adicionar ao Carrinho')) ?>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <?= $block->escapeHtml(__('Comprar')) ?>
                </button>
            </form>
            <?php endif; ?>
        </div>
        <?php endforeach; ?>
    </div>
</div>
